import {strict as assert} from 'node:assert';
import path from 'node:path';
import {pathToFileURL} from 'node:url';
const root=process.env.PROMOTION_VERIFY_PACKAGE_ROOT ?? path.resolve('packages/cd');
const load=async (relative:string)=>import(pathToFileURL(path.join(root,relative)).href);
const {harness}=await load('test/promotion/harness.ts');
const {pipelineNode,resolvedFor}=await load('test/promotion/doubles.ts');
const {camp,fid}=await load('test/promotion/store.ts');
const {VerificationVerdict,PromotionState}=await load('src/_generated/cd_pb.ts');
const h=harness();
h.pipelines.define('shop',[pipelineNode('staging',{campIds:['staging-1']})]);
h.freight.add('f0');
h.freight.add('f1');
h.desired.seed('staging-1','f0',resolvedFor('staging-1','alpha','f0'));
h.pipelines.makeAvailable('shop','staging','f1');
h.verification.verdict=VerificationVerdict.INCONCLUSIVE;
const qualify=h.freight.qualify.bind(h.freight);
let qualificationCalls=0;
h.freight.qualify=async (...args:any[])=>{qualificationCalls++;return qualify(...args);};
const result=await h.service.promote({freightId:fid('f1'),targets:[camp('staging-1')],idempotencyKey:'formal-verification',pipeline:'shop',node:'staging'},h.ctx());
assert.equal(qualificationCalls,0,'the promotion saga must not ask freight to qualify a non-passing verification');
assert.ok(result.ok && result.value.state===PromotionState.FAILED,'an inconclusive verification must fail the promotion');
assert.equal((await h.desired.current(camp('staging-1')))?.freightId,'f0','failure restores the predecessor');
console.log('PASS: promotion stops before qualification for an inconclusive verification');
