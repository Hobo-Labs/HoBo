export const title = 'Promote a release after verification';
export const state = v => ({requested:'Promotion requested',resolved:'Release resolved',approval:'Waiting for approval',applying:'Applying release',rollout:'Rolling out',verifying:'Verifying release',verified:'Verification passed',qualified:'Release qualified',promoted:'Promotion complete',rejected:'Promotion rejected',compensating:'Restoring predecessor',compensated:'Predecessor restored'})[v.phase];
export const step = action => ({Resolve:'resolve release',GateAllow:'gate allows',GateNeedsApproval:'gate requests approval',Reject:'gate or approver rejects',Approve:'approve',Apply:'apply changes',Converge:'rollout converges',VerifyPass:'verification passes',VerifyFail:'verification fails or is inconclusive',Qualify:'qualify release',Promote:'complete promotion',Compensate:'restore predecessor'})[action] ?? action;
