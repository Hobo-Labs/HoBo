import { spawnSync } from 'node:child_process';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
const root = process.env.SHARED_BUDGET_VERIFY_PACKAGE_ROOT ?? path.resolve('packages/core');
const config = fileURLToPath(new URL('../models/vitest.config.mts', import.meta.url));
const vitest = path.resolve('node_modules/vitest/vitest.mjs');
const env = { ...process.env };
if (!env.HOBO_CUE_BIN && spawnSync('cue', ['version'], { stdio: 'ignore' }).status === 0) env.HOBO_CUE_BIN = 'cue';
const result = spawnSync(process.execPath, [vitest, 'run', 'test/budget-policy-schema.test.ts', '--root', root, '--config', config, '--maxWorkers=1', '--no-file-parallelism'], { env, stdio: 'inherit' });
if (result.error) throw result.error;
if (result.status !== 0) process.exit(result.status ?? 1);
