import {spawnSync} from 'node:child_process';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
const root=process.env.BUDGET_ROUTER_VERIFY_PACKAGE_ROOT ?? path.resolve('packages/dispatcher');
const config=fileURLToPath(new URL('../models/vitest.config.mts',import.meta.url));
const vitest=path.resolve('node_modules/vitest/vitest.mjs');
const args=[vitest,'run','test/budget-routing.property.test.ts','test/ledger-sequence-safety.test.ts','test/ledger-consumption-safety.test.ts','test/budget-category-scope.test.ts','test/budget-estimate-routing.test.ts','test/dispatcher-locale.test.ts','test/dispatcher-v1-byte-identical.test.ts','--root',root,'--config',config,'--maxWorkers=1','--no-file-parallelism'];
