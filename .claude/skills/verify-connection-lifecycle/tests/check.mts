import {strict as assert} from 'node:assert';
import path from 'node:path';
import {pathToFileURL} from 'node:url';
const root=process.env.IDENTITY_VERIFY_SOURCE_ROOT ?? path.resolve('packages/identity/src');
const {ConnectionService}=await import(pathToFileURL(path.join(root,'connection.ts')).href);
const {createInMemoryVault}=await import(pathToFileURL(path.join(root,'token-broker.ts')).href);
const user={kind:'user' as const,id:'user:alice'};
const vault=createInMemoryVault({reference:'vaultref://fixture',rootSecret:'not-a-secret'});
const svc=new ConnectionService({tenant:'tenant-a',vault});
svc.create({provider:'asana',alias:'work',subject:user,createdBy:user,scopes:['tasks:read'],stationId:'station:test'});
const resolve=()=>svc.resolveForToken({idOrAlias:'work',provider:'asana',subject:user,scopes:['tasks:read']});
assert.equal(resolve().status,'denied','pending connections cannot resolve for token use');
svc.authorize({idOrAlias:'work',actor:user});
assert.equal(resolve().status,'ok','an authorized connection is available');
const authorization=svc.events.find((event: {type:string})=>event.type==='connection.Authorized');
const creation=svc.events.find((event: {type:string})=>event.type==='connection.Created');
assert.ok(authorization);
assert.ok(creation);
svc.revoke({idOrAlias:'work',actor:user,reason:'compromised'});
assert.equal(resolve().status,'denied','a revoked connection must immediately deny token resolution');
assert.throws(()=>svc.authorize({idOrAlias:'work',actor:user}), /revoked/);
assert.throws(()=>svc.markNeedsReauth({idOrAlias:'work',reason:'late health check'}), /revoked/);
assert.notEqual(resolve().status,'ok','a revoked connection should require a newly created connection');
const lastSeq=svc.events.at(-1)?.seq ?? 0;
const replayed=ConnectionService.fromEvents([...svc.events,{...authorization,seq:lastSeq+1},{...creation,seq:lastSeq+2}],{tenant:'tenant-a',vault});
assert.equal(replayed.get('work')?.status,'revoked','a late authorization must not revive a revoked connection during replay');
console.log('PASS: revoked connections remain unusable');
