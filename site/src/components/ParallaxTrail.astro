---
// ==========================================================================
// The open road: the trail Bo walks, docked to the bottom of the page.
//
// This band is the landing page's imagery. It stays put while the page
// scrolls over it, and the scrolling is what moves it: reading down the page
// walks Bo down the trail, and each section's landmarks pull alongside him
// as that section arrives (see ../lib/stage/trail.ts, which does the moving).
//
// Nearly all of it is supplied artwork. Clouds, the horizon, the telephone
// poles, the ground and everything standing beside the path are files in
// public/parallax/, used as given at their own aspect ratios (see
// ../lib/trail-plates.ts and ../lib/trail-landmarks.ts). The only thing drawn
// here is the wire strung between the poles, which has to be generated
// because it spans the gap and closes across the tile seam (see
// ../lib/trail-art.ts). This file is the stage; it draws nothing itself.
//
// Two ways it runs, and the first is the fallback for the second:
//
//   on a timer   With no script, CSS walks Bo along a looping trail exactly
//                as it always did. Every layer translates by one of its own
//                tile widths, over and over, so the wrap lands on identical
//                pixels.
//   on the page  Once the controller mounts it adds `is-driven`, the timers
//                stop, and each layer's offset comes from how far the page
//                has scrolled instead. Same tiles, same speeds — the slot
//                speeds now multiply distance rather than time.
//
// Bo is the uploaded 36-frame walk sprite (6x6 grid, repacked to 160x157 per
// frame). He holds one spot while the world slides past, and his stride is
// taken from the ground that went by so his feet plant instead of skating.
// Scrolling back up runs the reel backwards: the same frames in reverse. He
// is never mirrored — Bo is not symmetric, and a flip hands the bindle to the
// wrong arm (see public/parallax/README.md).
// ==========================================================================

import { href } from "../lib/url";
import { BO_FEET, TH, TRAIL_LAYERS, TRAIL_SECONDS } from "../lib/trail-art";
import { plates } from "../lib/trail-plates";
import { CLOUD_SPEED, CLOUD_TILE, CLOUD_TONE, clouds } from "../lib/trail-clouds";
import { landmarks } from "../lib/trail-landmarks";
import { TRAIL_STOPS } from "../lib/trail-stops";

const round = (v: number) => Math.round(v * 100) / 100;

// TRAIL_SECONDS times one 1200-unit tile. A layer with a wider tile has more
// ground to cover in the same apparent motion, so its duration scales with its
// own width — otherwise a plate that is not 4:1 travels at the wrong speed and
// the parallax it claims is not the parallax you see.
const seconds = (tileUnits: number, speed: number) =>
	round((TRAIL_SECONDS * (tileUnits / 1200)) / speed);

type Item = {
	key: string;
	order: number;
	front: boolean;
	kind: "plate" | "drawn" | "clouds" | "mark";
	night: string;
	style: string;
	/** Parallax speed and tile width in tile units, for the controller. */
	speed: number;
	tile: number;
	href?: string;
	stop?: string;
	at?: number;
	idle?: string;
};

const supplied: Item[] = plates().map((p) => ({
	key: p.key,
	order: p.order,
	front: p.front,
	kind: "plate",
	night: p.night,
	speed: p.speed,
	tile: round(p.aspect * TH),
	href: href(`/parallax/plates/${p.file}`),
	style: [
		`--plate:url("${href(`/parallax/plates/${p.file}`)}")`,
		`--plate-tile:calc(var(--band-h) * ${round(p.aspect)})`,
		`--plx-dur:${seconds(p.aspect * TH, p.speed)}s`,
		`--tone:${p.tone}`,
		`opacity:${p.opacity}`,
	].join(";"),
}));

const drawn: Item[] = TRAIL_LAYERS.map((layer) => ({
	key: layer.key,
	order: layer.order,
	front: false,
	kind: "drawn",
	// Already themed at the source — the route serves a light tile and a dark
	// one and the swap happens above. Filtering as well would invert twice.
	night: "keep",
	speed: layer.speed,
	tile: 1200,
	style: [
		`--art-light:url("${href(`/parallax/${layer.key}-light.svg`)}")`,
		`--art-dark:url("${href(`/parallax/${layer.key}-dark.svg`)}")`,
		`--plx-dur:${seconds(1200, layer.speed)}s`,
		`--tone:${layer.tone}`,
	].join(";"),
}));

// The clouds are sprites, not a plate, so each can squash on its own. The
// track is a row of identical segments scrolling by exactly one of them —
// same loop guarantee as a tiled plate, just built out of elements.
const sky = clouds();
// One tile is 4x the band height. The page-driven band shifts the layer by up
// to a tile and the clouds' own drift shifts the track by up to another, so
// the row has to cover the viewport plus two.
const SKY_SEGMENTS = 8;
const cloudLayer: Item | null = sky.length
	? {
			key: "clouds",
			order: 20,
			front: false,
			kind: "clouds",
			night: "keep",
			speed: CLOUD_SPEED,
			tile: CLOUD_TILE,
			style: `--plx-dur:${seconds(CLOUD_TILE, CLOUD_SPEED)}s;--tone:${CLOUD_TONE}`,
		}
	: null;

// Landmarks: somewhere, not everywhere. Each belongs to a stop and is placed
// by the controller; with no script they stay hidden rather than tiling.
const placed: Item[] = landmarks().map((m) => ({
	key: m.key,
	order: m.order,
	front: false,
	kind: "mark",
	night: m.night,
	speed: m.speed,
	tile: 0,
	stop: m.stop,
	at: m.at,
	idle: m.idle,
	href: href(`/parallax/landmarks/${m.file}`),
	style: [
		`--mark:url("${href(`/parallax/landmarks/${m.file}`)}")`,
		`--mw:${m.w}`,
		`--mh:${m.h}`,
		`--mbase:${m.base}`,
		`--tone:${m.tone}`,
	].join(";"),
}));

// One depth order over every source, so a drawn layer can sit between two
// plates — the wires hang in front of the poles and behind the ground — and a
// landmark can stand between the path and Bo.
const ordered = [...supplied, ...drawn, ...(cloudLayer ? [cloudLayer] : []), ...placed].sort(
	(a, b) => a.order - b.order,
);
const behind = ordered.filter((l) => !l.front);
const inFront = ordered.filter((l) => l.front);

// Sprite geometry: 6x6 grid of 554x542 source frames, feet at 524/542 down.
const BO_FRAME_H = 128; // frame height, in tile units
const BO_FRAME_W = (BO_FRAME_H * 554) / 542;
const BO_BOTTOM = TH - BO_FEET - (1 - 524 / 542) * BO_FRAME_H;
// 50ms a frame, the cadence the sprite was exported at: 9 frames to a step,
// 18 to a stride, so the whole 36-frame sheet is two strides in 1.8s. That is
// also what TRAIL_SECONDS is derived from — change one and change the other.
const BO_FRAME = 0.05;

// The idle strip (bo-idle.png: 12 frames of 207x230, rest / hop / blink) is a
// different export of the same character, so it is registered to the walk
// sheet rather than assumed to match. Measured off both: the standing figure
// is 149px of a 157px walk frame and 213px of a 230px idle frame, and the two
// drawings' ink centres sit 0.2 units apart at that scale.
const IDLE_H = round((BO_FRAME_H * (149 / 157) * 230) / 213);
const IDLE_W = round((IDLE_H * 207) / 230);
const IDLE_TOP = round(BO_FRAME_H * (153.5 / 157) - IDLE_H * (227.5 / 230));
const IDLE_LEFT = round(BO_FRAME_W * 0.528 - IDLE_W * 0.587);

const rootStyle = [
	`--bo-frame-h:${BO_FRAME_H}`,
	`--bo-frame-w:${round(BO_FRAME_W)}`,
	`--bo-bottom:${round(BO_BOTTOM)}`,
	`--bo-frame:${BO_FRAME}s`,
	`--bo-sprite:url("${href("/parallax/bo-walk.png")}")`,
	`--bo-idle:url("${href("/parallax/bo-idle.png")}")`,
	`--idle-h:${IDLE_H}`,
	`--idle-w:${IDLE_W}`,
	`--idle-top:${IDLE_TOP}`,
	`--idle-left:${IDLE_LEFT}`,
].join(";");

const firstStop = TRAIL_STOPS[0].label;
---

{
	supplied.map((p) => (
		<link rel="preload" as="image" href={p.href} />
	))
}
{
	sky.map((c) => (
		<link rel="preload" as="image" href={href(`/parallax/clouds/${c.file}`)} />
	))
}
<link rel="preload" as="image" href={href("/parallax/bo-walk.png")} />
<div class="plx" data-plx style={rootStyle}>
	<div
		class="plx-scene"
		role="img"
		aria-label="Bo the bindlebug walking a country trail past telephone poles and drifting clouds; the trail moves as the page scrolls"
	>
		{
			behind.map((l) =>
				l.kind === "clouds" ? (
					<div
						class:list={["plx-layer", "plx-sky", `is-${l.night}`]}
						style={l.style}
						data-plx-speed={l.speed}
						data-plx-tile={l.tile}
					>
						<div class="plx-sky-track">
							{Array.from({ length: SKY_SEGMENTS }, () => (
								<div class="plx-sky-seg">
									{sky.map((c) => (
										<span
											class="plx-cloud"
											style={`--cx:${c.x};--cy:${c.y};--cw:${c.w};--ch:${c.h};--cloud:url("${href(`/parallax/clouds/${c.file}`)}")`}
										/>
									))}
								</div>
							))}
						</div>
					</div>
				) : l.kind === "mark" ? (
					<div
						class:list={["plx-mark", `plx-mark-${l.key}`, l.idle && `does-${l.idle}`]}
						style={l.style}
						data-plx-stop={l.stop}
						data-plx-at={l.at}
						data-plx-mark-speed={l.speed}
					>
						<span class:list={["plx-mark-art", `is-${l.night}`]} />
					</div>
				) : (
					<div
						class:list={[
							"plx-layer",
							l.kind === "plate" && "plx-plate",
							`plx-${l.key}`,
							`is-${l.night}`,
						]}
						style={l.style}
						data-plx-speed={l.speed}
						data-plx-tile={l.tile}
					/>
				),
			)
		}
		<div class="plx-actors"></div>
		<div class="plx-bo">
			<div class="plx-bo-walk"></div>
			<div class="plx-bo-idle"></div>
		</div>
		{
			inFront.map((l) => (
				<div
					class:list={[
						"plx-layer",
						l.kind === "plate" && "plx-plate",
						`plx-${l.key}`,
						`is-${l.night}`,
					]}
					style={l.style}
					data-plx-speed={l.speed}
					data-plx-tile={l.tile}
				/>
			))
		}
	</div>
	<p class="plx-where" aria-hidden="true">{firstStop}</p>
	<button class="plx-pause" type="button" aria-pressed="false">
		<span class="plx-pause-icon" aria-hidden="true"></span>
		<span class="plx-pause-label">Pause the trail and its travelers</span>
	</button>
</div>

<style>
	.plx {
		/* A whole number at every breakpoint on purpose: the tile is four band
		   heights, and a fractional tile brings back sub-pixel seams. */
		--band-h: 168px;
		--tile: calc(var(--band-h) * 4);
		--u: calc(var(--band-h) / 300); /* one tile unit, in CSS pixels */
		--bo-h: calc(var(--u) * var(--bo-frame-h));
		--bo-w: calc(var(--u) * var(--bo-frame-w));
		--bo-x: 24%;

		/* --band-h is the scene, not the scene plus its rule: the layers are
		   sized in tile units off it, so the border must not eat into it. */
		box-sizing: content-box;
		position: relative;
		height: var(--band-h);
		overflow: hidden;
		border-top: var(--rule) solid var(--ink);
		background: var(--bg);
		contain: layout paint style;
	}

	.plx-scene {
		position: absolute;
		inset: 0;
	}

	/* Every layer is the same 4:1 tile pinned to the band height, so the only
	   thing that can differ between them is how fast one tile goes by. */
	.plx-layer {
		position: absolute;
		top: 0;
		left: 0;
		height: 100%;
		width: calc(100% + var(--tile));
		background-image: var(--art-dark);
		background-repeat: repeat-x;
		background-size: var(--tile) 100%;
		background-position: 0 0;
		animation: plx-scroll var(--plx-dur) linear infinite;
		animation-play-state: var(--plx-play, running);
		will-change: transform;
		pointer-events: none;
	}

	:global(:root:not([data-theme="dark"])) .plx-layer {
		background-image: var(--art-light);
	}

	/* A plate is used as given: its own aspect, its own tile width, no theme
	   swap — it is artwork, not something this file re-inks. */
	.plx-plate {
		background-image: var(--plate);
		background-size: auto 100%;
		width: calc(100% + var(--plate-tile));
		animation-name: plx-scroll-plate;
	}

	:global(:root:not([data-theme="dark"])) .plx-plate {
		background-image: var(--plate);
	}

	@keyframes plx-scroll-plate {
		from {
			transform: translate3d(0, 0, 0);
		}
		to {
			transform: translate3d(calc(var(--plate-tile) * -1), 0, 0);
		}
	}

	/* Exactly one tile of travel, so the wrap lands on identical pixels. */
	@keyframes plx-scroll {
		from {
			transform: translate3d(0, 0, 0);
		}
		to {
			transform: translate3d(calc(var(--tile) * -1), 0, 0);
		}
	}

	/* ---------- driven by the page ---------- */

	/* The controller has the wheel: no layer runs on a timer any more, each
	   one is placed from the scroll position instead. */
	.plx.is-driven .plx-layer {
		animation: none;
	}

	/* ---------- night ---------- */

	/* Three treatments, one per layer, because the scene is not all one kind
	   of thing (see ../lib/trail-plates.ts). Each is graded by --tone, so the
	   far layers sit back in the dark instead of every layer arriving at the
	   same brilliant white and flattening the depth the parallax just built.
	   By day none of this applies: paper is behind everything and distance
	   already reads without help. */
	:global(:root[data-theme="dark"]) .plx .is-invert {
		filter: invert(1) brightness(var(--tone, 1));
	}

	/* Keeping means keeping the ink, not keeping the brightness — a cloud that
	   stays paper-white is a cut-out pasted on the night. */
	:global(:root[data-theme="dark"]) .plx .is-keep {
		opacity: var(--tone, 1);
	}

	/* A solid silhouette stays solid and gets an ink outline instead — the
	   same four-way rim Bo takes, so a black post reads against a black sky
	   without turning into a white one. */
	:global(:root[data-theme="dark"]) .plx .is-rim {
		/* Scaled off the tile unit rather than fixed: a pole shaft is only a
		   few pixels across at this band height, so a rim that does not shrink
		   with the band eats the black it is supposed to be outlining. */
		--rim: calc(var(--u) * 0.75);
		/* The rim carries the depth. Mixing toward the background rather than
		   picking a grey keeps it correct in both themes and at any tone. */
		--rim-ink: color-mix(in srgb, var(--ink) calc(var(--tone, 1) * 100%), var(--bg));
		filter: drop-shadow(var(--rim) 0 0 var(--rim-ink))
			drop-shadow(calc(var(--rim) * -1) 0 0 var(--rim-ink))
			drop-shadow(0 var(--rim) 0 var(--rim-ink))
			drop-shadow(0 calc(var(--rim) * -1) 0 var(--rim-ink));
	}

	/* ---------- the clouds ---------- */

	/* Sprites rather than a plate, so each one can squash on its own. The
	   track is a row of identical segments and scrolls by exactly one of
	   them, which is the same loop guarantee a tiled plate gets. */
	.plx-sky {
		width: max-content;
		background-image: none;
	}

	.plx-sky-track {
		display: flex;
		width: max-content;
		height: 100%;
	}

	/* Page-driven, the layer is placed by the scroll — so the weather moves to
	   the track inside it. Clouds keep drifting when the page is at rest: the
	   one thing in the band that is never waiting for the reader. */
	.plx.is-driven .plx-sky-track {
		animation: plx-scroll 190s linear infinite;
		animation-play-state: var(--plx-play, running);
	}

	.plx-sky-seg {
		position: relative;
		flex: 0 0 var(--tile);
		width: var(--tile);
		height: 100%;
	}

	.plx-cloud {
		position: absolute;
		left: calc(var(--u) * var(--cx));
		top: calc(var(--u) * var(--cy));
		width: calc(var(--u) * var(--cw));
		height: calc(var(--u) * var(--ch));
		background-image: var(--cloud);
		background-repeat: no-repeat;
		background-size: 100% 100%;
		/* Squashing about a point low in the shape is what makes it read as
		   weight settling rather than a box being scaled. */
		transform-origin: 50% 72%;
		animation: plx-cloud-squash 3.1s ease-in-out infinite;
		animation-play-state: var(--plx-play, running);
		will-change: transform;
	}

	@keyframes plx-cloud-squash {
		0%,
		100% {
			transform: translateY(0) scale(1);
		}
		18% {
			transform: translateY(calc(var(--u) * 1.6)) scale(1.08, 0.92);
		}
		36% {
			transform: translateY(calc(var(--u) * -2.1)) scale(0.95, 1.08);
		}
		55% {
			transform: translateY(calc(var(--u) * 0.6)) scale(1.04, 0.97);
		}
		72% {
			transform: translateY(calc(var(--u) * -0.66)) scale(0.98, 1.03);
		}
	}

	/* ---------- landmarks ---------- */

	/* Somewhere, not everywhere: placed by the controller against the section
	   each one stands for. With no script there is no "where", so they wait
	   out of sight rather than being tiled into a pattern that means nothing. */
	.plx-mark {
		position: absolute;
		left: 0;
		top: calc(var(--u) * (var(--mbase) - var(--mh)));
		width: calc(var(--u) * var(--mw));
		height: calc(var(--u) * var(--mh));
		visibility: hidden;
		cursor: pointer;
		will-change: transform;
	}

	.plx-mark.is-on {
		visibility: visible;
	}

	.plx-mark-art {
		display: block;
		width: 100%;
		height: 100%;
		background: var(--mark) no-repeat center / 100% 100%;
		transform-origin: 50% 100%;
	}

	@media (hover: hover) and (pointer: fine) {
		.plx-mark:hover .plx-mark-art {
			animation: boing 550ms var(--ease-boing);
		}
	}

	/* What floats, bobs; what is afloat, rocks. Planted things stay planted. */
	.plx-mark.does-bob .plx-mark-art {
		animation: plx-bob 5.2s ease-in-out infinite;
		animation-play-state: var(--plx-play, running);
	}

	.plx-mark.does-sway .plx-mark-art {
		animation: plx-sway 4.1s ease-in-out infinite;
		animation-play-state: var(--plx-play, running);
	}

	@keyframes plx-bob {
		0%,
		100% {
			transform: translateY(0) rotate(-0.6deg);
		}
		50% {
			transform: translateY(calc(var(--u) * -5)) rotate(0.8deg);
		}
	}

	@keyframes plx-sway {
		0%,
		100% {
			transform: rotate(-1.4deg) translateY(0);
		}
		50% {
			transform: rotate(1.4deg) translateY(calc(var(--u) * 1.4));
		}
	}

	/* ---------- travelers ---------- */

	/* Whoever wanders onto the trail stands here: in front of the path and
	   the landmarks, behind Bo. Placed by ../lib/stage/troupe.ts. */
	.plx-actors {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	/* ---------- Bo ---------- */

	.plx-bo {
		position: absolute;
		left: var(--bo-x);
		bottom: calc(var(--u) * var(--bo-bottom));
		width: var(--bo-w);
		height: var(--bo-h);
		/* He leans into a run from the ankles, not the waist. */
		transform-origin: 53% 96%;
		rotate: var(--lean, 0deg);
	}

	/* 36 frames in a 6x6 grid. On a timer one animation walks the columns and
	   a second, exactly six times slower, steps down the rows; page-driven,
	   the controller sets the frame from the ground covered instead. */
	.plx-bo-walk {
		position: absolute;
		inset: 0;
		background-image: var(--bo-sprite);
		background-repeat: no-repeat;
		background-size: 600% 600%;
		background-position: 0 0;
		animation:
			bo-col calc(var(--bo-frame) * 6) steps(6) infinite,
			bo-row calc(var(--bo-frame) * 36) steps(6) infinite;
		animation-play-state: var(--plx-play, running);
	}

	.plx.is-driven .plx-bo-walk {
		animation: none;
	}

	/* Standing about: frame 0 rests, 1-10 are one hop that lands back on
	   rest, 11 is a blink — the contract BoIdle.astro documents. Only shown
	   once the page is driving and the ground has stopped. */
	.plx-bo-idle {
		position: absolute;
		left: calc(var(--u) * var(--idle-left));
		top: calc(var(--u) * var(--idle-top));
		width: calc(var(--u) * var(--idle-w));
		height: calc(var(--u) * var(--idle-h));
		background-image: var(--bo-idle);
		background-repeat: no-repeat;
		background-size: 1200% 100%;
		background-position: 0 0;
		visibility: hidden;
	}

	.plx.is-driven .plx-bo:not(.is-walking) .plx-bo-idle {
		visibility: visible;
	}

	.plx.is-driven .plx-bo:not(.is-walking) .plx-bo-walk {
		visibility: hidden;
	}

	.plx-bo.is-hop .plx-bo-idle {
		animation: plx-bo-hop 950ms steps(10) 1;
	}

	.plx-bo.is-blink .plx-bo-idle {
		animation: plx-bo-blink 190ms steps(1) 1;
	}

	/* The stop itself: a walking pose swapped for a standing one is a pop,
	   and a squash is how a cartoon lands. The site's own small boing, so
	   this is the signature bounce and not a second one. His lean lives on
	   `rotate`, which leaves `transform` free for it. */
	.plx-bo.is-settle {
		animation: boing-sm 450ms var(--ease-boing) 1;
	}

	@keyframes plx-bo-hop {
		from {
			background-position-x: calc(100% / 11);
		}
		to {
			background-position-x: 100%;
		}
	}

	@keyframes plx-bo-blink {
		from,
		to {
			background-position-x: 100%;
		}
	}

	/* At night the soot silhouette gets the cream rim the SVG Bo already has. */
	:global(:root[data-theme="dark"]) .plx-bo {
		filter: drop-shadow(1.2px 0 0 var(--ink)) drop-shadow(-1.2px 0 0 var(--ink))
			drop-shadow(0 1.2px 0 var(--ink)) drop-shadow(0 -1.2px 0 var(--ink));
	}

	@keyframes bo-col {
		from {
			background-position-x: 0;
		}
		to {
			background-position-x: calc(var(--bo-w) * -6);
		}
	}

	@keyframes bo-row {
		from {
