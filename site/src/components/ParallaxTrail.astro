		}
		to {
			background-position-y: calc(var(--bo-h) * -6);
		}
	}

	/* ---------- where you are ---------- */

	/* An inert marker, so flat ink: no shadow, no chamfer (see DESIGN.md,
	   "Pressable = raised"). It names the stretch of trail the page is on. */
	.plx-where {
		position: absolute;
		left: clamp(0.6rem, 2vw, 1.25rem);
		top: 0.55rem;
		margin: 0;
		padding: 0.16rem 0.6rem;
		border: 1.5px solid var(--border-strong);
		border-radius: 999px;
		background: var(--bg);
		color: var(--text-mute);
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		line-height: 1.5;
		text-transform: uppercase;
		white-space: nowrap;
		pointer-events: none;
	}

	.plx:not(.is-driven) .plx-where {
		display: none;
	}

	.plx-where.is-flip {
		animation: plx-where-flip var(--dur-move) var(--ease) 1;
	}

	@keyframes plx-where-flip {
		from {
			translate: 0 -0.4rem;
			opacity: 0;
		}
		to {
			translate: 0 0;
			opacity: 1;
		}
	}

	/* ---------- stopping ---------- */

	/* The pause button and the reader's own motion preference resolve to one
	   inherited property that every animation in the band reads, so nothing
	   can freeze Bo without freezing the scenery with him. */
	.plx.is-still {
		--plx-play: paused;
	}

	.plx.is-still .plx-mark-art,
	.plx.is-still .plx-bo-idle,
	.plx.is-still .plx-bo {
		animation: none;
	}

	.plx-pause {
		position: absolute;
		right: 0.75rem;
		bottom: 0.75rem;
		display: grid;
		place-items: center;
		width: 2.1rem;
		height: 2.1rem;
		padding: 0;
		border: 2px solid var(--ink);
		border-radius: 50%;
		background: var(--bg);
		color: var(--ink);
		cursor: pointer;
		opacity: 0;
		transition: opacity var(--dur-move) var(--ease);
	}

	.plx-pause:focus-visible,
	.plx-pause[aria-pressed="true"] {
		opacity: 1;
	}

	@media (hover: hover) and (pointer: fine) {
		.plx:hover .plx-pause {
			opacity: 1;
		}
	}

	/* Without a cursor there is nothing to reveal it with, and a pause control
	   is not optional for something that moves on its own — so on touch it
	   just sits there. */
	@media (hover: none) {
		.plx-pause {
			opacity: 0.9;
		}
	}

	.plx-pause-icon {
		width: 0.7rem;
		height: 0.78rem;
