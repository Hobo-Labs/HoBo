	}

	.plx-pause[aria-pressed="true"] .plx-pause-icon {
		clip-path: polygon(10% 0, 100% 50%, 10% 100%);
	}

	.plx-pause-label {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* ---------- sizes ---------- */

	/* Room to be the picture: on a tall, wide screen the band can afford to
	   be a scene rather than a strip. */
	@media (min-width: 1000px) and (min-height: 860px) {
		.plx {
			--band-h: 204px;
		}
	}

	@media (max-width: 900px) {
		.plx {
			--bo-x: 18%;
		}
	}

	/* Small or short: the page needs the room more than the trail does. */
	@media (max-width: 560px), (max-height: 620px) {
		.plx {
			--band-h: 132px;
			--bo-x: 12%;
		}

		.plx-pause {
			right: 0.5rem;
			bottom: 0.5rem;
		}

