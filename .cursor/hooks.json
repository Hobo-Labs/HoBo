{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "[ ! -f \".cursor/skills/impeccable/scripts/hook-before-edit.mjs\" ] || node \".cursor/skills/impeccable/scripts/hook-before-edit.mjs\"",
        "timeout": 5
      }
    ],
    "sessionStart": [
      {
        "command": "sh \"$(git rev-parse --show-toplevel 2>/dev/null)/scripts/ensure-hooks-path.sh\" >/dev/null 2>&1; exit 0",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "python3 scripts/agent_completion_hook.py cursor",
        "timeout": 10,
        "loop_limit": null
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python3 scripts/agent_completion_hook.py prompt cursor",
        "timeout": 10
      }
    ],
    "afterFileEdit": [
      {
        "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-source-policy.mjs\"",
        "timeout": 60
      }
    ],
    "afterShellExecution": [
      {
        "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-source-policy.mjs\"",
        "timeout": 60
      }
    ],
    "afterMCPExecution": [
      {
        "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-source-policy.mjs\"",
        "timeout": 60
      }
    ]
  }
}
