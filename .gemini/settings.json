{
  "hooks": {
    "AfterTool": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "repository-source-policy",
            "command": "node --experimental-strip-types \"$(git rev-parse --show-toplevel)/scripts/agent-source-policy.mts\" && printf '{}'",
            "timeout": 60000
          }
        ]
      }
    ]
  }
}
