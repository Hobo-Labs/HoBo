#!/usr/bin/env node
/**
 * Writes or checks the frozen HoBo Fleet API snapshots (ADR-0182).
 *
 *   node --import tsx scripts/emit-fleet-contracts.mts --write
 *   node --import tsx scripts/emit-fleet-contracts.mts --check
 *
 * For every package in `FLEET_CONTRACT_PACKAGES` it runs the TypeScript compiler
 * with `emitDeclarationOnly` over the package, then, entry by entry and in
 * barrel order, writes the emitted declaration of every name the entry exports
 * to `contracts/api.snapshot.d.ts`. A barrel that only re-exports would emit
 * nothing but `export … from` lines, so each name is resolved to the
 * declaration it stands for: the emitted `.d.ts` statement for the package's
 * own sources, the published `.d.ts` statement for a name re-exported from
 * another package. `--check` compares and lists every package whose snapshot
 * differs. Packages must be buildable: their workspace dependencies resolve
 * through built `dist/` declarations, so run `pnpm exec turbo run build` with a
 * `--filter` for each listed package first (a TS2307 error says so).
 *
 * The coordinator alone runs `--write`, in the contract commit and in each
 * amendment commit; a lane never edits a snapshot.
 */
import { existsSync, readFileSync, writeFileSync } from "node:fs";
import { dirname, join, relative, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import ts from "typescript";

const repoRoot = resolve(dirname(fileURLToPath(import.meta.url)), "..");

/**
 * The packages with entry points in the frozen contracts, each with the source
 * files whose exports form its contract. The fleet packages snapshot every
 * subpath barrel of their `exports` map; the three existing packages snapshot
 * only the modules the fleet added, so unrelated changes to them do not count
 * as contract changes. `@hobo/backend-routing` joins at the wave-5 merge.
 */
const FLEET_CONTRACT_PACKAGES: readonly Readonly<{
	dir: string;
	entries: "exports" | readonly string[];
}>[] = [
	{ dir: "packages/fleet", entries: "exports" },
	{ dir: "packages/fleet-nats", entries: "exports" },
	{ dir: "packages/fleet-p2p", entries: "exports" },
	{ dir: "packages/fleet-agent", entries: "exports" },
	{ dir: "packages/fleet-authority", entries: "exports" },
	{
		dir: "packages/identity",
		entries: ["src/fleet/index.ts", "src/attestation.ts"],
	},
	{
		dir: "packages/connectivity",
		entries: ["src/overlay-transport.ts", "src/minters/index.ts"],
	},
	{ dir: "packages/ci-gh-actions", entries: ["src/fleet-work/index.ts"] },
];

const SNAPSHOT = "contracts/api.snapshot.d.ts";
const HEADER = [
	"// Frozen HoBo Fleet contract (ADR-0182). Generated by",
	"// `node --import tsx scripts/emit-fleet-contracts.mts --write`; do not edit.",
	"",
].join("\n");

type PackageManifest = Readonly<{
	exports?: Readonly<Record<string, string | Readonly<{ default?: string }>>>;
}>;

function entryFiles(
	packageDir: string,
	entries: "exports" | readonly string[],
): string[] {
	if (entries !== "exports") return [...entries];
	// SAFETY: a workspace package.json; only its `exports` map is read, and a missing one throws below.
	const manifest = JSON.parse(
		readFileSync(join(repoRoot, packageDir, "package.json"), "utf8"),
	) as PackageManifest;
	if (!manifest.exports)
		throw new Error(`${packageDir}: package.json has no exports map`);
	return Object.values(manifest.exports).flatMap((target) => {
		// oxlint-disable-next-line anti-slop/no-runtime-typeof -- SAFETY: parses a package.json exports entry (string or condition map) read at this I/O boundary.
		const built = typeof target === "string" ? target : target.default;
		return built === undefined
			? []
			: [built.replace(/^\.\/dist\//, "src/").replace(/\.js$/, ".ts")];
	});
}

function statementName(statement: ts.Statement): string | undefined {
	if (
		ts.isFunctionDeclaration(statement) ||
		ts.isClassDeclaration(statement) ||
		ts.isInterfaceDeclaration(statement) ||
		ts.isTypeAliasDeclaration(statement) ||
		ts.isEnumDeclaration(statement) ||
		ts.isModuleDeclaration(statement)
	) {
		return statement.name?.getText();
	}
	if (ts.isVariableStatement(statement)) {
		const first = statement.declarationList.declarations[0];
		return first?.name.getText();
	}
	return undefined;
}

function statementsNamed(
	text: string,
	fileName: string,
	name: string,
): string[] {
	const source = ts.createSourceFile(
		fileName,
		text,
		ts.ScriptTarget.Latest,
		true,
	);
	const printer = ts.createPrinter({ removeComments: true });
	return source.statements
		.filter((statement) => statementName(statement) === name)
		.map((statement) =>
			printer.printNode(ts.EmitHint.Unspecified, statement, source),
		);
}

function snapshotOf(
	packageDir: string,
	entries: "exports" | readonly string[],
): string {
	const absoluteDir = join(repoRoot, packageDir);
	const configPath = join(absoluteDir, "tsconfig.json");
	const parsed = ts.getParsedCommandLineOfConfigFile(
		configPath,
		{
			noEmit: false,
			declaration: true,
			emitDeclarationOnly: true,
			sourceMap: false,
			declarationMap: false,
		},
		{
			...ts.sys,
			onUnRecoverableConfigFileDiagnostic: (diagnostic) => {
				throw new Error(
					ts.flattenDiagnosticMessageText(diagnostic.messageText, "\n"),
				);
			},
		},
	);
	if (!parsed) throw new Error(`${packageDir}: cannot read tsconfig.json`);
	const program = ts.createProgram({
		rootNames: parsed.fileNames,
		options: parsed.options,
	});
	const errors = ts
		.getPreEmitDiagnostics(program)
		.filter(
			(diagnostic) => diagnostic.category === ts.DiagnosticCategory.Error,
		);
	if (errors.length > 0) {
		const host = {
			getCanonicalFileName: (f: string) => f,
			getCurrentDirectory: () => repoRoot,
			getNewLine: () => "\n",
		};
		// TS2307: a workspace dependency resolves through its built `dist/`.
		const unbuilt = errors.some((diagnostic) => diagnostic.code === 2307)
			? "\nA workspace dependency is not built. Build the fleet contract packages first:\n  pnpm exec turbo run build --filter=@hobo/fleet --filter=@hobo/fleet-nats --filter=@hobo/fleet-p2p --filter=@hobo/fleet-agent --filter=@hobo/fleet-authority --filter=@hobo/identity --filter=@hobo/connectivity --filter=@hobo/ci-gh-actions\n"
			: "";
		throw new Error(
			`${packageDir} does not type-check:\n${ts.formatDiagnostics(errors.slice(0, 20), host)}${unbuilt}`,
		);
	}
	const emitted = new Map<string, string>();
	program.emit(
		undefined,
		(fileName, text) => {
			emitted.set(resolve(fileName), text);
		},
		undefined,
		true,
	);
	const outDir = parsed.options.outDir ?? absoluteDir;
	const rootDir = parsed.options.rootDir ?? absoluteDir;
	const declarationText = (sourceFile: ts.SourceFile): string => {
		if (sourceFile.isDeclarationFile) return sourceFile.text;
		const out = resolve(outDir, relative(rootDir, sourceFile.fileName)).replace(
			/\.(m|c)?tsx?$/,
			".d.ts",
		);
		const text = emitted.get(out);
		if (text === undefined)
			throw new Error(`no declaration emitted for ${sourceFile.fileName}`);
		return text;
	};

	const checker = program.getTypeChecker();
	const sections: string[] = [];
	for (const entry of entryFiles(packageDir, entries)) {
		const sourceFile = program.getSourceFile(join(absoluteDir, entry));
		if (!sourceFile)
			throw new Error(`${packageDir}: entry ${entry} is not in the program`);
		const moduleSymbol = checker.getSymbolAtLocation(sourceFile);
		const lines = [`// ── ${entry}`];
		for (const exported of moduleSymbol
			? checker.getExportsOfModule(moduleSymbol)
			: []) {
			const target =
				exported.flags & ts.SymbolFlags.Alias
					? checker.getAliasedSymbol(exported)
					: exported;
			const seen = new Set<string>();
			for (const declaration of target.declarations ?? []) {
				let statement: ts.Node = declaration;
				while (statement.parent && !ts.isSourceFile(statement.parent))
					statement = statement.parent;
				const declarationFile = statement.getSourceFile();
				for (const text of statementsNamed(
					declarationText(declarationFile),
					declarationFile.fileName,
					target.getName(),
				)) {
					if (seen.has(text)) continue;
					seen.add(text);
					lines.push(
						exported.getName() === target.getName()
							? text
							: `// exported as ${exported.getName()}\n${text}`,
					);
				}
			}
		}
		sections.push(lines.join("\n"));
	}
	return `${HEADER}${sections.join("\n\n")}\n`;
}

function main(): void {
	const args = new Set(process.argv.slice(2));
	const write = args.has("--write");
	const check = args.has("--check");
	if (write === check) {
		console.error("usage: emit-fleet-contracts.mts --write | --check");
		process.exit(2);
	}
	const differing: string[] = [];
	for (const { dir, entries } of FLEET_CONTRACT_PACKAGES) {
		const snapshot = snapshotOf(dir, entries);
		const target = join(repoRoot, dir, SNAPSHOT);
		if (write) {
			writeFileSync(target, snapshot);
			console.log(`wrote ${relative(repoRoot, target)}`);
			continue;
		}
		const current = existsSync(target)
			? readFileSync(target, "utf8")
			: undefined;
		if (current !== snapshot)
			differing.push(
				`${dir}/${SNAPSHOT}${current === undefined ? " (missing)" : ""}`,
			);
	}
	if (differing.length > 0) {
		console.error(
			[
				"fleet contract snapshots differ from the sources:",
				...differing.map((d) => `- ${d}`),
			].join("\n"),
		);
		process.exit(1);
	}
	if (check) console.log("fleet contract snapshots match");
}

main();
