			{ "foreground": "ink", "background": "paper" },
			{ "foreground": "ink", "background": "cream" },
			{ "foreground": "mute", "background": "paper" },
			{ "foreground": "faint", "background": "paper" },
			{ "foreground": "cream", "background": "nightRaised" },
			{ "foreground": "borderStrong", "background": "nightRaised" },
			{ "foreground": "border", "background": "nightRaised" },
			{ "foreground": "go", "background": "inset" },
			{ "foreground": "go", "background": "paper" },
			{ "foreground": "spark", "background": "inset" },
			{ "foreground": "spark", "background": "paper" },
			{ "foreground": "spark", "background": "cream" },
			{ "foreground": "paper", "background": "spark" },
			{ "foreground": "nightGo", "background": "nightRaised" },
