{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "turbo.json",
    "tsconfig.base.json"
  ],
  "envMode": "strict",
  "globalPassThroughEnv": [
    "CI",
    "HOBO_*",
    "PLAYWRIGHT_*",
    "TMPDIR",
    "TMP",
    "TEMP",
    "SOURCE_DATE_EPOCH",
    "NODE_EXTRA_CA_CERTS",
    "SSL_CERT_FILE",
    "SSL_CERT_DIR",
    "CURL_CA_BUNDLE",
    "REQUESTS_CA_BUNDLE",
    "NIX_SSL_CERT_FILE",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "NO_PROXY",
    "http_proxy",
    "https_proxy",
    "no_proxy",
    "CELLD_BIN",
    "CELLD_ESBUILD",
    "NODE_OPTIONS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!test/**",
        "!tests/**",
        "!contracts/**",
        "!features/**",
        "!__snapshots__/**",
        "!**/*.test.ts",
        "!**/*.spec.ts",
        "!vitest.config.*",
        "!vitest.*.config.*",
        "!playwright.config.*"
      ],
      "outputs": ["dist/**"]
    },
    "@hobo/ci-guard#build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "lint": { "outputs": [] },
    "test": { "dependsOn": ["build"], "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/__snapshots__/**"], "outputs": [] },
    "@hobo/code#test": {
      "dependsOn": ["build", "@hobo/hobo#build", "@hobo/adapter-hono#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../test/setup/hobo-test-homes.ts",
        "../../test/setup/isolate-hobo-home.ts",
        "!**/*.md",
        "!**/__snapshots__/**"
      ],
      "outputs": []
    },
    "@hobo/conformance#test": { "dependsOn": ["build", "@hobo/storage-sqlite#build"], "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/__snapshots__/**"], "outputs": [] },
    "@hobo/hobo#test": { "dependsOn": ["build", "@hobo/adapter-hono#build"], "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/__snapshots__/**"], "outputs": [] },
    "@hobo/runtime#test": { "dependsOn": ["build", "@hobo/runtime-local#build"], "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/__snapshots__/**"], "outputs": [] },
    "test:unit": { "dependsOn": ["^build"], "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/__snapshots__/**"], "outputs": [] },
    "test:schema": { "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/__snapshots__/**"], "outputs": [] },
    "test:contract:consumer": { "dependsOn": ["^build"], "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/__snapshots__/**"], "outputs": ["pacts/**"] },
    "test:contract:provider": { "dependsOn": ["build"], "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/__snapshots__/**"], "outputs": [] },
    "//#typecheck:root": {
      "dependsOn": [
        "@hobo/bindles#build",
        "@hobo/ci#build",
        "@hobo/connectivity#build",
        "@hobo/core#build",
        "@hobo/dispatcher#build"
      ],
      "inputs": ["tsconfig.json", "tsconfig.base.json", "scripts/**", "test/**", "!scripts/ci/**"],
      "outputs": []
    },
    "//#test:unit:root:0": {
      "dependsOn": ["//#test:unit:dependencies"],
      "inputs": [
        "package.json",
        "vitest.config.ts",
        "test/setup/**",
        "test/design-md-check.test.ts",
        "test/designer-council-personas.test.ts",
        "test/designer-council-relevant-check.test.ts",
        "test/designer-council-sdlc.test.ts",
        "test/draft-artifact-gates.test.ts",
        "scripts/**",
        "!scripts/test/**",
        "docs/**",
        ".optimizexp/**",
        ".agents/skills/**",
        ".claude/skills/**",
        "src/draft/**",
        "**/DESIGN.md",
        "site/package.json",
        "packages/**/package.json",
        "packages/runtimes/runtime-wasm/src/**",
        "packages/runtimes/runtime-wasm/test/wasmtime-global-setup.ts"
      ],
      "outputs": []
    },
    "//#test:unit:root:1": {
      "dependsOn": ["//#test:unit:dependencies"],
      "inputs": [
        "package.json",
        "vitest.config.ts",
        "test/**",
        "test/cli-docs.test.ts",
        "test/competitor-docs.boundaries.test.ts",
        "test/competitor-docs.characterization.test.ts",
        "test/competitor-docs.cli.test.ts",
        "test/design-docs.test.ts",
        "test/designer-council-adversarial.test.ts",
        "test/fixture-paths-at-root.test.ts",
        "test/optimizexp-preflight-approval.test.ts",
        "test/relevant-check-policy.test.ts",
        "test/root-script-pins.test.ts",
        "scripts/**",
        "docs/**",
        ".optimizexp/**",
        ".agents/**",
        ".claude/**",
        "**/*test.ts",
        "**/*test.mjs",
        "packages/cli/src/shell/verbs.ts",
        "packages/**/test/**",
        "packages/**/tests/**",
        "src/draft/**/test/**",
        "src/draft/**/tests/**",
        "packages/runtimes/runtime-wasm/src/**",
        "packages/runtimes/runtime-wasm/test/wasmtime-global-setup.ts"
      ],
      "outputs": []
