        "test/competitor-docs.test.ts",
        "test/designer-council-review-loop.test.ts",
        "test/doctor-agent-tooling.test.ts",
        "test/lint-slop-changed.test.ts",
        "scripts/**",
        "!scripts/test/**",
        "docs/**",
        "AGENTS.md",
        "AUTH.md",
        "contracts/**",
        ".claude/**",
        ".codex/**",
        ".cursor/**",
        ".mcp.json",
        "mise.toml",
        "mise.lock",
        ".github/**",
        "packages/ci-gh-actions/templates/**",
        "packages/runtimes/runtime-wasm/src/**",
        "packages/runtimes/runtime-wasm/test/wasmtime-global-setup.ts"
      ],
      "outputs": []
    },
    "//#test:unit:root:3": {
      "dependsOn": ["//#test:unit:dependencies"],
      "inputs": [
        "package.json",
        "vitest.config.ts",
        "test/setup/**",
        "test/architecture-guardrails.test.mjs",
        "test/competitor-docs.parser.test.ts",
        "test/docs-coverage.test.ts",
        "test/hobo-home-isolation.test.ts",
        "test/promoted-proof-drift.test.ts",
        "test/run-tests-node-test-exclusion.test.ts",
        "scripts/**",
        "!scripts/test/**",
        "docs/**",
        "src/draft/**",
        "packages/**",
        "packages/runtimes/runtime-wasm/src/**",
        "packages/runtimes/runtime-wasm/test/wasmtime-global-setup.ts"
