    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@hobo/adapter-infisical": "workspace:*",
    "@hobo/cd": "workspace:*",
    "@hobo/hobo": "workspace:*",
    "@hobo/hobo-ci": "workspace:*",
    "@vercel/oidc": "4.0.0",
    "@vercel/queue": "0.10.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@hobo/camps": "workspace:*",
    "@hobo/core": "workspace:*",
    "@hobo/hobo-cd": "workspace:*",
    "@hobo/identity": "workspace:*",
    "@hobo/junctions": "workspace:*",
    "@hobo/provider-vercel": "workspace:*",
    "@hobo/yards": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run"
