{
  "name": "@hobo/cd-vercel",
  "version": "0.0.1",
  "description": "HoBo.CD on Vercel: the CD mount as a function, its passes on a schedule",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
