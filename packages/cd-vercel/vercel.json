{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/cd.ts": {
      "maxDuration": 300,
      "includeFiles": "deploy/secret-store.binding.json"
    },
    "api/tick.ts": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "hobo-cd",
          "maxConcurrency": 1
        }
      ],
      "includeFiles": "deploy/secret-store.binding.json"
    }
  },
  "schedules": {
    "hobo-cd-tick": {
      "schedule": "* * * * *",
      "topic": "hobo-cd"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/cd",
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/$1"
        }
      ]
    }
  ]
}
