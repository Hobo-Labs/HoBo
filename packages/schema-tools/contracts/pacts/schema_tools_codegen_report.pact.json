{
  "consumer": {
    "name": "HoboCiSchemaGate"
  },
  "provider": {
    "name": "SchemaToolsCodegen"
  },
  "metadata": {
    "pactSpecification": {
      "version": "4.0.0"
    },
    "transport": "cli-json"
  },
  "interactions": [
    {
      "type": "Synchronous/Messages",
      "description": "a current generated tree passes the JSON check",
      "providerStates": [
        {
          "name": "generated output is current"
        }
      ],
      "request": {
        "contents": {
          "contentType": "application/json",
          "encoded": false,
          "content": {
            "argv": [
              "--check",
              "--json"
            ]
          }
        }
      },
      "response": [
        {
          "contents": {
            "contentType": "application/json",
            "encoded": false,
            "content": {
              "exitCode": 0,
              "report": {
                "status": "CLEAN",
                "drift": [],
                "cueViolations": []
              }
            }
          }
        }
      ]
    },
    {
      "type": "Synchronous/Messages",
      "description": "modified generated output fails the JSON check",
      "providerStates": [
        {
          "name": "the event envelope output is modified"
        }
      ],
      "request": {
        "contents": {
          "contentType": "application/json",
          "encoded": false,
          "content": {
            "argv": [
              "--check",
              "--json"
            ]
          }
        }
      },
      "response": [
        {
          "contents": {
            "contentType": "application/json",
            "encoded": false,
            "content": {
              "exitCode": 1,
              "report": {
                "status": "DRIFT",
                "drift": [
                  {
                    "path": "core/hobo/core/v1/event_envelope_pb.ts",
                    "kind": "changed"
                  }
                ],
                "cueViolations": []
              }
            }
          }
        }
      ]
    }
  ]
}
