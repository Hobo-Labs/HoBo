{
	"consumer": { "name": "HoboFleetAuthority" },
	"provider": { "name": "NetbirdSetupKeysApi" },
	"interactions": [
		{
			"description": "list groups",
			"request": {
				"method": "GET",
				"path": "/api/groups"
			},
			"response": {
				"status": 200,
				"headers": { "Content-Type": "application/json" },
				"body": [
					{ "id": "ch8i4ug6lnn4g9hqv7m0", "name": "All", "peers_count": 3 },
					{ "id": "ch8i4ug6lnn4g9hqv7mg", "name": "fleet-ci", "peers_count": 1 }
				]
			}
		},
		{
			"description": "create a one-off setup key with usage limit 1 that joins the fleet-ci group",
			"request": {
				"method": "POST",
				"path": "/api/setup-keys",
				"headers": { "Content-Type": "application/json" },
				"body": {
					"type": "one-off",
					"usage_limit": 1,
					"expires_in": 86400,
					"auto_groups": ["ch8i4ug6lnn4g9hqv7mg"],
					"ephemeral": false
				}
			},
			"response": {
				"status": 200,
				"headers": { "Content-Type": "application/json" },
				"body": {
					"id": 2531583362,
					"key": "A616097E-FCF0-48FA-9354-CA4A61142761",
					"name": "hobo-fleet acme dev_0123456789abcdef0123456789abcdef",
					"expires": "2026-11-14T10:00:00Z",
					"type": "one-off",
					"valid": true,
					"revoked": false,
					"used_times": 0,
					"last_used": "0001-01-01T00:00:00Z",
					"state": "valid",
					"auto_groups": ["ch8i4ug6lnn4g9hqv7mg"],
					"updated_at": "2026-11-13T10:00:00Z",
					"usage_limit": 1,
					"ephemeral": false
				}
			}
		}
	],
	"metadata": {
		"pactSpecification": { "version": "3.0.0" }
	}
}
