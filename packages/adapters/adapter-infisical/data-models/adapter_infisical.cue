package adapter_infisical

// Constraints for the Infisical config-service boundary (ADR-0179). Field
// names are the protobuf JSON names, which are also Infisical's wire names.

#jwt: string & =~"^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"

#InfisicalBinding: {
	// HTTPS, or plain HTTP to a loopback address (a local Infisical or a test).
	siteUrl:     string & (=~"^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?$" | =~"^http://(127\\.0\\.0\\.1|localhost|\\[::1\\])(:[0-9]{1,5})?$")
	projectId:   string & =~"^[A-Za-z0-9-]{1,64}$"
	environment: string & =~"^[a-z0-9][a-z0-9_-]{0,63}$"
	secretPath:  string & =~"^/([A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*)?$" & =~"^.{1,512}$"
}

#InfisicalLoginResponse: {
	accessToken:        string & =~"^[!-~]+$"
	expiresIn:          int & >0 & <=31536000
	accessTokenMaxTTL?: int & >=0
	tokenType:          "Bearer"
	...
}

#InfisicalSecret: {
	secretKey: string & =~"^[A-Za-z0-9_.-]{1,256}$"
	secretValue: string
	version:     int & >=1
	// A read needs false; a names-only listing (viewSecretValue=false) is true.
	secretValueHidden?: bool
	...
}

#InfisicalSecretList: {
	secrets: [...#InfisicalSecret]
	...
}

#InfisicalApproval: {
	id: string & !=""
	...
}

// A write held by a secret-protection policy answers `approval`, not `secret`.
#InfisicalSecretEnvelope: {
	secret: #InfisicalSecret
	...
} | {
	approval: #InfisicalApproval
	...
}

#InfisicalErrorEnvelope: {
	reqId?:      string
	statusCode?: int & >=400 & <=599
	error?:      string
	...
}

#InfisicalOidcLoginRequest: {
	identityId: string & =~"^[A-Za-z0-9-]{1,64}$"
	jwt:        #jwt
}

#InfisicalUniversalAuthLoginRequest: {
	clientId:     string & =~"^[!-~]+$"
	clientSecret: string & =~"^[!-~]+$"
}

#InfisicalTokenRevokeRequest: {
	accessToken: string & =~"^[!-~]+$"
}

#InfisicalTokenRevokeResponse: {
	message: string
	...
}

#InfisicalSecretWriteRequest: {
	projectId:   #InfisicalBinding.projectId
	environment: #InfisicalBinding.environment
	secretPath:  #InfisicalBinding.secretPath
	secretValue: string
	type:        "shared"
}

// The GitHub Actions OIDC token endpoint's answer.
#GithubActionsIdToken: {
	value: #jwt
	...
}

// Provisioning a store HoBo created (ADR-0179 amendment, 2026-11-12).

#id: string & =~"^[A-Za-z0-9-]{1,64}$"

#InfisicalBootstrapRequest: {
	email: string & =~"^[^@\\s]{1,64}@[A-Za-z0-9.-]{1,190}$"
	// Generated by HoBo: long, printable, no whitespace.
	password:     string & =~"^[!-~]{24,256}$"
	organization: string & =~"^[A-Za-z0-9][A-Za-z0-9 ._-]{0,63}$"
}

#InfisicalBootstrapUser: {
	id:         #id
	email:      string
	superAdmin: true
	...
}

#InfisicalOrganization: {
	id: #id
	...
}

#InfisicalIdentityCredentials: {
	token: string & =~"^[!-~]{1,16384}$"
	...
}

#InfisicalBootstrapIdentity: {
	id:          #id
	credentials: #InfisicalIdentityCredentials
	...
}

#InfisicalBootstrapResponse: {
	user:         #InfisicalBootstrapUser
	organization: #InfisicalOrganization
	identity:     #InfisicalBootstrapIdentity
	...
}

#InfisicalProject: {
	id: #id
	...
}

#InfisicalCreateProjectResponse: {
	project: #InfisicalProject
	...
}

#InfisicalFolder: {
	id: #id
	...
}

#InfisicalCreateFolderResponse: {
	folder: #InfisicalFolder
	...
}

#InfisicalProjectRole: {
	role: "viewer" | "member"
}

#InfisicalIdentity: {
	id: #id
	...
}

#InfisicalIdentityResponse: {
	identity: #InfisicalIdentity
	...
}

#InfisicalIdentityOidcAuth: {
	identityId: #id
	...
}

#InfisicalAttachOidcAuthResponse: {
	identityOidcAuth: #InfisicalIdentityOidcAuth
	...
}

#InfisicalCreateProjectRequest: {
	projectName: string & =~"^[A-Za-z0-9][A-Za-z0-9 ._-]{0,63}$"
	slug:        string & =~"^[a-z0-9][a-z0-9-]{0,35}$"
	type:        "secret-manager"
	shouldCreateDefaultEnvs: true
}

#InfisicalCreateFolderRequest: {
	workspaceId: #id
	environment: #InfisicalBinding.environment
	name:        string & =~"^[A-Za-z0-9_-]{1,64}$"
	path:        #InfisicalBinding.secretPath
}

#InfisicalCreateProjectIdentityRequest: {
	name: string & =~"^[a-z0-9][a-z0-9-]{0,63}$"
	// The relay and the deploy identity read, each in its own project.
	roles: [#InfisicalProjectRole]
}

#InfisicalAttachOidcAuthRequest: {
	oidcDiscoveryUrl: string & =~"^https://"
	boundIssuer:      oidcDiscoveryUrl
	boundAudiences:   string & !=""
	boundClaims: [string]: string
	boundSubject:      string & !=""
	accessTokenTTL:    int & >0 & <=86400
	accessTokenMaxTTL: int & >=accessTokenTTL & <=86400
}

// The flat fixture corpus holds bindings.
#AdapterInfisical: #InfisicalBinding
