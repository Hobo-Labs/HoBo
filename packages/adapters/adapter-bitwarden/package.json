{
	"name": "@hobo/adapter-bitwarden",
	"version": "0.0.1",
	"license": "MIT",
	"description": "Optional Bitwarden Secrets Manager SecretsPort adapter for HoBo over the official Bitwarden SDK's client (injected): one secret per key in one project. Not secretless for a workload: a machine account signs in with an access token, so HoBo uses it on the owner's side, never for the hosted relay's runtime reads.",
	"type": "module",
	"engines": {
		"node": "^22.21.0 || >=24"
	},
	"files": [
		"LICENSE",
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.12.1",
		"@hobo/identity": "workspace:*"
	},
	"devDependencies": {
		"@hobo/contract-harness": "workspace:*",
		"@types/node": "^22.15.29",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"typecheck:types": "tsc --noEmit -p tsconfig.types.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../../scripts/ensure-built.mts",
		"test": "vitest run",
		"test:contract:consumer": "vitest run contracts/consumer",
		"test:contract:provider": "vitest run contracts/provider"
	}
}
