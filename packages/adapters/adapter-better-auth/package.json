{
	"name": "@hobo/adapter-better-auth",
	"version": "0.0.1",
	"license": "MIT",
	"description": "HoBo Better Auth adapter: the default self-hosted full-featured hobo:auth issuer descriptor, config parse with locator-only secrets, and the versioned claims-to-principal mapping.",
	"type": "module",
	"files": [
		"LICENSE",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hobo/auth-adapter-contract": "workspace:*",
		"@hobo/core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.15.29",
		"vitest": "^4.1.9"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../../scripts/ensure-built.mts",
		"test": "vitest run test/",
		"test:unit": "vitest run test/"
	}
}
