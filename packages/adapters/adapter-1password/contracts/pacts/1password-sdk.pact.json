{
	"consumer": {
		"name": "HoboOnePasswordAdapter"
	},
	"provider": {
		"name": "OnePasswordSdk"
	},
	"interactions": [
		{
			"description": "items.list returns the vault's item overviews (titles and ids, no values)",
			"providerState": "vault abcdefghijklmnopqrstuvwxyz holds HOBO_CI_VALKEY_URL as item itemaaaaaaaaaaaaaaaaaaaaa1",
			"request": {
				"method": "POST",
				"path": "/sdk/items.list",
				"body": {
					"vaultId": "abcdefghijklmnopqrstuvwxyz"
				}
			},
			"response": {
				"status": 200,
				"body": [
					{
						"id": "itemaaaaaaaaaaaaaaaaaaaaa1",
						"title": "HOBO_CI_VALKEY_URL",
						"vaultId": "abcdefghijklmnopqrstuvwxyz"
					}
				]
			}
		},
		{
			"description": "items.get returns the item with its concealed password field",
			"providerState": "vault abcdefghijklmnopqrstuvwxyz holds HOBO_CI_VALKEY_URL as item itemaaaaaaaaaaaaaaaaaaaaa1",
			"request": {
				"method": "POST",
				"path": "/sdk/items.get",
				"body": {
					"vaultId": "abcdefghijklmnopqrstuvwxyz",
					"itemId": "itemaaaaaaaaaaaaaaaaaaaaa1"
				}
			},
			"response": {
				"status": 200,
				"body": {
					"id": "itemaaaaaaaaaaaaaaaaaaaaa1",
					"title": "HOBO_CI_VALKEY_URL",
					"category": "Password",
					"vaultId": "abcdefghijklmnopqrstuvwxyz",
					"fields": [
						{
							"id": "password",
							"title": "password",
							"fieldType": "Concealed",
							"value": "fixture-value-1"
						}
					],
					"version": 1
				}
			}
		},
		{
			"description": "items.create makes a Password item for a new secret",
			"providerState": "vault abcdefghijklmnopqrstuvwxyz has no item NEW_SECRET",
			"request": {
				"method": "POST",
				"path": "/sdk/items.create",
				"body": {
					"category": "Password",
					"vaultId": "abcdefghijklmnopqrstuvwxyz",
					"title": "NEW_SECRET",
					"fields": [
						{
							"id": "password",
							"title": "password",
							"fieldType": "Concealed",
							"value": "fixture-value-2"
						}
					],
					"tags": [
						"hobo"
					]
				}
			},
			"response": {
				"status": 200,
				"body": {
					"id": "itemaaaaaaaaaaaaaaaaaaaaa2",
					"title": "NEW_SECRET",
					"category": "Password",
					"vaultId": "abcdefghijklmnopqrstuvwxyz",
					"fields": [
						{
							"id": "password",
							"title": "password",
							"fieldType": "Concealed",
							"value": "fixture-value-2"
						}
					],
					"version": 1
				}
			}
		},
		{
			"description": "items.put replaces an existing item's value and bumps its version",
			"providerState": "vault abcdefghijklmnopqrstuvwxyz holds HOBO_CI_VALKEY_URL as item itemaaaaaaaaaaaaaaaaaaaaa1",
			"request": {
				"method": "POST",
				"path": "/sdk/items.put",
				"body": {
					"id": "itemaaaaaaaaaaaaaaaaaaaaa1",
					"title": "HOBO_CI_VALKEY_URL",
					"category": "Password",
					"vaultId": "abcdefghijklmnopqrstuvwxyz",
					"fields": [
						{
							"id": "password",
							"title": "password",
							"fieldType": "Concealed",
							"value": "fixture-value-3"
						}
					],
					"version": 1
				}
			},
			"response": {
				"status": 200,
				"body": {
					"id": "itemaaaaaaaaaaaaaaaaaaaaa1",
					"title": "HOBO_CI_VALKEY_URL",
					"category": "Password",
					"vaultId": "abcdefghijklmnopqrstuvwxyz",
					"fields": [
						{
							"id": "password",
							"title": "password",
							"fieldType": "Concealed",
							"value": "fixture-value-3"
						}
					],
					"version": 2
				}
			}
		},
		{
			"description": "items.get for an item that does not exist is not found",
			"providerState": "vault abcdefghijklmnopqrstuvwxyz has no item itemaaaaaaaaaaaaaaaaaaaaa2",
			"request": {
				"method": "POST",
				"path": "/sdk/items.get",
				"body": {
					"vaultId": "abcdefghijklmnopqrstuvwxyz",
					"itemId": "itemzzzzzzzzzzzzzzzzzzzzzz"
				}
			},
			"response": {
				"status": 404,
				"body": {
					"error": "item not found"
				}
			}
		}
	],
	"metadata": {
		"pactSpecification": {
			"version": "3.0.0"
		},
		"source": "@1password/sdk 0.4.0 Client.items (list, get, create, put), type declarations read 2026-11-12"
	}
}
