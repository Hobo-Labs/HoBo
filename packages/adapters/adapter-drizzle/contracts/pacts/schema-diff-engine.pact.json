{
  "consumer": { "name": "@hobo/trails" },
  "provider": { "name": "@hobo/adapter-drizzle" },
  "interactions": [
    {
      "description": "generated SQL migrates existing rows through all phases",
      "providerState": "users with two existing email addresses",
      "request": {
        "backfillSql": "UPDATE \"users\" SET \"name\" = \"email\" WHERE \"name\" IS NULL",
        "legacyConsumers": []
      },
      "response": {
        "status": "completed",
        "dualWindowOpen": false,
        "columns": ["email", "id", "name"],
        "rows": [
          { "id": 1, "email": "a@example.test", "name": "a@example.test" },
          { "id": 2, "email": "b@example.test", "name": "b@example.test" }
        ]
      }
    },
    {
      "description": "failed backfill verification restores the original table and rows",
      "providerState": "users with two existing email addresses",
      "request": {
        "backfillSql": "UPDATE \"users\" SET \"name\" = \"email\" WHERE \"id\" = 1",
        "legacyConsumers": []
      },
      "response": {
        "status": "rolled-back",
        "dualWindowOpen": false,
        "columns": ["email", "id"],
        "rows": [
          { "id": 1, "email": "a@example.test" },
          { "id": 2, "email": "b@example.test" }
        ]
      }
    },
    {
      "description": "legacy readers hold the contract phase open after backfill",
      "providerState": "users with two existing email addresses",
      "request": {
        "backfillSql": "UPDATE \"users\" SET \"name\" = \"email\" WHERE \"name\" IS NULL",
        "legacyConsumers": ["legacy-reader"]
      },
      "response": {
        "status": "contract-blocked",
        "dualWindowOpen": true,
        "columns": ["email", "id", "name"],
        "rows": [
          { "id": 1, "email": "a@example.test", "name": "a@example.test" },
          { "id": 2, "email": "b@example.test", "name": "b@example.test" }
        ]
      }
    }
  ],
  "metadata": {
    "pactSpecification": { "version": "2.0.0" },
    "evidence": "packages/trails/test/drizzle-migration.test.ts"
  }
}
