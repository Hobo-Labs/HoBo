{
	"name": "@hobo/adapter-drizzle",
	"version": "0.0.1",
	"license": "MIT",
	"description": "PostgreSQL Drizzle schema ingestion and phased SQL generation for HoBo migrations.",
	"type": "module",
	"files": [
		"LICENSE",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hobo/core": "workspace:*",
		"drizzle-kit": "0.31.11",
		"drizzle-orm": "0.44.7"
	},
	"devDependencies": {
		"@electric-sql/pglite": "0.3.14",
		"@types/node": "^22.15.29",
		"vitest": "^4.1.9"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.test.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../../scripts/ensure-built.mts",
		"test": "vitest run test/",
		"test:unit": "vitest run test/"
	}
}
