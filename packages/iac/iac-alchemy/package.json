	"dependencies": {
		"@bufbuild/protobuf": "2.12.1"
	},
	"peerDependencies": {
		"@alchemy.run/aws": "2.0.0-beta.87",
		"@alchemy.run/cloudflare": "2.0.0-beta.87",
		"@alchemy.run/rivet": "2.0.0-beta.87",
		"alchemy": "2.0.0-beta.87",
		"effect": "^4.1.4",
		"@effect/platform-node": "^4.1.4",
		"rivetkit": "3.0.0",
		"ws": "^8.21.0",
		"@distilled.cloud/aws": "1.0.0-rc.20"
	},
	"peerDependenciesMeta": {
		"@alchemy.run/aws": {
			"optional": true
		},
		"@alchemy.run/cloudflare": {
			"optional": true
		},
		"@alchemy.run/rivet": {
			"optional": true
		},
		"rivetkit": {
			"optional": true
		},
		"@distilled.cloud/aws": {
			"optional": true
		}
	},
	"devDependencies": {
		"@alchemy.run/aws": "2.0.0-beta.87",
		"@alchemy.run/cloudflare": "2.0.0-beta.87",
		"@alchemy.run/rivet": "2.0.0-beta.87",
		"@emulators/aws": "0.13.1",
		"@emulators/core": "0.13.1",
		"alchemy": "2.0.0-beta.87",
		"effect": "4.1.4",
		"@effect/platform-node": "4.1.4",
		"rivetkit": "3.0.0",
		"ws": "8.21.0",
		"vitest": "^4.1.9",
		"@types/node": "^24.13.2",
		"miniflare": "4.20260722.0",
		"@distilled.cloud/aws": "1.0.0-rc.20"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../../scripts/ensure-built.mts && node --experimental-strip-types test/ensure-integration-built.mts && tsc --noEmit -p tsconfig.secret-tests.json && tsc --noEmit -p tsconfig.kv-actor-tests.json && tsc --noEmit -p tsconfig.kv-tests.json && tsc --noEmit -p tsconfig.http-kv-tests.json && tsc --noEmit -p tsconfig.http-queue-tests.json && tsc --noEmit -p tsconfig.capability-tests.json && tsc --noEmit -p tsconfig.aws-tests.json && tsc --noEmit -p tsconfig.cloudflare-storage-tests.json",
		"test": "vitest run",
		"test:aws-emulator": "node --experimental-strip-types test/run-official-aws-emulator.mts",
		"test:contract:consumer": "vitest run contracts/consumer"
	}
}
