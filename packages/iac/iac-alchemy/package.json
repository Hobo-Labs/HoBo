	"license": "MIT",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=22.19.0"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./cloudflare": {
			"types": "./dist/cloudflare.d.ts",
			"default": "./dist/cloudflare.js"
		},
		"./aws": {
			"types": "./dist/aws.d.ts",
			"default": "./dist/aws.js"
		},
		"./aws/vite": {
			"types": "./dist/aws-vite.d.ts",
			"default": "./dist/aws-vite.js"
		},
		"./cloudflare/runtime": {
			"types": "./dist/cloudflare-runtime.d.ts",
			"default": "./dist/cloudflare-runtime.js"
		},
		"./rivet": {
			"types": "./dist/rivet.d.ts",
			"default": "./dist/rivet.js"
		},
		"./rivet/namespace": {
			"types": "./dist/rivet-namespace.d.ts",
			"default": "./dist/rivet-namespace.js"
		},
		"./rivet/runtime": {
			"types": "./dist/rivet-runtime.d.ts",
			"default": "./dist/rivet-runtime.js"
		},
		"./rivet/queue": {
			"types": "./dist/rivet-queue.d.ts",
			"default": "./dist/rivet-queue.js"
		},
		"./rivet/queue/runtime": {
			"types": "./dist/rivet-queue-runtime.d.ts",
			"default": "./dist/rivet-queue-runtime.js"
		},
		"./rivet/kv": {
			"types": "./dist/rivet-kv.d.ts",
			"default": "./dist/rivet-kv.js"
		},
		"./rivet/kv/runtime": {
			"types": "./dist/rivet-kv-runtime.d.ts",
			"default": "./dist/rivet-kv-runtime.js"
		},
		"./rivet/composition": {
			"types": "./dist/rivet-composition-support.d.ts",
			"default": "./dist/rivet-composition-support.js"
		},
		"./rivet/standalone": {
			"types": "./dist/rivet-standalone.d.ts",
			"default": "./dist/rivet-standalone.js"
