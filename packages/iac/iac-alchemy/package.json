		"./cloudflare/r2": {
			"types": "./dist/cloudflare-native-r2.d.ts",
			"default": "./dist/cloudflare-native-r2.js"
		},
		"./aws/kv": {
			"types": "./dist/aws-kv.d.ts",
			"default": "./dist/aws-kv.js"
		},
		"./aws/kv-mapper": {
			"types": "./dist/aws-kv-mapper.d.ts",
			"default": "./dist/aws-kv-mapper.js"
		}
