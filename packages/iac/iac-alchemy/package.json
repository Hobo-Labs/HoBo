{
	"name": "@hobo/iac-alchemy",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=22.19.0"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./rivet": {
			"types": "./dist/rivet.d.ts",
			"default": "./dist/rivet.js"
		},
		"./rivet/runtime": {
			"types": "./dist/rivet-runtime.d.ts",
			"default": "./dist/rivet-runtime.js"
		},
		"./rivet/queue": {
			"types": "./dist/rivet-queue.d.ts",
			"default": "./dist/rivet-queue.js"
		},
		"./rivet/queue/runtime": {
			"types": "./dist/rivet-queue-runtime.d.ts",
			"default": "./dist/rivet-queue-runtime.js"
		},
		"./rivet/kv": {
			"types": "./dist/rivet-kv.d.ts",
			"default": "./dist/rivet-kv.js"
		},
		"./rivet/kv/runtime": {
			"types": "./dist/rivet-kv-runtime.d.ts",
			"default": "./dist/rivet-kv-runtime.js"
		},
		"./rivet/multi": {
			"types": "./dist/rivet-multi.d.ts",
			"default": "./dist/rivet-multi.js"
		},
		"./rivet/http-kv": {
			"types": "./dist/rivet-http-kv.d.ts",
			"default": "./dist/rivet-http-kv.js"
		},
		"./rivet/http-queue": {
			"types": "./dist/rivet-http-queue.d.ts",
			"default": "./dist/rivet-http-queue.js"
		}
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.12.1"
	},
	"peerDependencies": {
		"@alchemy.run/rivet": "2.0.0-beta.87",
		"alchemy": "2.0.0-beta.87",
		"effect": "^4.1.4",
		"@effect/platform-node": "^4.1.4",
		"rivetkit": "3.0.0",
		"ws": "^8.21.0"
	},
	"peerDependenciesMeta": {
		"@alchemy.run/rivet": {
			"optional": true
		},
		"rivetkit": {
			"optional": true
		}
	},
	"devDependencies": {
		"@alchemy.run/rivet": "2.0.0-beta.87",
		"alchemy": "2.0.0-beta.87",
		"effect": "4.1.4",
		"@effect/platform-node": "4.1.4",
		"rivetkit": "3.0.0",
		"ws": "8.21.0",
		"vitest": "^4.1.9",
		"@types/node": "^22.15.29"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../../scripts/ensure-built.mts && node --experimental-strip-types test/ensure-integration-built.mts && tsc --noEmit -p tsconfig.secret-tests.json && tsc --noEmit -p tsconfig.kv-actor-tests.json && tsc --noEmit -p tsconfig.kv-tests.json && tsc --noEmit -p tsconfig.http-kv-tests.json && tsc --noEmit -p tsconfig.http-queue-tests.json && tsc --noEmit -p tsconfig.capability-tests.json",
		"test": "vitest run",
		"test:contract:consumer": "vitest run contracts/consumer"
	}
}
