{
	"name": "@hobo/iac-alchemy",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=22.19.0"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./cloudflare": {
			"types": "./dist/cloudflare.d.ts",
			"default": "./dist/cloudflare.js"
		},
		"./cloudflare/runtime": {
			"types": "./dist/cloudflare-runtime.d.ts",
			"default": "./dist/cloudflare-runtime.js"
		},
		"./cloudflare/kv": {
			"types": "./dist/cloudflare-native-kv.d.ts",
			"default": "./dist/cloudflare-native-kv.js"
		},
		"./cloudflare/r2": {
			"types": "./dist/cloudflare-native-r2.d.ts",
			"default": "./dist/cloudflare-native-r2.js"
		},
		"./rivet": {
			"types": "./dist/rivet.d.ts",
			"default": "./dist/rivet.js"
		},
		"./rivet/runtime": {
			"types": "./dist/rivet-runtime.d.ts",
			"default": "./dist/rivet-runtime.js"
		},
		"./rivet/multi": {
			"types": "./dist/rivet-multi.d.ts",
			"default": "./dist/rivet-multi.js"
		},
		"./rivet/queue": {
			"types": "./dist/rivet-queue.d.ts",
			"default": "./dist/rivet-queue.js"
		}
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.12.1"
	},
	"peerDependencies": {
		"@alchemy.run/cloudflare": "2.0.0-beta.87",
		"@alchemy.run/rivet": "2.0.0-beta.87",
		"alchemy": "2.0.0-beta.87",
		"effect": "^4.1.4",
		"@effect/platform-node": "^4.1.4",
		"rivetkit": "3.0.0",
		"ws": "^8.21.0"
	},
	"peerDependenciesMeta": {
		"@alchemy.run/cloudflare": {
			"optional": true
		},
		"@alchemy.run/rivet": {
			"optional": true
		},
		"rivetkit": {
			"optional": true
		}
	},
	"devDependencies": {
		"@alchemy.run/cloudflare": "2.0.0-beta.87",
		"@alchemy.run/rivet": "2.0.0-beta.87",
		"alchemy": "2.0.0-beta.87",
		"effect": "4.1.4",
		"@effect/platform-node": "4.1.4",
		"rivetkit": "3.0.0",
		"miniflare": "4.20260722.0",
		"ws": "8.21.0",
		"vitest": "^4.1.9",
		"@types/node": "^22.15.29"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"test": "vitest run",
		"test:contract:consumer": "vitest run contracts/consumer"
	}
}
