{
  "consumer": {
    "name": "HoboCdTrustedPublisherVerifier"
  },
  "provider": {
    "name": "OidcIssuer"
  },
  "metadata": {
    "pactSpecification": {
      "version": "4.0.0"
    },
    "evidence": "Hand-authored HTTP contract for OIDC discovery and JWKS as the GitHub Actions and GitLab issuers serve them. Verified by contracts/ingest.consumer.test.ts: the verifier's requests must match these requests exactly and it must accept these responses; JWKS keys are matched by type, so the test serves its own RSA key in the contracted shape."
  },
  "interactions": [
    {
      "type": "Synchronous/HTTP",
      "description": "GitHub Actions OIDC discovery",
      "providerStates": [
        {
          "name": "issuer https://token.actions.githubusercontent.com"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/.well-known/openid-configuration",
        "headers": {
          "accept": "application/json"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json",
          "cache-control": "public, max-age=3600"
        },
        "body": {
          "issuer": "https://token.actions.githubusercontent.com",
          "jwks_uri": "https://token.actions.githubusercontent.com/.well-known/jwks",
          "subject_types_supported": [
            "public",
            "pairwise"
          ],
          "response_types_supported": [
            "id_token"
          ],
          "id_token_signing_alg_values_supported": [
            "RS256"
          ],
          "claims_supported": [
            "sub",
            "aud",
            "exp",
            "iat",
            "iss",
            "jti",
            "nbf",
            "ref",
            "repository",
            "repository_owner",
            "workflow_ref",
            "environment"
          ],
          "scopes_supported": [
            "openid"
          ]
        }
      }
    },
    {
      "type": "Synchronous/HTTP",
      "description": "GitHub Actions JWKS",
      "providerStates": [
        {
          "name": "issuer https://token.actions.githubusercontent.com"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/.well-known/jwks",
        "headers": {
          "accept": "application/json"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json",
          "cache-control": "public, max-age=3600"
        },
        "body": {
          "keys": [
            {
              "kty": "RSA",
              "alg": "RS256",
              "use": "sig",
              "kid": "<key id>",
              "n": "<modulus>",
              "e": "AQAB"
            }
          ]
        },
        "matchingRules": {
          "body": {
            "$.keys": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            }
          }
        }
      }
    },
    {
      "type": "Synchronous/HTTP",
      "description": "GitLab OIDC discovery",
      "providerStates": [
        {
          "name": "issuer https://gitlab.com"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/.well-known/openid-configuration",
        "headers": {
          "accept": "application/json"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json",
          "cache-control": "max-age=300"
        },
        "body": {
          "issuer": "https://gitlab.com",
          "jwks_uri": "https://gitlab.com/oauth/discovery/keys",
          "id_token_signing_alg_values_supported": [
            "RS256"
          ],
          "subject_types_supported": [
            "public"
          ]
        }
      }
    },
    {
      "type": "Synchronous/HTTP",
      "description": "GitLab JWKS",
      "providerStates": [
        {
          "name": "issuer https://gitlab.com"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/oauth/discovery/keys",
        "headers": {
          "accept": "application/json"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json",
          "cache-control": "max-age=300"
        },
        "body": {
          "keys": [
            {
              "kty": "RSA",
              "alg": "RS256",
              "use": "sig",
              "kid": "<key id>",
              "n": "<modulus>",
              "e": "AQAB"
            }
          ]
        },
        "matchingRules": {
          "body": {
            "$.keys": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            }
          }
        }
      }
    }
  ]
}
