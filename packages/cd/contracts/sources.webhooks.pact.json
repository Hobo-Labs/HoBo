{
	"consumer": {
		"name": "WebhookSenders"
	},
	"provider": {
		"name": "HoboCdFreightSourcesNudge"
	},
	"metadata": {
		"pactSpecification": {
			"version": "4.0.0"
		},
		"evidence": "Hand-authored inbound webhook contract for FreightSources.nudge, one interaction per receiver in the payload and signature form each sender documents (HMAC-SHA256 for GitHub/GHCR/Bitbucket/Gitea/Forgejo; shared token for GitLab, Harbor, ECR EventBridge API destinations, Docker Hub and Pub/Sub push; bearer for CloudEvents). Signatures use the contract secret `contract-secret`. Verified by contracts/sources.consumer.test.ts: valid requests schedule exactly the listed sources and record no Freight; the forged request schedules nothing."
	},
	"interactions": [
		{
			"type": "Synchronous/HTTP",
			"description": "GitHub push for a tag",
			"providerStates": [
				{
					"name": "webhook secret configured for github"
				},
				{
					"name": "sources defined for the contract repositories"
				}
			],
			"request": {
				"method": "POST",
				"path": "/v1/cd/sources/nudge/github",
				"headers": {
					"X-GitHub-Event": "push",
					"x-hub-signature-256": "sha256=5ec98aa278ad346d02f5b217e334c819fe6f06eb2cdd56452b6324a2bb9fb9b4"
				},
				"body": {
					"content": "{\"ref\":\"refs/tags/v1.2.0\",\"repository\":{\"clone_url\":\"https://github.com/acme/web.git\"}}",
					"contentType": "application/json",
					"encoded": false
				}
			},
			"response": {
				"status": 202,
				"headers": {
					"content-type": "application/json"
				},
				"body": {
					"content": "{\"receiver\":\"github\",\"scheduled\":[\"git-web\"]}",
					"contentType": "application/json",
					"encoded": false
				}
			}
		},
