{
  "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
  "kind": "Kustomization",
  "metadata": {
    "annotations": {
      "hobo.dev/camp-id": "prod",
      "hobo.dev/content-hash": "sha256:3333333333333333333333333333333333333333333333333333333333333333",
      "hobo.dev/freight-id": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
      "hobo.dev/set-id": "set-prod-7"
    },
    "labels": {
      "app.kubernetes.io/managed-by": "hobo",
      "hobo.dev/camp": "camp-prod"
    },
    "name": "hobo-prod",
    "namespace": "flux-system"
  },
  "spec": {
    "interval": "1m",
    "path": "./hobo/camps/camp-prod/manifests",
    "prune": true,
    "sourceRef": {
      "kind": "GitRepository",
      "name": "hobo"
    },
    "suspend": false,
    "targetNamespace": "hobo-system",
    "wait": true
  }
}
