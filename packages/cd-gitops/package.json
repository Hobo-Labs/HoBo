{
	"name": "@hobo/cd-gitops",
	"version": "0.0.1",
	"description": "HoBo CD GitOps publisher and Kargo+Argo/Flux pull-based CD flow adapter: renders Sets and typed manifest updates, opens/tracks Git PRs across GitHub/GitLab/Gitea/Bitbucket, and converges only on observed engine status",
	"license": "MIT",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"LICENSE",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"test": "vitest run"
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.12.1",
		"@hobo/cd": "workspace:*",
		"@hobo/core": "workspace:*",
		"effect": "4.1.4"
	},
	"devDependencies": {
		"@alchemy.run/domain": "2.0.0-beta.87"
	}
}
