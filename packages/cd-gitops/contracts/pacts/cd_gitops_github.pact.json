{
	"consumer": {
		"name": "HoboCdGitopsPublisher"
	},
	"provider": {
		"name": "GitHubRestApi"
	},
	"interactions": [
		{
			"description": "read the branch head",
			"request": {
				"method": "GET",
				"path": "/repos/acme/deploy/git/ref/heads/main",
				"headers": {
					"authorization": "Bearer git-token",
					"accept": "application/vnd.github+json",
					"x-github-api-version": "2022-11-28"
				}
			},
			"response": {
				"status": 200,
				"body": {
					"ref": "refs/heads/main",
					"object": {
						"sha": "1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b",
						"type": "commit"
					}
				}
			}
		},
		{
			"description": "the engine document is not there yet",
			"request": {
				"method": "GET",
				"path": "/repos/acme/deploy/contents/hobo/camps/camp-prod/argo-cd.application.json",
				"query": "ref=1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b"
			},
			"response": {
				"status": 404,
				"body": {
					"message": "Not Found"
				}
			}
		},
		{
			"description": "the set document is not there yet",
			"request": {
				"method": "GET",
				"path": "/repos/acme/deploy/contents/hobo/camps/camp-prod/manifests/hobo-set.configmap.json",
				"query": "ref=1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b"
			},
			"response": {
				"status": 404,
				"body": {
					"message": "Not Found"
				}
			}
		},
		{
			"description": "read the parent commit's tree",
			"request": {
				"method": "GET",
				"path": "/repos/acme/deploy/git/commits/1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b"
			},
			"response": {
				"status": 200,
				"body": {
					"sha": "1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b",
					"tree": {
						"sha": "7e7e7e7e7e7e7e7e"
					}
				}
			}
		},
		{
			"description": "create a tree with both documents inline",
			"request": {
				"method": "POST",
				"path": "/repos/acme/deploy/git/trees",
				"body": {
					"base_tree": "7e7e7e7e7e7e7e7e",
					"tree": [
						{
							"path": "hobo/camps/camp-prod/argo-cd.application.json",
							"mode": "100644",
							"type": "blob"
						},
						{
							"path": "hobo/camps/camp-prod/manifests/hobo-set.configmap.json",
							"mode": "100644",
							"type": "blob"
						}
					]
				}
			},
			"response": {
				"status": 201,
				"body": {
					"sha": "8d8d8d8d8d8d8d8d"
				}
			}
		},
		{
			"description": "create the commit on the parent",
			"request": {
				"method": "POST",
				"path": "/repos/acme/deploy/git/commits",
				"body": {
					"tree": "8d8d8d8d8d8d8d8d",
					"parents": [
						"1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b"
					]
				}
			},
			"response": {
				"status": 201,
				"body": {
					"sha": "9f8e7d6c5b4a39281706f5e4d3c2b1a098f7e6d5"
				}
			}
		},
		{
			"description": "fast-forward the branch",
			"request": {
				"method": "PATCH",
				"path": "/repos/acme/deploy/git/refs/heads/main",
				"body": {
					"sha": "9f8e7d6c5b4a39281706f5e4d3c2b1a098f7e6d5",
					"force": false
				}
			},
			"response": {
				"status": 200,
				"body": {
					"ref": "refs/heads/main",
					"object": {
						"sha": "9f8e7d6c5b4a39281706f5e4d3c2b1a098f7e6d5"
					}
				}
			}
		}
	],
	"metadata": {
		"pactSpecification": {
			"version": "3.0.0"
		}
	}
}
