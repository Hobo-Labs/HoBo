{
	"consumer": {
		"name": "HoboCdGitopsPublisher"
	},
	"provider": {
		"name": "BitbucketCloudApi20"
	},
	"interactions": [
		{
			"description": "read the branch head",
			"request": {
				"method": "GET",
				"path": "/2.0/repositories/acme/deploy/refs/branches/main",
				"headers": {
					"authorization": "Bearer git-token"
				}
			},
			"response": {
				"status": 200,
				"body": {
					"name": "main",
					"target": {
						"hash": "1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b"
					}
				}
			}
		},
		{
			"description": "the engine document is not there yet",
			"request": {
				"method": "GET",
				"path": "/2.0/repositories/acme/deploy/src/1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b/hobo/camps/camp-prod/argo-cd.application.json"
			},
			"response": {
				"status": 404,
				"body": {
					"message": "Not Found"
				}
			}
		},
		{
			"description": "the set document is not there yet",
			"request": {
				"method": "GET",
				"path": "/2.0/repositories/acme/deploy/src/1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b/hobo/camps/camp-prod/manifests/hobo-set.configmap.json"
			},
			"response": {
				"status": 404,
				"body": {
					"message": "Not Found"
				}
			}
		},
		{
			"description": "commit both documents with the parent guard",
			"request": {
				"method": "POST",
				"path": "/2.0/repositories/acme/deploy/src",
				"headers": {
					"content-type": "application/x-www-form-urlencoded"
				},
				"body": {
					"form": {
						"branch": "main",
						"parents": "1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b"
					}
				}
			},
			"response": {
				"status": 201,
				"headers": {
					"location": "https://api.bitbucket.org/2.0/repositories/acme/deploy/commit/9f8e7d6c5b4a39281706f5e4d3c2b1a098f7e6d5"
				}
			}
		}
	],
	"metadata": {
		"pactSpecification": {
			"version": "3.0.0"
		}
	}
}
