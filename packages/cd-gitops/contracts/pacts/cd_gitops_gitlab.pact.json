{
	"consumer": {
		"name": "HoboCdGitopsPublisher"
	},
	"provider": {
		"name": "GitLabRestApiV4"
	},
	"interactions": [
		{
			"description": "read the branch head",
			"request": {
				"method": "GET",
				"path": "/api/v4/projects/acme%2Fdeploy/repository/branches/main",
				"headers": {
					"authorization": "Bearer git-token"
				}
			},
			"response": {
				"status": 200,
				"body": {
					"name": "main",
					"commit": {
						"id": "1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b"
					}
				}
			}
		},
		{
			"description": "the engine document is not there yet",
			"request": {
				"method": "GET",
				"path": "/api/v4/projects/acme%2Fdeploy/repository/files/hobo%2Fcamps%2Fcamp-prod%2Fargo-cd.application.json",
				"query": "ref=1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b"
			},
			"response": {
				"status": 404,
				"body": {
					"message": "Not Found"
				}
			}
		},
		{
			"description": "the set document is not there yet",
			"request": {
				"method": "GET",
				"path": "/api/v4/projects/acme%2Fdeploy/repository/files/hobo%2Fcamps%2Fcamp-prod%2Fmanifests%2Fhobo-set.configmap.json",
				"query": "ref=1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b"
			},
			"response": {
				"status": 404,
				"body": {
					"message": "Not Found"
				}
			}
		},
		{
			"description": "commit both documents guarded by start_sha",
			"request": {
				"method": "POST",
				"path": "/api/v4/projects/acme%2Fdeploy/repository/commits",
				"body": {
					"branch": "main",
					"start_sha": "1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b",
					"actions": [
						{
							"action": "create",
							"file_path": "hobo/camps/camp-prod/argo-cd.application.json"
						},
						{
							"action": "create",
							"file_path": "hobo/camps/camp-prod/manifests/hobo-set.configmap.json"
						}
					]
				}
			},
			"response": {
				"status": 201,
				"body": {
					"id": "9f8e7d6c5b4a39281706f5e4d3c2b1a098f7e6d5",
					"short_id": "9f8e7d6c"
				}
			}
		}
	],
	"metadata": {
		"pactSpecification": {
			"version": "3.0.0"
		}
	}
}
