{
  "consumer": {
    "name": "hobo-database-fleet-reconciler"
  },
  "provider": {
    "name": "hobo-postgres-fleet-backend"
  },
  "metadata": {
    "pactSpecification": {
      "version": "4.0.0"
    },
    "transport": "library-call"
  },
  "interactions": [
    {
      "type": "Synchronous/Messages",
      "description": "a backend takes the entry that directly follows its newest one",
      "providerStates": [
        {
          "name": "assignment log case 1",
          "params": {
            "held": [
              {
                "epoch": 1,
                "active": "a",
                "sealed": false,
                "reason": "test",
                "decidedAtMs": 1,
                "decidedBy": "bootstrap"
              }
            ]
          }
        }
      ],
      "request": {
        "contents": {
          "contentType": "application/json",
          "encoded": false,
          "content": {
            "epoch": 2,
            "active": "b",
            "sealed": false,
            "reason": "test",
            "decidedAtMs": 1,
            "decidedBy": "reconciler"
          }
        }
      },
      "response": [
        {
          "contents": {
            "contentType": "application/json",
            "encoded": false,
            "content": "accepted"
          }
        }
      ]
    },
    {
      "type": "Synchronous/Messages",
      "description": "a backend refuses an entry that skips an epoch",
      "providerStates": [
        {
          "name": "assignment log case 2",
          "params": {
            "held": [
              {
                "epoch": 1,
                "active": "a",
                "sealed": false,
                "reason": "test",
                "decidedAtMs": 1,
                "decidedBy": "bootstrap"
              }
            ]
          }
        }
      ],
      "request": {
        "contents": {
          "contentType": "application/json",
          "encoded": false,
          "content": {
            "epoch": 3,
            "active": "b",
            "sealed": false,
            "reason": "test",
            "decidedAtMs": 1,
            "decidedBy": "reconciler"
          }
        }
      },
      "response": [
        {
          "contents": {
            "contentType": "application/json",
            "encoded": false,
            "content": "gap"
          }
        }
      ]
    },
    {
      "type": "Synchronous/Messages",
      "description": "a backend that already holds the identical entry reports a duplicate",
      "providerStates": [
        {
          "name": "assignment log case 3",
          "params": {
            "held": [
              {
                "epoch": 1,
                "active": "a",
                "sealed": false,
                "reason": "test",
                "decidedAtMs": 1,
                "decidedBy": "bootstrap"
              }
            ]
          }
        }
      ],
      "request": {
        "contents": {
          "contentType": "application/json",
          "encoded": false,
          "content": {
            "epoch": 1,
            "active": "a",
            "sealed": false,
            "reason": "test",
            "decidedAtMs": 1,
            "decidedBy": "bootstrap"
          }
        }
      },
      "response": [
        {
          "contents": {
            "contentType": "application/json",
            "encoded": false,
            "content": "duplicate"
          }
        }
      ]
    },
    {
      "type": "Synchronous/Messages",
      "description": "a backend that holds a different entry for the epoch reports a conflict",
      "providerStates": [
        {
          "name": "assignment log case 4",
          "params": {
            "held": [
              {
                "epoch": 1,
                "active": "a",
                "sealed": false,
                "reason": "test",
                "decidedAtMs": 1,
                "decidedBy": "bootstrap"
              },
              {
                "epoch": 2,
                "active": "a",
                "sealed": false,
                "reason": "test",
                "decidedAtMs": 1,
                "decidedBy": "first"
              }
            ]
          }
        }
      ],
      "request": {
        "contents": {
          "contentType": "application/json",
          "encoded": false,
          "content": {
            "epoch": 2,
            "active": "b",
            "sealed": false,
            "reason": "test",
            "decidedAtMs": 1,
            "decidedBy": "second"
          }
        }
      },
      "response": [
        {
          "contents": {
            "contentType": "application/json",
            "encoded": false,
            "content": "conflict"
          }
        }
      ]
    }
  ]
}
