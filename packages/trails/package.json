{
	"name": "@hobo/trails",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"files": [
		"LICENSE",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hobo/data-core": "workspace:*",
		"@hobo/identity": "workspace:*"
	},
	"devDependencies": {
		"@electric-sql/pglite": "0.3.14",
		"@hobo/adapter-drizzle": "workspace:*",
		"@hobo/data-postgres": "workspace:*",
		"@hobo/data-sqlite": "workspace:*",
		"@hobo/runtime-local": "workspace:*",
		"@types/node": "^22.15.29",
		"drizzle-orm": "0.44.7",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../scripts/ensure-built.mts",
		"test": "vitest run"
	}
