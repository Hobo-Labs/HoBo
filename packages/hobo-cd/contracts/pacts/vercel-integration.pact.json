{
	"consumer": {
		"name": "@hobo/hobo-cd"
	},
	"provider": {
		"name": "vercel-rest-api"
	},
	"interactions": [
		{
			"description": "the integration's one-time code exchanges for an access token",
			"providerState": "HoBo CD's Integration installed on a team",
			"request": {
				"method": "POST",
				"path": "/v2/oauth/access_token",
				"headers": { "content-type": "application/x-www-form-urlencoded" }
			},
			"response": {
				"status": 200,
				"body": {
					"token_type": "Bearer",
					"access_token": "<the installation's token, per run>",
					"installation_id": "icfg_test",
					"user_id": "user1",
					"team_id": "team_test"
				}
			}
		},
		{
			"description": "the token acts as the user who installed the integration",
			"providerState": "a valid installation token",
			"request": {
				"method": "GET",
				"path": "/v2/user"
			},
			"response": {
				"status": 200,
				"body": { "user": { "id": "user1" } }
			}
		}
	],
	"metadata": {
		"pactSpecification": { "version": "2.0.0" }
	}
}
