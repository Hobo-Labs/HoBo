{
	"name": "@hobo/hobo-cd",
	"version": "0.0.1",
	"license": "MIT",
	"private": true,
	"description": "HoBo's CD as a HoBo project: a Bindle (the CD service, its tick, its provider connections and a provider-neutral Postgres journal) deployable with hobo up, a CLI (hobo-cd up|down|plan|status), the Vercel provider connection hobo cd up runs first, and the Vercel provider junction that hands the connection's credential to convergence for one run.",
	"type": "module",
	"bin": {
		"hobo-cd": "./dist/cli.js"
	},
	"files": [
		"LICENSE",
		"dist",
		"src/bindle.ts"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"dependencies": {
		"@hobo/bindles": "workspace:*",
		"@hobo/cli": "workspace:*",
		"@hobo/connect-ui": "workspace:*",
		"@hobo/data-postgres": "workspace:*",
		"@hobo/hobo-ci": "workspace:*",
		"@hobo/junctions": "workspace:*",
		"@hobo/yards": "workspace:*",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@hobo/identity": "workspace:*",
		"@types/node": "^22.15.29",
		"vitest": "^4.1.9"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../scripts/ensure-built.mts",
		"test": "vitest run test/"
	}
}
