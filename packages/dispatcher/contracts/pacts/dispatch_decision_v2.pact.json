{
	"consumer": {
		"name": "PricingRoutingControlLoopConsumer"
	},
	"provider": {
		"name": "DispatcherDecisionBoundaryV2"
	},
	"interactions": [
		{
			"description": "dispatcher v2 selects the minimum incremental billed quote",
			"request": {
				"method": "POST",
				"path": "/dispatcher/v2/decide",
				"body": {
					"category": "runner",
					"objective": "min-incremental-billed"
				}
			},
			"response": {
				"status": 200,
				"body": {
					"ok": true,
					"schema": "hobo.dispatcher/v2",
					"objective": "min-incremental-billed",
					"budget": { "evaluation": "not-evaluated", "reservation": "not-created" },
					"selectedProvider": "cheap",
					"dispatchEvent": { "type": "dispatch.Decided" }
				}
			}
		},
		{
			"description": "dispatcher v2 rejects stale quote evidence without a decision fact",
			"request": {
				"method": "POST",
				"path": "/dispatcher/v2/decide",
				"body": {
					"category": "runner",
					"objective": "min-incremental-billed"
				}
			},
			"response": {
				"status": 200,
				"body": {
					"ok": false,
					"schema": "hobo.dispatcher/v2",
					"reason": "no completely priced dispatch candidates",
					"budget": { "evaluation": "not-evaluated", "reservation": "not-created" },
					"rejectedCandidates": [
						{ "providerId": "stale", "code": "STALE_OBSERVATION" }
					]
				}
			}
		},
		{
			"description": "unavailable pricing is excluded and supplied-model provenance accompanies the decision",
			"request": {
				"method": "POST",
				"path": "/dispatcher/v2/decide",
				"body": { "category": "runner", "objective": "min-incremental-billed" }
			},
			"response": {
				"status": 200,
				"body": {
					"ok": true,
					"schema": "hobo.dispatcher/v2",
					"budget": { "evaluation": "not-evaluated", "reservation": "not-created" },
					"selectedProvider": "priced",
					"ranking": [{ "providerId": "priced", "pricingModel": { "source": "developer-supplied", "modelId": "my-contract", "revision": "2" } }],
					"rejectedCandidates": [{ "providerId": "unpriced", "code": "PRICING_MODEL_UNAVAILABLE" }]
				}
			}
		}
	],
	"metadata": {
		"pactSpecification": {
			"version": "3.0.0"
		}
	}
}
