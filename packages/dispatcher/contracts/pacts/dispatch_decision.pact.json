{
  "consumer": {
    "name": "RoutingControlLoopConsumer"
  },
  "provider": {
    "name": "DispatcherDecisionBoundary"
  },
  "metadata": {
    "pactSpecification": {
      "version": "4.0.0"
    },
    "transport": "library-call"
  },
  "interactions": [
    {
      "type": "Synchronous/Messages",
      "description": "budget pressure rejects the unaffordable backend and selects the cheaper one",
      "request": {
        "contents": {
          "contentType": "application/json",
          "encoded": false,
          "content": {
            "registryCandidates": [
              {
                "providerId": "vercel-primary",
                "category": "traffic-backend",
                "listUnitCost": 0.05
              },
              {
                "providerId": "lakebed-cheap",
                "category": "traffic-backend",
                "listUnitCost": 0.01
              }
            ],
            "category": "traffic-backend",
            "objective": "maximize-credits",
            "dispatchId": "route-swap-pact",
            "units": 100,
            "ledgerView": {
              "view": "CreditLedgerView",
              "seq": 7,
              "accounts": [
                {
                  "providerId": "vercel-primary",
                  "dimension": "traffic.requests",
                  "listUnitCost": 0.05,
                  "budgetCap": 4,
                  "spendToDate": 1
                },
                {
                  "providerId": "lakebed-cheap",
                  "dimension": "traffic.requests",
                  "listUnitCost": 0.01,
                  "budgetCap": 4,
                  "spendToDate": 1
                }
              ]
            }
          }
        }
      },
      "response": [
        {
          "contents": {
            "contentType": "application/json",
            "encoded": false,
            "content": {
              "ok": true,
              "selectedProvider": "lakebed-cheap",
              "dispatchEvent": {
                "type": "dispatch.Decided"
              },
              "ranking": [
                {
                  "providerId": "lakebed-cheap"
                },
                {
                  "providerId": "vercel-primary",
                  "eligible": false
                }
              ]
            }
          }
        }
      ]
    },
    {
      "type": "Synchronous/Messages",
      "description": "no registered candidates fails closed without a decision event",
      "request": {
        "contents": {
          "contentType": "application/json",
          "encoded": false,
          "content": {
            "registryCandidates": [],
            "category": "runner",
            "objective": "maximize-credits",
            "dispatchId": "no-candidates-pact",
            "ledgerView": {
              "view": "CreditLedgerView",
              "seq": 7,
              "accounts": []
            }
          }
        }
      },
      "response": [
        {
          "contents": {
            "contentType": "application/json",
            "encoded": false,
            "content": {
              "ok": false,
              "reason": "no registered runner candidates"
            }
          }
        }
      ]
    },
    {
      "type": "Synchronous/Messages",
      "description": "all registered backends exceeding the hard budget fail closed",
      "request": {
        "contents": {
          "contentType": "application/json",
          "encoded": false,
          "content": {
            "registryCandidates": [
              {
                "providerId": "cloud",
                "category": "traffic-backend",
                "listUnitCost": 1
              }
            ],
            "category": "traffic-backend",
            "objective": "maximize-credits",
            "dispatchId": "hard-cap-pact",
            "units": 2,
            "ledgerView": {
              "view": "CreditLedgerView",
              "seq": 8,
              "accounts": [
                {
                  "providerId": "cloud",
                  "dimension": "traffic.requests",
                  "budgetCap": 1,
                  "spendToDate": 0,
                  "listUnitCost": 1
                }
              ]
            }
          }
        }
      },
      "response": [
        {
          "contents": {
            "contentType": "application/json",
            "encoded": false,
            "content": {
              "ok": false,
              "reason": "no eligible candidates within budget and capacity"
            }
          }
        }
      ]
    }
  ]
}
