{
	"name": "@hobo/dispatcher",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"files": [
		"LICENSE",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./sqlite": {
			"types": "./dist/iac-route-sqlite.d.ts",
			"default": "./dist/iac-route-sqlite.js"
		},
		"./v2": {
			"types": "./dist/dispatcher-v2.d.ts",
			"default": "./dist/dispatcher-v2.js"
		},
		"./recovery-sqlite": {
			"types": "./dist/iac-route-recovery-sqlite.d.ts",
			"default": "./dist/iac-route-recovery-sqlite.js"
		},
		"./domain": {
			"types": "./dist/domain/index.d.ts",
			"default": "./dist/domain/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@alchemy.run/domain": "2.0.0-beta.87",
		"@hobo/pricing": "workspace:*",
		"effect": "4.1.4"
	},
	"devDependencies": {
		"@types/node": "^22.15.29",
		"fast-check": "^4.3.0",
		"vitest": "^4.1.9"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.domain.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../scripts/ensure-built.mts && tsc --noEmit -p tsconfig.iac-tests.json && tsc --noEmit -p tsconfig.iac-recovery-tests.json",
		"test": "vitest run",
		"test:contract:consumer": "vitest run contracts/consumer"
	}
}
