{
	"name": "@hobo/core",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"files": [
		"LICENSE",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./aws-sigv4": {
			"types": "./dist/ports/aws-sigv4.d.ts",
			"default": "./dist/ports/aws-sigv4.js"
		},
		"./total-access": {
			"types": "./dist/total-access.d.ts",
			"default": "./dist/total-access.js"
		},
		"./provider-redaction": {
			"types": "./dist/provider-redaction.d.ts",
			"default": "./dist/provider-redaction.js"
		},
		"./linear-time": {
			"types": "./dist/linear-time.d.ts",
			"default": "./dist/linear-time.js"
		},
		"./linear-sweep": {
			"types": "./dist/linear-sweep.d.ts",
			"default": "./dist/linear-sweep.js"
		},
		"./redaction-differential": {
			"types": "./dist/redaction-differential.d.ts",
			"default": "./dist/redaction-differential.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"test": "pnpm run build && vitest run test/",
		"test:contract:consumer": "vitest run contracts/consumer",
		"test:contract:provider": "vitest run contracts/provider"
	},
	"devDependencies": {
		"@hobo/contract-harness": "workspace:*",
		"@stryker-mutator/core": "^10.0.0",
		"@stryker-mutator/vitest-runner": "^10.0.0",
		"@types/node": "^22.15.3",
		"fast-check": "^4.3.0"
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.12.1"
	}
}
