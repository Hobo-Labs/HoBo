{
  "name": "@hobo/ci-vercel",
  "version": "0.0.1",
  "description": "Vercel HTTP transport for the HoBo CI relay",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./turbo-ci": {
      "types": "./dist/turbo-ci.d.ts",
      "default": "./dist/turbo-ci.js"
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@hobo/adapter-infisical": "workspace:*",
    "@hobo/backend-fleet": "workspace:*",
    "@hobo/ci": "workspace:*",
    "@hobo/ci-gh-actions": "workspace:*",
    "@hobo/core": "workspace:*",
    "@hobo/kv-redis-compatible": "workspace:*",
    "@hobo/provider-turso": "workspace:*",
    "@hobo/provider-upstash": "workspace:*",
    "@hobo/provider-vercel-blob": "workspace:*",
    "@vercel/oidc": "4.0.0",
    "@vercel/queue": "0.10.0",
    "@vercel/sandbox": "3.9.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@hobo/bindles": "workspace:*",
    "@hobo/pricing": "workspace:*",
    "@hobo/provider-manifest": "workspace:*",
    "esbuild": "0.28.1",
    "jose": "6.2.4"
  },
  "scripts": {
    "build": "node --import tsx scripts/generate-assets.mts && node --import tsx scripts/generate-proxy-bundle.mts && node --import tsx scripts/generate-offers.mts && tsc -p tsconfig.json",
    "ci:local": "node dist/turbo-ci-cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "biome check .",
    "test": "node --import tsx scripts/generate-proxy-bundle.mts --check && node --import tsx scripts/generate-offers.mts --check && vitest run"
  }
}
