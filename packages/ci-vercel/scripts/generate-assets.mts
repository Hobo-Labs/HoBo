import { execFileSync } from "node:child_process";
import { readFile, writeFile } from "node:fs/promises";
import { createRequire } from "node:module";
import { fileURLToPath } from "node:url";

const workflow = await readFile(
	new URL("../../ci-gh-actions/templates/hobo-ci-host.yml", import.meta.url),
	"utf8",
);
const bootstrap = await readFile(
	new URL("../../ci-gh-actions/src/bootstrap.ts", import.meta.url),
	"utf8",
);
const destination = new URL(
	"../src/_generated-assets/relay-assets.ts",
	import.meta.url,
);
const output = `// Generated by scripts/generate-assets.mts. Do not edit.\nexport const workflow = ${JSON.stringify(workflow)};\nexport const bootstrap = ${JSON.stringify(bootstrap)};\n`;
const generated = execFileSync(
	process.execPath,
	[
		createRequire(import.meta.url).resolve("@biomejs/biome/bin/biome"),
		"format",
		`--stdin-file-path=${fileURLToPath(destination)}`,
	],
	{
		cwd: new URL("../../../", import.meta.url),
		input: output,
		encoding: "utf8",
	},
);
await writeFile(destination, generated);
