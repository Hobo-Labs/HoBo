{
  "consumer": {
    "name": "HoBoCiRelayQueueConsumer"
  },
  "provider": {
    "name": "HoBoCiRelayQueueWakeup"
  },
  "interactions": [
    {
      "description": "hand over a verified delivery from the intake topic",
      "request": {
        "method": "POST",
        "path": "/internal/queue-wakeup",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "kind": "delivery",
          "deliveryId": "72d3162e-cc78-11e3-81ab-4c9367dc0958",
          "event": "workflow_job",
          "installationId": 10,
          "repositoryId": 101,
          "rawBody": "eyJhY3Rpb24iOiJxdWV1ZWQifQ==",
          "receivedAt": "2026-11-11T12:00:00.000Z"
        }
      },
      "response": {
        "status": 204
      }
    },
    {
      "description": "hand over one lease step from the lease-steps topic",
      "request": {
        "method": "POST",
        "path": "/internal/queue-wakeup",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "kind": "lease-step",
          "leaseId": "8a0b8b8e-3f0c-5d7e-9a51-1c2d3e4f5a6b",
          "step": "reconcile",
          "n": 0,
          "job": {
            "id": 4001,
            "runId": 900,
            "runAttempt": 1,
            "repositoryId": 101,
            "installationId": 10,
            "repository": "Org/Repo",
            "isolatedRequired": true
          }
        }
      },
      "response": {
        "status": 204
      }
    },
    {
      "description": "hand over a repair tick from the schedule",
      "request": {
        "method": "POST",
        "path": "/internal/queue-wakeup",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "source": "static",
          "name": "hobo-ci-repair"
        }
      },
      "response": {
        "status": 204
      }
    },
    {
      "description": "a delivery the relay could not process is held for redelivery",
      "providerState": "processing fails",
      "request": {
        "method": "POST",
        "path": "/internal/queue-wakeup",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "kind": "delivery",
          "deliveryId": "72d3162e-cc78-11e3-81ab-4c9367dc0958",
          "event": "workflow_job",
          "installationId": 10,
          "repositoryId": 101,
          "rawBody": "eyJhY3Rpb24iOiJxdWV1ZWQifQ==",
          "receivedAt": "2026-11-11T12:00:00.000Z"
        }
      },
      "response": {
        "status": 503
      }
    },
    {
      "description": "a repair tick that failed is acknowledged and dropped",
      "providerState": "processing fails",
      "request": {
        "method": "POST",
        "path": "/internal/queue-wakeup",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "source": "static",
          "name": "hobo-ci-repair"
        }
      },
      "response": {
        "status": 204
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    }
  }
