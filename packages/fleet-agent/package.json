{
	"name": "@hobo/fleet-agent",
	"version": "0.0.1",
	"license": "MIT",
	"description": "HoBo Fleet device library: key stores, sandbox drivers, the per-order egress proxy, host capacity and service installers. A library; it has no binary.",
	"type": "module",
	"files": [
		"LICENSE",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.12.1",
		"@hobo/core": "workspace:*",
		"@hobo/fleet": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.15.29",
		"fast-check": "^4.3.0",
		"vitest": "^4.1.9"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../scripts/ensure-built.mts",
		"test": "vitest run test/ --exclude '**/*.integration.test.ts' --passWithNoTests",
		"test:unit": "vitest run test/ --exclude '**/*.integration.test.ts' --passWithNoTests",
		"test:integration": "vitest run .integration.test. --passWithNoTests"
	}
}
