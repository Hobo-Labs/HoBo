{
	"consumer": { "name": "HoboApplicationTestSuite" },
	"provider": { "name": "HoboServiceEmulators" },
	"interactions": [
		{
			"description": "a queue resource deduplicates repeated delivery and exposes its fidelity",
			"request": {
				"method": "POST",
				"path": "/queue/jobs",
				"body": { "key": "delivery-1", "message": "hello" }
			},
			"response": {
				"status": 200,
				"body": { "fidelity": "simulated", "deduped": true, "message": "hello" }
			}
		},
		{
			"description": "a topic resource delivers a published message to a consumer group",
			"request": {
				"method": "POST",
				"path": "/topic/events",
				"body": { "message": "hello" }
			},
			"response": {
				"status": 200,
				"body": { "fidelity": "simulated", "message": "hello" }
			}
		},
		{
			"description": "a secret resource supports versioned access without publishing material in outputs",
			"request": {
				"method": "POST",
				"path": "/secret/credentials",
				"body": { "name": "API_KEY", "value": "fixture-only" }
			},
			"response": {
				"status": 200,
				"body": { "fidelity": "simulated", "access": "ok", "versioned": true, "materialInOutputs": false }
			}
		},
		{
			"description": "a data resource stores and reads an isolated tenant record through the engine SPI",
			"request": { "method": "POST", "path": "/data/orders", "body": { "id": "one" } },
			"response": {
				"status": 200,
				"body": { "fidelity": "simulated", "stored": true, "otherTenantAbsent": true }
			}
		},
		{
			"description": "a schedule resource fires intervals on its virtual clock",
			"request": { "method": "POST", "path": "/schedule/nightly", "body": { "interval": 1000 } },
			"response": { "status": 200, "body": { "fidelity": "simulated", "occurrences": [1, 2] } }
		},
		{
			"description": "a resource of the wrong kind cannot be used as a queue",
			"request": { "method": "GET", "path": "/queue/events" },
			"response": {
				"status": 409,
				"body": { "code": "HARNESS_EMULATOR_UNAVAILABLE" }
			}
		}
	],
	"metadata": { "pactSpecification": { "version": "3.0.0" } }
}
