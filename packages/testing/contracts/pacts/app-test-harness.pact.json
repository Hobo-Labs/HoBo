{
	"consumer": { "name": "HoboBindleTestSuite" },
	"provider": { "name": "HoboAppTestHarness" },
	"interactions": [
		{
			"description": "the default lane reports deployment-time fidelity and planned teardown without claiming readiness",
			"request": {
				"method": "POST",
				"path": "/harness/deploy",
				"body": { "lane": "in-process", "stage": "test", "bindle": "demo" }
			},
			"response": {
				"status": 200,
				"body": {
					"contract": "hobo.test-harness/v1",
					"stage": "test",
					"lane": "in-process",
					"handles": [
						{
							"alias": "api",
							"kind": "api",
							"fidelity": "simulated"
						},
						{ "alias": "cache", "kind": "kv", "fidelity": "simulated" },
						{ "alias": "db", "kind": "data", "fidelity": "simulated" }
					],
					"fidelity": {
						"by_fidelity": {
							"real": 0,
							"simulated": 3,
							"mocked": 0,
							"camp-only": 0
						},
						"asserted_against": [],
						"prod_readiness_claimable": false
					},
					"teardown_order": ["api", "db", "cache"]
				}
			}
		},
		{
			"description": "the ephemeral-camp lane deploys real resources through its Camp driver without claiming readiness",
			"request": {
				"method": "POST",
				"path": "/harness/deploy",
				"body": {
					"lane": "ephemeral-camp",
					"stage": "pr-42",
					"bindle": "demo",
					"yard": { "name": "yard:aws", "providerId": "aws" }
				}
			},
			"response": {
				"status": 200,
				"body": {
					"contract": "hobo.test-harness/v1",
					"stage": "pr-42",
					"lane": "ephemeral-camp",
					"handles": [
						{
							"alias": "api",
							"kind": "api",
							"fidelity": "real",
							"endpoint": "https://pr-42.example.test"
						},
						{ "alias": "cache", "kind": "kv", "fidelity": "real" },
						{ "alias": "db", "kind": "data", "fidelity": "real" }
					],
					"fidelity": {
						"by_fidelity": {
							"real": 3,
							"simulated": 0,
							"mocked": 0,
							"camp-only": 0
						},
						"asserted_against": [],
						"prod_readiness_claimable": false
					},
					"teardown_order": ["api", "db", "cache"]
				}
			}
		},
		{
			"description": "accessing simulated resources does not claim production readiness",
			"request": {
				"method": "GET",
				"path": "/harness/fidelity",
				"body": { "assertedAgainst": ["api", "db"] }
			},
			"response": {
				"status": 200,
				"body": {
					"by_fidelity": {
						"real": 0,
						"simulated": 3,
						"mocked": 0,
						"camp-only": 0
					},
					"asserted_against": [
						{ "alias": "api", "fidelity": "simulated" },
						{ "alias": "db", "fidelity": "simulated" }
					],
					"prod_readiness_claimable": false
				}
			}
		},
		{
			"description": "the ephemeral-camp lane without a Yard is refused, never downgraded to in-process",
			"request": {
				"method": "POST",
				"path": "/harness/deploy",
				"body": { "lane": "ephemeral-camp", "stage": "pr-42" }
			},
			"response": {
				"status": 409,
				"body": {
					"code": "HARNESS_YARD_REQUIRED",
					"remediation": "pass an explicit Yard — createTestHarness({ lane: 'ephemeral-camp', yard }) — the lane never falls back to in-process"
				}
			}
		},
		{
			"description": "a deliberate 401 during readiness polling is an answer, not a propagation delay",
			"request": {
				"method": "POST",
				"path": "/harness/until-ready",
				"body": { "target": "http://127.0.0.1:44301/private", "observedStatus": 401 }
			},
			"response": {
				"status": 409,
				"body": {
					"code": "HARNESS_READINESS_REJECTED",
					"remediation": "fix the request (credentials, path, or method) — retrying a 400/401/403 cannot make it succeed"
				}
			}
		},
		{
			"description": "a pasted credential value in place of a brokered locator is refused",
			"request": {
				"method": "POST",
				"path": "/harness/deploy",
				"body": {
					"lane": "ephemeral-camp",
					"stage": "pr-42",
					"yard": { "kind": "yard", "name": "yard:aws", "providerId": "aws" },
					"credentialEnv": "HOBO_TESTING_CAMP_CREDENTIAL_REF"
				}
			},
			"response": {
				"status": 422,
				"body": {
					"code": "HARNESS_CREDENTIAL_NOT_A_REF",
					"remediation": "broker the credential and reference it (vault://, aws-sm://, hobo-secret://, …); a pasted token value is refused by design (ADR-0113)"
				}
			}
		}
	],
	"metadata": { "pactSpecification": { "version": "3.0.0" } }
}
