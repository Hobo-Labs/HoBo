{
  "agent": {
    "mode": "suggest",
    "engines": [
      {
        "id": "primary",
        "kind": "anthropic",
        "model": "claude-sonnet-4-5",
        "credential": "env:ANTHROPIC_API_KEY"
      },
      {
        "id": "fallback",
        "kind": "gateway",
        "model": "openai/gpt-5.1",
        "credential": "env:AI_GATEWAY_API_KEY"
      }
    ],
    "queue": {
      "label": "hobo-queue",
      "maxBatchSize": 4,
      "maxWaitMinutes": 240,
      "priorityLabels": ["hotfix"]
    },
    "resolution": {
      "protectedPaths": ["**/migrations/**", "**/*.generated.*"],
      "minConfidence": 0.8
    },
    "budget": {
      "maxTokensPerDay": 2000000,
      "maxResolutionsPerTick": 2
    }
  }
}
