{
  "pin": "fleet",
  "queue": {
    "maxWaitSeconds": 120,
    "maxQueued": 4
  },
  "labels": {
    "fleet": "hobo",
    "trunk": "hobo-trunk",
    "local": "hobo-local-host",
    "github": "ubuntu-24.04"
  },
  "localRunner": true,
  "mainWorkspaceParallelCap": 4,
  "verdict": {
    "minFreeRunners": 1,
    "enterMs": 60000,
    "exitMs": 30000,
    "stallMs": 600000
  },
  "box": {
    "slots": 2,
    "trunkSlots": 1,
    "trunkLend": 0,
    "prCapWithTrunk": 1,
    "mergeGroupLeases": 1,
    "capacityVolatilityMb": 1024,
    "trunkHeadroomFleetDeferMs": 45000,
    "jobAdmission": "pull"
  },
  "externalPools": [
    {
      "labels": [
        "hobo",
        "hobo-arc"
      ],
      "runnerNamePrefix": "hobo-arc-",
      "maxRunners": 4
    }
  ],
  "retiredVariables": [
    "HOBO_CI_FLEET_ROUTES",
    "HOBO_CI_FLEET_STATE",
    "HOBO_CI_FLEET_CAPACITY",
    "HOBO_CI_ROUTE",
    "HOBO_CI_LOCAL_RUNNER",
    "HOBO_CI_ROUTE_MAX_WAIT_SECONDS",
    "HOBO_CI_ROUTE_MAX_QUEUED",
    "HOBO_CI_TRUNK_RUNNER"
  ]
}
