# Non-secret settings for hobo-cd-agent.service on one runner host.
# The agent's private key (agent.jwk.json) and SVID (agent.svid) sit beside
# this file with mode 0600; neither belongs in it.
HOBO_CD_FEED_URL=https://cd.example.com/v1/cd/
HOBO_CD_RECONCILER_ID=replace-with-the-id-agent-enroll-printed
# hobo-ci-runners/<host id from hosts.json, equal to HOBO_CI_MESH_NODE_ID>
HOBO_CD_CAMP_ID=hobo-ci-runners/box
# What `agent run` is told about this host (from agent.runner-host.json.example):
# with it the runner-host realizer is registered for HOBO_CD_CAMP_ID.
HOBO_CD_RUNNER_HOST=agent.runner-host.json
