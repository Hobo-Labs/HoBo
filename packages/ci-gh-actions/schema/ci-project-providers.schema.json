    },
    "Agent37Pool": {
      "type": "object",
      "properties": {
        "minBoxes": {
          "$ref": "#/$defs/__schema18"
        },
        "maxBoxes": {
          "$ref": "#/$defs/__schema19"
        },
        "type": {
          "$ref": "#/$defs/__schema20"
        },
        "size": {
          "$ref": "#/$defs/Agent37Size"
        },
        "region": {
          "$ref": "#/$defs/__schema27"
        },
        "template": {
          "$ref": "#/$defs/__schema28"
        },
        "idleTtlSeconds": {
          "$ref": "#/$defs/__schema29"
        },
        "jobTimeoutSeconds": {
          "$ref": "#/$defs/__schema30"
        },
        "labels": {
          "$ref": "#/$defs/__schema31"
        },
        "network": {
          "$ref": "#/$defs/__schema32"
        },
        "budget": {
          "$ref": "#/$defs/__schema34"
        },
        "allowAboveFreeTier": {
          "$ref": "#/$defs/__schema35"
        }
      },
      "required": [
        "minBoxes",
        "maxBoxes",
        "type",
        "size",
        "region",
        "template",
        "idleTtlSeconds",
        "jobTimeoutSeconds",
        "labels",
        "network",
        "budget"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "properties": {
              "region": {
                "enum": [
                  "eu",
                  "ap-south"
                ]
              },
              "type": {
                "const": "default"
              }
            },
            "required": [
              "region",
              "type"
            ]
          }
        },
        {
          "not": {
            "properties": {
              "type": {
                "const": "default"
              },
              "size": {
                "properties": {
                  "cpu": {
                    "const": 8
                  }
                },
                "required": [
                  "cpu"
                ]
              }
            },
            "required": [
              "type",
              "size"
            ]
          }
        },
        {
          "anyOf": [
            {
              "properties": {
                "allowAboveFreeTier": {
                  "const": true
                }
              },
              "required": [
                "allowAboveFreeTier"
              ]
            },
            {
              "properties": {
                "size": {
                  "properties": {
                    "memory": {
                      "const": 4
                    }
                  },
                  "required": [
                    "memory"
                  ]
                },
                "maxBoxes": {
                  "maximum": 8
                }
              },
              "required": [
                "size",
                "maxBoxes"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "properties": {
                "allowAboveFreeTier": {
                  "const": true
                }
              },
              "required": [
                "allowAboveFreeTier"
              ]
            },
            {
              "properties": {
                "size": {
                  "properties": {
                    "memory": {
                      "const": 8
                    }
                  },
                  "required": [
                    "memory"
                  ]
                },
                "maxBoxes": {
                  "maximum": 4
                }
              },
              "required": [
                "size",
                "maxBoxes"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "properties": {
                "allowAboveFreeTier": {
                  "const": true
                }
              },
              "required": [
                "allowAboveFreeTier"
              ]
            },
            {
              "properties": {
                "size": {
                  "properties": {
                    "memory": {
                      "const": 16
                    }
                  },
                  "required": [
                    "memory"
                  ]
                },
                "maxBoxes": {
                  "maximum": 2
                }
              },
              "required": [
                "size",
                "maxBoxes"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "properties": {
                "allowAboveFreeTier": {
                  "const": true
                }
              },
              "required": [
                "allowAboveFreeTier"
              ]
            },
            {
              "properties": {
                "size": {
                  "properties": {
                    "memory": {
                      "const": 32
                    }
                  },
                  "required": [
                    "memory"
                  ]
                },
                "maxBoxes": {
                  "maximum": 1
                }
              },
              "required": [
                "size",
                "maxBoxes"
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "properties": {
                "allowAboveFreeTier": {
                  "const": true
                }
              },
              "required": [
                "allowAboveFreeTier"
              ]
            },
            {
              "properties": {
                "size": {
                  "properties": {
                    "memory": {
                      "const": 64
                    }
