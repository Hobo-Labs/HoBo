      "additionalProperties": false
    },
    "KubernetesName": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "__schema14": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
