    {
      "$ref": "#/$defs/BoatProvider"
    },
    {
      "$ref": "#/$defs/LizardProvider"
    },
    {
      "$ref": "#/$defs/KubernetesProvider"
    },
    {
      "$ref": "#/$defs/HoboBoxWorkerProvider"
    },
    {
