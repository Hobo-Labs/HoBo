      "required": [
        "name",
        "maxRunners",
        "namespace"
      ],
      "additionalProperties": false
    },
    "KubernetesName": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "__schema11": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "__schema12": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "__schema13": {
      "$ref": "#/$defs/DaggerEngine"
    },
    "DaggerEngine": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/KubernetesName"
        }
      },
      "required": [
