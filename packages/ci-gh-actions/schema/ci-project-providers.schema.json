    "__schema0": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:/-]{1,200}$"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^(?![Hh][Oo][Bb][Oo]$)[A-Za-z0-9_.-]{1,100}$"
