        }
      },
      "required": [
        "cpu",
        "memory",
        "disk"
      ],
      "additionalProperties": false
    },
    "__schema25": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "number",
          "const": 4
        },
        "memory": {
          "type": "number",
          "const": 32
        },
        "disk": {
          "$ref": "#/$defs/__schema22"
        }
      },
      "required": [
        "cpu",
        "memory",
        "disk"
      ],
      "additionalProperties": false
    },
    "__schema26": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "number",
          "const": 8
        },
        "memory": {
          "type": "number",
          "const": 64
        },
        "disk": {
          "$ref": "#/$defs/__schema22"
        }
      },
      "required": [
        "cpu",
        "memory",
        "disk"
      ],
      "additionalProperties": false
    },
    "__schema27": {
      "type": "string",
      "enum": [
        "us",
        "eu",
        "ap-south"
      ]
    },
    "__schema28": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}@[1-9][0-9]{0,19}$"
    },
    "__schema29": {
      "type": "integer",
      "minimum": 60,
      "maximum": 3600
    },
    "__schema30": {
      "type": "integer",
      "minimum": 1,
      "maximum": 19800
    },
    "__schema31": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      },
      "uniqueItems": true
    },
    "__schema32": {
      "type": "object",
      "properties": {
        "allow": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema33"
          }
        }
      },
      "required": [
        "allow"
      ],
      "additionalProperties": false
    },
    "__schema33": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^(?:\\*\\.)?[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "__schema34": {
      "type": "object",
      "properties": {
        "limitMicros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "period": {
          "type": "string",
          "const": "month"
        },
        "maxCreatesPerHour": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "required": [
        "limitMicros",
        "period",
        "maxCreatesPerHour"
      ],
      "additionalProperties": false
    },
    "__schema35": {
      "type": "boolean"
    }
  },
  "$id": "https://raw.githubusercontent.com/Hobo-Labs/HoBo/main/packages/ci-gh-actions/schema/ci-project-providers.schema.json",
