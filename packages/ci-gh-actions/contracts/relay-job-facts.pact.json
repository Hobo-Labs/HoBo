        "status": 200,
        "body": {
          "sha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "message": "{\"version\":1,\"repository\":\"hobo-fixture/ci-example\",\"issuedAt\":\"2026-11-17T11:59:00.000Z\",\"expiresAt\":\"2026-11-17T12:09:00.000Z\",\"classes\":{\"pr\":{\"runner\":\"hobo\",\"tier\":\"fleet\",\"reason\":\"fleet-open\"},\"fork\":{\"runner\":\"ubuntu-24.04\",\"tier\":\"github\",\"reason\":\"no-capacity\"},\"trunk\":{\"runner\":\"hobo\",\"tier\":\"fleet\",\"reason\":\"fleet-open\"}},\"relay\":{\"nodeId\":\"box-1\",\"commit\":\"abcdef1\"}}"
        }
      }
    },
    {
      "description": "read a missing routing slip ref",
      "providerStates": [
        {
          "name": "no routing slip is published"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/repos/hobo-fixture/ci-example/git/ref/hobo/routing-slip",
        "headers": {
          "Accept": "application/vnd.github+json",
          "Authorization": "Bearer job-token-fixture",
          "X-GitHub-Api-Version": "2022-11-28"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer \\S+$"
                }
              ]
            }
          }
        }
      },
      "response": {
        "status": 404,
        "body": {
          "message": "Not Found"
        }
