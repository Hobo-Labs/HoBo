{
  "consumer": {
    "name": "HoboCiRelayJobFacts"
  },
  "provider": {
    "name": "GithubActionsRestApi"
  },
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    },
    "evidence": "Hand-authored consumer expectations for the reads GithubRouteFacts makes with a job token; field shapes follow the run, job and recorded answers in test/fixtures/relay-job/recorded-queue.json. Mocked transport only; no provider verification.",
    "consumerFixtures": {
      "repository": "hobo-fixture/ci-example",
      "ownRunId": 900,
      "nowMilliseconds": 1794916800000
    }
  },
  "interactions": [
    {
      "description": "read the routing slip ref",
      "providerStates": [
        {
          "name": "a routing slip is published"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/repos/hobo-fixture/ci-example/git/ref/hobo/routing-slip",
        "headers": {
          "Accept": "application/vnd.github+json",
          "Authorization": "Bearer job-token-fixture",
          "X-GitHub-Api-Version": "2022-11-28"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer \\S+$"
                }
              ]
            }
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "ref": "refs/hobo/routing-slip",
          "object": {
            "sha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "type": "commit"
          }
        }
      }
    },
    {
      "description": "read the routing slip commit",
      "providerStates": [
        {
          "name": "a routing slip is published"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/repos/hobo-fixture/ci-example/git/commits/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "headers": {
          "Accept": "application/vnd.github+json",
          "Authorization": "Bearer job-token-fixture",
          "X-GitHub-Api-Version": "2022-11-28"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer \\S+$"
                }
              ]
            }
          }
        }
      },
