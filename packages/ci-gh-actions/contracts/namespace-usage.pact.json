{
  "consumer": { "name": "HoBoCiProviderUsageSync" },
  "provider": { "name": "NamespaceComputeUsageApi" },
  "interactions": [
    {
      "description": "read this month's compute usage",
      "providerState": "the workspace used 40000 unit minutes this month",
      "request": {
        "method": "POST",
        "path": "/namespace.cloud.compute.v1beta.UsageService/GetUsage",
        "headers": { "authorization": "Bearer namespace-usage-token", "content-type": "application/json" },
        "body": { "periodStart": { "year": 2026, "month": 11, "day": 1 }, "periodEnd": { "year": 2026, "month": 11, "day": 17 } }
      },
      "response": {
        "status": 200,
        "body": {
          "total": { "instanceMinutes": { "unit": "40000", "wall": "9000" }, "builds": { "count": "12", "unitMinutes": "300", "wallMinutes": "75" } },
          "perDay": [
            { "year": 2026, "month": 11, "day": 2, "total": { "instanceMinutes": { "unit": "25000", "wall": "6000" } } },
            { "year": 2026, "month": 11, "day": 3, "total": { "instanceMinutes": { "unit": "15000", "wall": "3000" } } }
          ]
        }
      }
    },
    {
      "description": "a token without the usage permission is refused",
      "providerState": "the token may not read usage",
      "request": {
        "method": "POST",
        "path": "/namespace.cloud.compute.v1beta.UsageService/GetUsage",
        "headers": { "authorization": "Bearer namespace-revoked-token", "content-type": "application/json" },
        "body": { "periodStart": { "year": 2026, "month": 11, "day": 1 }, "periodEnd": { "year": 2026, "month": 11, "day": 17 } }
      },
      "response": { "status": 403, "body": { "code": "permission_denied", "message": "permission denied" } }
    }
  ],
  "metadata": { "pactSpecification": { "version": "3.0.0" } }
}
