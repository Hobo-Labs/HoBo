        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "body": {
          "type": "file",
          "path": ".hobo/ci.json",
          "encoding": "base64",
          "content": "eyJyZWxheUpvYnMiOnsiYW5zd2VyIjp0cnVlfSwicnVubmVyT3JkZXIiOnsic3RlcHMiOlt7ImtleSI6ImdpdGh1YiJ9XX19"
        }
      }
    },
