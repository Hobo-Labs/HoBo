        "body": {
          "jsonrpc": "2.0",
          "id": 9,
          "result": {
            "contents": [
              {
                "uri": "hobo-ci://events",
                "mimeType": "application/json",
                "text": "{\"events\":[{\"cursor\":\"2\",\"type\":\"ci.JobQueued\",\"at\":\"2026-10-26T12:00:00Z\",\"leaseId\":\"\",\"state\":\"\",\"repository\":\"org/repo\",\"jobId\":1,\"jobName\":\"\",\"runId\":11,\"runAttempt\":1}],\"cursor\":\"2\",\"timedOut\":false}"
              }
            ]
          }
        }
