{
  "consumer": {
    "name": "McpAgentClient"
  },
  "provider": {
    "name": "HoboCiRelayMcp"
  },
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    },
    "consumerFixtures": {
      "credentials": {
        "reader": "mcp-reader-credential-not-a-real-secret",
        "policyWriter": "mcp-policy-credential-not-a-real-secret"
      },
      "note": "Fixture credentials, bound by the provider test to one test account with policy:read and policy:write. They open nothing outside it."
    }
  },
  "interactions": [
    {
      "description": "refuse a request without account credentials",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "Accept": "application/json, text/event-stream",
          "Content-Type": "application/json"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "ping"
        }
      },
      "response": {
        "status": 401,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json",
          "WWW-Authenticate": "Bearer"
        },
        "body": {
          "error": "account authentication required"
        }
      }
    },
    {
      "description": "refuse a credential that holds neither the read nor the operations scope",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "Accept": "application/json, text/event-stream",
          "Content-Type": "application/json",
          "Authorization": "Bearer mcp-policy-credential-not-a-real-secret"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "ping"
        }
      },
      "response": {
        "status": 403,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json"
        },
        "body": {
          "error": "account scope required"
        }
      }
    },
    {
      "description": "refuse a browser request from another origin",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "Accept": "application/json, text/event-stream",
          "Content-Type": "application/json",
          "Authorization": "Bearer mcp-reader-credential-not-a-real-secret",
          "Origin": "https://attacker.example"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "ping"
        }
      },
      "response": {
        "status": 403,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json"
        },
        "body": {
          "error": "origin not allowed"
        }
      }
    },
    {
      "description": "refuse an event stream on a host that keeps no sessions",
      "request": {
        "method": "GET",
        "path": "/mcp",
        "headers": {
          "Accept": "text/event-stream",
          "Authorization": "Bearer mcp-reader-credential-not-a-real-secret"
        }
      },
      "response": {
        "status": 405,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json",
          "Allow": "POST"
        },
        "body": {
          "error": "method not allowed"
        }
      }
    },
    {
      "description": "initialize without sessions or resource subscriptions",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "Accept": "application/json, text/event-stream",
          "Content-Type": "application/json",
          "Authorization": "Bearer mcp-reader-credential-not-a-real-secret"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 1,
          "method": "initialize",
          "params": {
            "protocolVersion": "2025-06-18",
            "capabilities": {},
            "clientInfo": {
              "name": "contract-client",
              "version": "1.0.0"
            }
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 1,
          "result": {
            "protocolVersion": "2025-06-18",
            "capabilities": {
              "tools": {
                "listChanged": true
              },
              "resources": {
                "listChanged": true
              }
            },
            "serverInfo": {
              "name": "hobo-ci-relay",
              "version": "1.0.0"
            }
          }
        }
      }
    },
    {
      "description": "list the relay's tools",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "Accept": "application/json, text/event-stream",
          "Content-Type": "application/json",
          "Authorization": "Bearer mcp-reader-credential-not-a-real-secret"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 2,
          "method": "tools/list"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 2,
          "result": {
            "tools": [
              {
                "name": "list_leases"
              },
              {
                "name": "get_lease"
              },
              {
                "name": "list_pending_jobs"
              },
              {
                "name": "list_events"
              },
              {
                "name": "wait_for_events"
              },
              {
                "name": "get_relay_status"
              },
              {
                "name": "reconcile_lease"
              },
              {
                "name": "list_quarantined_webhooks"
              },
              {
                "name": "retry_quarantined_webhook"
              }
            ]
          }
        }
      }
    },
    {
      "description": "list the relay's resources",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "Accept": "application/json, text/event-stream",
          "Content-Type": "application/json",
          "Authorization": "Bearer mcp-reader-credential-not-a-real-secret"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 3,
          "method": "resources/list"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 3,
          "result": {
            "resources": [
              {
                "uri": "hobo-ci://leases",
                "name": "leases",
                "mimeType": "application/json"
              },
              {
                "uri": "hobo-ci://events",
                "name": "events",
                "mimeType": "application/json"
              }
            ]
          }
        }
      }
    },
    {
      "description": "read the account's events after a cursor",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "Accept": "application/json, text/event-stream",
          "Content-Type": "application/json",
          "Authorization": "Bearer mcp-reader-credential-not-a-real-secret"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 4,
          "method": "tools/call",
          "params": {
            "name": "list_events",
            "arguments": {
              "cursor": "0"
            }
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 4,
          "result": {
            "content": [
              {
                "type": "text",
                "text": "{\"events\":[{\"cursor\":\"2\",\"type\":\"ci.JobQueued\",\"at\":\"2026-10-26T12:00:00Z\",\"leaseId\":\"\",\"state\":\"\",\"repository\":\"org/repo\",\"jobId\":1,\"jobName\":\"\",\"runId\":11,\"runAttempt\":1}],\"cursor\":\"2\",\"timedOut\":false}"
              }
            ],
            "structuredContent": {
              "events": [
                {
                  "cursor": "2",
                  "type": "ci.JobQueued",
                  "at": "2026-10-26T12:00:00Z",
                  "leaseId": "",
                  "state": "",
                  "repository": "org/repo",
                  "jobId": 1,
                  "jobName": "",
                  "runId": 11,
                  "runAttempt": 1
                }
              ],
              "cursor": "2",
              "timedOut": false
            }
          }
        }
      }
    },
    {
      "description": "end a wait that found no newer event",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "Accept": "application/json, text/event-stream",
          "Content-Type": "application/json",
          "Authorization": "Bearer mcp-reader-credential-not-a-real-secret"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 5,
          "method": "tools/call",
          "params": {
            "name": "wait_for_events",
            "arguments": {
              "cursor": "2",
              "timeoutSeconds": 0
            }
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 5,
          "result": {
            "structuredContent": {
              "events": [],
              "cursor": "2",
              "timedOut": true
            }
          }
        }
      }
    },
    {
      "description": "list the queued job that has no lease",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "Accept": "application/json, text/event-stream",
          "Content-Type": "application/json",
          "Authorization": "Bearer mcp-reader-credential-not-a-real-secret"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 6,
          "method": "tools/call",
          "params": {
            "name": "list_pending_jobs",
            "arguments": {}
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 6,
          "result": {
            "structuredContent": {
              "jobs": [
                {
                  "id": 1,
                  "runId": 11,
                  "runAttempt": 1,
                  "repository": "org/repo",
                  "name": "",
                  "labels": [
                    "hobo"
                  ],
                  "isolatedRequired": false,
                  "memoryClass": "",
                  "queueDeadlineAt": ""
                }
              ],
              "truncated": false
            }
          }
        }
      }
    },
    {
      "description": "report the relay's status and wait limits",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "Accept": "application/json, text/event-stream",
          "Content-Type": "application/json",
          "Authorization": "Bearer mcp-reader-credential-not-a-real-secret"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 7,
          "method": "tools/call",
          "params": {
            "name": "get_relay_status",
            "arguments": {}
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 7,
          "result": {
            "structuredContent": {
              "ready": true,
              "engines": [
                {
                  "id": "gh-actions",
                  "ready": true
                }
              ],
              "subscriptions": false,
              "waitDefaultSeconds": 25,
              "waitMaxSeconds": 50
            }
          }
        }
      }
    },
    {
      "description": "refuse a reconciliation without the operations scope",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "Accept": "application/json, text/event-stream",
          "Content-Type": "application/json",
          "Authorization": "Bearer mcp-reader-credential-not-a-real-secret"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 8,
          "method": "tools/call",
          "params": {
            "name": "reconcile_lease",
            "arguments": {
              "leaseId": "01234567-89ab-4cde-8fab-0123456789ab",
              "hostRunId": 7
            }
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 8,
          "result": {
            "isError": true,
            "content": [
              {
                "type": "text",
                "text": "account scope required: operations:write"
              }
            ]
          }
        }
      }
    },
    {
      "description": "read the events resource",
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "Accept": "application/json, text/event-stream",
          "Content-Type": "application/json",
          "Authorization": "Bearer mcp-reader-credential-not-a-real-secret"
        },
        "body": {
