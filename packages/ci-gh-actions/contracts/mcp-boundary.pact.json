      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "Accept": "application/json, text/event-stream",
          "Content-Type": "application/json",
          "Authorization": "Bearer mcp-reader-credential-not-a-real-secret"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 10,
          "method": "resources/read",
          "params": {
            "uri": "hobo-ci://leases/01234567-89ab-4cde-8fab-0123456789ab"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Cache-Control": "no-store",
          "Content-Type": "application/json"
        },
        "body": {
          "jsonrpc": "2.0",
          "id": 10,
          "error": {
            "code": -32602,
            "message": "MCP error -32602: lease not found"
          }
        }
      }
    }
  ]
}
