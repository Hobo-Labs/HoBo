      "providerState": "acct-a has connected octo/app, whose runner order is machine then github",
      "request": {
        "method": "GET",
        "path": "/v1/accounts/self/runner-order",
        "query": {
          "repository": [
            "octo/app"
          ]
        },
        "headers": {
          "authorization": "Bearer token-a"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "repository": "octo/app",
          "order": {
            "steps": [
              {
                "key": "machine"
              },
              {
                "key": "github"
              }
            ]
          }
        }
      }
    },
