{
  "name": "@hobo/ci-gh-actions",
  "version": "0.0.1",
  "description": "HoBo CI GitHub Actions webhook relay and ephemeral runner providers",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "dist",
    "templates",
    "src/bootstrap.ts",
    "schema"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./project-config": {
      "types": "./dist/project-config.d.ts",
      "default": "./dist/project-config.js"
    },
    "./runner-integrations": {
      "types": "./dist/runner-integrations.d.ts",
      "default": "./dist/runner-integrations.js"
    },
    "./mesh-nats": {
      "types": "./dist/mesh-nats.d.ts",
      "default": "./dist/mesh-nats.js"
    },
    "./cli-serve": {
      "types": "./dist/cli-serve-entry.d.ts",
      "default": "./dist/cli-serve-entry.js"
    },
    "./node-http": {
      "types": "./dist/node-http.d.ts",
      "default": "./dist/node-http.js"
    },
    "./relay-cache": {
      "types": "./dist/relay-cache/index.d.ts",
      "default": "./dist/relay-cache/index.js"
    },
    "./schema/ci-project.schema.json": "./schema/ci-project.schema.json",
    "./schema/ci-project-providers.schema.json": "./schema/ci-project-providers.schema.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "mesh:demo": "node --experimental-strip-types --no-warnings scripts/mesh-demo.mts",
    "mesh:trust": "node --experimental-strip-types --no-warnings scripts/mesh-trust.mts",
    "test": "vitest run",
    "test:deep": "vitest run --config vitest.deep.config.ts",
    "start": "node dist/main.js",
    "test:act": "node --import tsx scripts/act-harness.ts",
    "act:install": "node --import tsx scripts/act-install.ts",
    "local:runner": "node --import tsx scripts/local-runner.ts",
    "test:acceptance": "node --import tsx scripts/acceptance.ts",
    "test:pact": "vitest run contracts/local-runner.pact.test.ts contracts/local-github.pact.test.ts",
    "test:pact:broker": "node --import tsx scripts/pact-broker.ts",
    "pact:can-deploy": "node --import tsx scripts/pact-broker.ts --gate",
    "pact:up": "docker compose --project-name hobo-ci-pact -f contracts/compose.pact.yml up --detach --wait",
    "deploy:check": "node --import tsx scripts/check-deployment.ts",
    "ops": "node dist/ops.js",
    "project": "node dist/project-cli.js",
    "pretest": "node --experimental-strip-types ../../scripts/ensure-built.mts",
    "pretest:acceptance": "node --experimental-strip-types ../../scripts/ensure-built.mts",
    "schema:generate": "node --import tsx scripts/project-schema.ts",
    "schema:check": "node --import tsx scripts/project-schema.ts --check"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@hobo/broker": "workspace:*",
    "@hobo/ci": "workspace:*",
    "@hobo/core": "workspace:*",
    "@hobo/fleet": "workspace:*",
    "@hobo/fleet-agent": "workspace:*",
    "@hobo/fleet-nats": "workspace:*",
    "@hobo/provider-redaction": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/kv": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260730.1",
    "@dagger.io/dagger": "0.21.11",
    "@hobo/ci-cf": "workspace:*",
    "@hobo/ci-dagger": "workspace:*",
    "@hobo/kv-redis-compatible": "workspace:*",
    "@hobo/redaction-test-harness": "workspace:*",
    "@hobo/stations": "workspace:*",
    "@pact-foundation/pact": "17.1.4",
    "@types/pg": "8.15.5",
    "pg": "8.22.0",
    "testcontainers": "11.8.1",
    "yaml": "2.9.0"
  }
}
