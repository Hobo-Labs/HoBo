{
  "name": "@hobo/ci-gh-actions",
  "version": "0.0.1",
  "description": "HoBo CI GitHub Actions webhook relay and ephemeral runner providers",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "dist",
    "templates",
    "src/bootstrap.ts",
    "schema"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./arc-runner-caches": {
      "types": "./dist/arc-runner-caches.d.ts",
      "default": "./dist/arc-runner-caches.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./owner-login": {
      "types": "./dist/relay-owner-login-protocol.d.ts",
      "default": "./dist/relay-owner-login-protocol.js"
    },
    "./project-config": {
      "types": "./dist/project-config.d.ts",
      "default": "./dist/project-config.js"
    },
    "./runner-integrations": {
      "types": "./dist/runner-integrations.d.ts",
      "default": "./dist/runner-integrations.js"
    },
    "./cli-serve": {
      "types": "./dist/cli-serve-entry.d.ts",
      "default": "./dist/cli-serve-entry.js"
    },
    "./node-http": {
      "types": "./dist/node-http.d.ts",
      "default": "./dist/node-http.js"
    },
    "./runner-host": {
      "types": "./dist/runner-host.d.ts",
      "default": "./dist/runner-host.js"
    },
    "./machine-worker": {
      "types": "./dist/machine-worker/index.d.ts",
      "default": "./dist/machine-worker/index.js"
    },
    "./machine-worker/testing": {
      "types": "./dist/machine-worker/testing.d.ts",
      "default": "./dist/machine-worker/testing.js"
    },
    "./machine-worker/macos": {
      "types": "./dist/machine-worker/macos/index.d.ts",
      "default": "./dist/machine-worker/macos/index.js"
    },
    "./relay-cache": {
      "types": "./dist/relay-cache/index.d.ts",
      "default": "./dist/relay-cache/index.js"
    },
    "./relay-checks": {
      "types": "./dist/relay-checks/index.d.ts",
      "default": "./dist/relay-checks/index.js"
    },
    "./schema/ci-project.schema.json": "./schema/ci-project.schema.json",
    "./schema/ci-project-providers.schema.json": "./schema/ci-project-providers.schema.json",
    "./read-api": {
      "types": "./dist/read-api.d.ts",
      "default": "./dist/read-api.js"
    },
    "./schema/read-api.openapi.json": "./schema/read-api.openapi.json",
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./provider-usage": {
      "types": "./dist/provider-usage/index.d.ts",
      "default": "./dist/provider-usage/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.domain-tests.json",
    "lint": "biome check .",
    "test": "vitest run",
    "test:deep": "vitest run --config vitest.deep.config.ts",
    "start": "node dist/main.js",
    "test:act": "node --import tsx scripts/act-harness.ts",
    "act:install": "node --import tsx scripts/act-install.ts",
    "test:acceptance": "node --import tsx scripts/acceptance.ts",
    "test:pact": "vitest run contracts/local-runner.pact.test.ts contracts/local-github.pact.test.ts",
    "test:pact:broker": "node --import tsx scripts/pact-broker.ts",
    "pact:can-deploy": "node --import tsx scripts/pact-broker.ts --gate",
    "pact:up": "docker compose --project-name hobo-ci-pact -f contracts/compose.pact.yml up --detach --wait",
    "deploy:check": "node --import tsx scripts/check-deployment.ts",
    "ops": "node dist/ops.js",
    "project": "node dist/project-cli.js",
    "pretest": "node --experimental-strip-types ../../scripts/ensure-built.mts",
    "pretest:acceptance": "node --experimental-strip-types ../../scripts/ensure-built.mts",
    "schema:generate": "node --import tsx scripts/project-schema.ts",
    "schema:check": "node --import tsx scripts/project-schema.ts --check",
    "release:build": "node --import tsx scripts/build-controller-release.mts"
  },
  "dependencies": {
    "@alchemy.run/domain": "2.0.0-beta.87",
    "@bufbuild/protobuf": "2.12.1",
    "@hobo/bindles": "workspace:*",
    "@hobo/broker": "workspace:*",
    "@hobo/ci": "workspace:*",
    "@hobo/core": "workspace:*",
    "@hobo/fleet": "workspace:*",
    "@hobo/fleet-agent": "workspace:*",
    "@hobo/fleet-nats": "workspace:*",
    "@hobo/provider-redaction": "workspace:*",
    "@hobo/storage-sqlite": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "effect": "4.1.4",
    "yaml": "2.9.0",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "@alchemy.run/rivet": "2.0.0-beta.87",
    "rivetkit": "3.0.0"
  },
  "peerDependenciesMeta": {
    "@alchemy.run/rivet": {
      "optional": true
    },
    "rivetkit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@alchemy.run/rivet": "2.0.0-beta.87",
    "@cloudflare/workers-types": "5.20260730.1",
    "@dagger.io/dagger": "0.21.11",
    "@effect/platform-node": "4.1.4",
    "@hobo/ci-cf": "workspace:*",
    "@hobo/ci-dagger": "workspace:*",
    "@hobo/kv-redis-compatible": "workspace:*",
    "@hobo/redaction-test-harness": "workspace:*",
    "@hobo/stations": "workspace:*",
    "@pact-foundation/pact": "17.1.4",
    "@types/pg": "8.15.5",
    "esbuild": "0.28.1",
    "fast-check": "^4.9.0",
    "pg": "8.22.0",
    "rivetkit": "3.0.0",
    "testcontainers": "11.8.1"
  }
}
