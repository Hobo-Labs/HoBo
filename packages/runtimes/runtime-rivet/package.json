{
	"name": "@hobo/runtime-rivet",
	"version": "0.0.1",
	"license": "MIT",
	"description": "Optional Camp runtime realizing ActorHost over a HoBo-owned actor-local journal. RivetKit is the preferred engine; node:sqlite is the local/oracle driver.",
	"type": "module",
	"private": true,
	"files": [
		"LICENSE",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hobo/core": "workspace:*",
		"@rivetkit/rivetkit-wasm": "3.0.0",
		"rivetkit": "3.0.0"
	},
	"devDependencies": {
		"@hobo/conformance": "workspace:*",
		"@types/node": ">=24.0.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../../scripts/ensure-built.mts",
		"test": "tsc --noEmit -p tsconfig.client-tests.json && vitest run"
	}
}
