{
	"name": "@hobo/broker",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"private": true,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./domain": {
			"types": "./dist/domain/index.d.ts",
			"default": "./dist/domain/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../scripts/ensure-built.mts && tsc --noEmit -p tsconfig.iac-tests.json",
		"test": "vitest run",
		"test:contract:consumer": "vitest run contracts/consumer",
		"test:contract:provider": "vitest run contracts/provider"
	},
	"dependencies": {
		"@alchemy.run/domain": "2.0.0-beta.87",
		"@bufbuild/protobuf": "2.12.1",
		"@hobo/backend-routing": "workspace:*",
		"@hobo/contracts": "workspace:*",
		"@hobo/core": "workspace:*",
		"@hobo/data-core": "workspace:*",
		"@hobo/pricing": "workspace:*",
		"@hobo/provider-cedar": "workspace:*",
		"@hobo/provider-opa": "workspace:*",
		"effect": "4.1.4",
		"pg": "8.22.0",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@hobo/data-postgres": "workspace:*",
		"@hobo/fleet": "workspace:*",
		"@hobo/storage-sqlite": "workspace:*",
		"@types/node": "^22.15.29",
		"@types/pg": "8.15.5",
		"fast-check": "^4.3.0",
		"vitest": "^4.1.9"
	},
	"description": "The HoBo Broker: policy-governed brokering of Bindle/Camp/Yard/Junction placements across providers, wrapping the policy (OPA-shaped), contract (Gatekeeper/PACT), billing, delivery (Argo-shaped), and connector-registry planes."
}
