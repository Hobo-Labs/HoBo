{
  "consumer": { "name": "hobo-pricing-billing-sync-consumer" },
  "provider": { "name": "hobo-pricing-billing-sync-adapter" },
  "metadata": {
    "pactSpecification": { "version": "4.0.0" },
    "transport": "library-call"
  },
  "interactions": [
    {
      "type": "Synchronous/Messages",
      "description": "sync complete FOCUS charges into a dated reconciliation snapshot",
      "request": {
        "contentType": "application/json",
        "contents": {
          "syncAt": "2026-02-01T12:00:00Z",
          "periodStart": "2026-01-01T00:00:00Z",
          "periodEnd": "2026-01-31T23:59:59Z",
          "reservationId": "reservation-pact-1",
          "eventId": "event-pact-1",
          "quotedIncrementalBilled": { "decimal": "1.00", "currency": "USD" },
          "rows": [
            {
              "providerChargeId": "prov-charge-usage-1",
              "agreementId": "agreement-a",
              "chargeId": "overage",
              "chargePeriodStart": "2026-01-01T00:00:00Z",
              "chargePeriodEnd": "2026-01-31T23:59:59Z",
              "billedCostDecimal": "1.50",
              "currency": "USD",
              "category": "usage",
              "completeness": "complete"
            }
          ]
        }
      },
      "response": [
        {
          "contentType": "application/json",
          "contents": {
            "snapshot": {
              "schema": "hobo.pricing.billing-sync.snapshot/v1",
              "hashVersion": 2,
              "syncAt": "2026-02-01T12:00:00Z",
              "completeness": "complete",
              "imported": [{ "id": "prov-charge-usage-1", "billedCost": { "decimal": "1.5", "currency": "USD" } }],
              "variances": [{ "kind": "billed-vs-quoted", "deltaDecimal": "0.5", "currency": "USD" }]
            },
            "reconciliation": {
              "eventId": "event-pact-1",
              "reservationId": "reservation-pact-1",
              "hashVersion": 2,
              "actualCharges": [{ "id": "prov-charge-usage-1" }]
            }
          }
        }
      ]
    },
    {
      "type": "Synchronous/Messages",
      "description": "reject a provider charge in a different currency from the quote",
      "request": {
        "contentType": "application/json",
        "contents": {
          "syncAt": "2026-02-01T12:00:00Z",
          "periodStart": "2026-01-01T00:00:00Z",
          "periodEnd": "2026-01-31T23:59:59Z",
          "reservationId": "reservation-pact-2",
          "eventId": "event-pact-2",
          "quotedIncrementalBilled": { "decimal": "1.00", "currency": "EUR" },
          "rows": [
            {
              "providerChargeId": "prov-charge-usage-2",
              "agreementId": "agreement-a",
              "chargeId": "overage",
              "chargePeriodStart": "2026-01-01T00:00:00Z",
              "chargePeriodEnd": "2026-01-31T23:59:59Z",
              "billedCostDecimal": "1.50",
              "currency": "USD",
              "category": "usage",
              "completeness": "complete"
            }
          ]
        }
      },
      "response": [
        {
          "contentType": "application/json",
          "contents": {
            "code": "CROSS_CURRENCY",
            "message": "actual charge and quote currencies differ"
          }
        }
      ]
    }
  ]
}
