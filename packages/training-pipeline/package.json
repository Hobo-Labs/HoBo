{
	"name": "@hobo/training-pipeline",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"private": true,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../scripts/ensure-built.mts",
		"test": "vitest run",
		"test:contract:consumer": "vitest run test/promotion-gate-pact.test.ts -t 'reads promotion decisions'",
		"test:contract:provider": "vitest run test/promotion-gate-pact.test.ts"
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.12.1",
		"@hobo/core": "workspace:*",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@pact-foundation/pact": "17.1.4",
		"@types/node": "^22.15.3",
		"tsx": "^4.20.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	}
}
