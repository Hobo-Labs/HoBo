{
  "consumer": { "name": "TrainingLoopConsumer" },
  "provider": { "name": "PromotionGateProvider" },
  "metadata": {
    "pactSpecification": { "version": "4.0.0" },
    "transport": "library-call"
  },
  "interactions": [
    {
      "description": "Promote a challenger with enough passing metric samples",
      "type": "Synchronous/Messages",
      "request": { "contents": { "contentType": "application/json", "encoded": false, "content": {
        "candidateId": "candidate-1",
        "conformance": true,
        "policy": true,
        "championId": "champion-1",
        "evalResult": {
          "rubricRef": "rubric://support/classification@1.0.0",
          "scores": { "accuracy": 0.92 },
          "sampleCount": 128,
          "metricSampleCounts": { "accuracy": 128 },
          "source": "live-eval"
        },
        "thresholds": { "metricFloors": { "accuracy": 0.85 }, "minSamples": 100 }
      } } },
      "response": [{ "contents": { "contentType": "application/json", "encoded": false, "content": {
        "candidateId": "candidate-1",
        "outcome": "PROMOTION_OUTCOME_PROMOTE",
        "passed": { "conformance": true, "eval": true, "policy": true }
      } } }]
    },
    {
      "description": "Refuse a challenger whose metric falls below its floor",
      "type": "Synchronous/Messages",
      "request": { "contents": { "contentType": "application/json", "encoded": false, "content": {
        "candidateId": "candidate-2",
        "conformance": true,
        "policy": true,
        "evalResult": {
          "rubricRef": "rubric://support/classification@1.0.0",
          "scores": { "accuracy": 0.71 },
          "sampleCount": 128,
          "metricSampleCounts": { "accuracy": 128 },
          "source": "live-eval"
        },
        "thresholds": { "metricFloors": { "accuracy": 0.85 }, "minSamples": 100 }
      } } },
      "response": [{ "contents": { "contentType": "application/json", "encoded": false, "content": {
        "candidateId": "candidate-2",
        "outcome": "PROMOTION_OUTCOME_REFUSE",
        "passed": { "conformance": true, "eval": false, "policy": true },
        "failures": ["eval: accuracy 0.71 below floor 0.85"]
      } } }]
    },
    {
      "description": "Refuse a metric scored on too few trajectories",
      "type": "Synchronous/Messages",
      "request": { "contents": { "contentType": "application/json", "encoded": false, "content": {
        "candidateId": "candidate-3",
        "conformance": true,
        "policy": true,
        "evalResult": {
          "rubricRef": "rubric://support/classification@1.0.0",
          "scores": { "accuracy": 1 },
          "sampleCount": 128,
          "metricSampleCounts": { "accuracy": 1 },
          "source": "live-eval"
        },
        "thresholds": { "metricFloors": { "accuracy": 0.85 }, "minSamples": 100 }
      } } },
      "response": [{ "contents": { "contentType": "application/json", "encoded": false, "content": {
        "candidateId": "candidate-3",
        "outcome": "PROMOTION_OUTCOME_REFUSE",
        "passed": { "conformance": true, "eval": false, "policy": true },
        "failures": ["eval: metric accuracy has 1 sample below min 100"]
      } } }]
    },
    {
      "description": "Refuse a legacy result without per-metric sample counts",
      "type": "Synchronous/Messages",
      "request": { "contents": { "contentType": "application/json", "encoded": false, "content": {
        "candidateId": "candidate-4",
        "conformance": true,
        "policy": true,
        "evalResult": {
          "rubricRef": "rubric://support/classification@1.0.0",
          "scores": { "accuracy": 1 },
          "sampleCount": 128,
          "source": "live-eval"
        },
        "thresholds": { "metricFloors": { "accuracy": 0.85 }, "minSamples": 100 }
      } } },
      "response": [{ "contents": { "contentType": "application/json", "encoded": false, "content": {
        "candidateId": "candidate-4",
        "outcome": "PROMOTION_OUTCOME_REFUSE",
        "passed": { "conformance": true, "eval": false, "policy": true },
        "failures": ["eval: metric accuracy has no valid sample count"]
      } } }]
    }
  ]
}
