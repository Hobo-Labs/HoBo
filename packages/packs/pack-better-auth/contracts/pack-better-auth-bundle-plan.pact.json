{
	"consumer": { "name": "hobo-auth-bundle-host" },
	"provider": { "name": "hobo-pack-better-auth" },
	"interactions": [
		{
			"description": "planBetterAuthBundle returns a frozen plan when every required port is wired and the signing locator matches config",
			"request": {
				"method": "invoke",
				"path": "planBetterAuthBundle",
				"body": {
					"configInput": {
						"basePath": "/api/auth",
						"secretRef": "hobo-secret://tenant-1/auth/better-auth-signing",
						"database": { "profile": "data.relational/v1" }
					},
					"ports": {
						"relationalBindle": "auth-db",
						"httpBindle": "auth-api",
						"signingSecretRef": "hobo-secret://tenant-1/auth/better-auth-signing"
					},
					"options": { "forExecution": false }
				}
			},
			"response": {
				"status": 200,
				"body": {
					"packId": "pack.better-auth/v1",
					"descriptorId": "better-auth",
					"claimsMappingVersion": "better-auth-claims/v1",
					"routePattern": "/api/auth/*"
				}
			}
		},
		{
			"description": "planBetterAuthBundle refuses a signing locator mismatch on the bundle ports",
			"request": {
				"method": "invoke",
				"path": "planBetterAuthBundle",
				"body": {
					"configInput": {
						"basePath": "/api/auth",
						"secretRef": "hobo-secret://tenant-1/auth/better-auth-signing",
						"database": { "profile": "data.relational/v1" }
					},
					"ports": {
						"relationalBindle": "auth-db",
						"httpBindle": "auth-api",
						"signingSecretRef": "hobo-secret://tenant-1/auth/other-signing"
					}
				}
			},
			"response": {
				"status": 422,
				"body": { "code": "BETTER_AUTH_BUNDLE_PORT_INVALID" }
			}
		}
	]
}