{
	"consumer": { "name": "hobo-pack-better-auth" },
	"provider": { "name": "hobo-camp-secrets-port" },
	"interactions": [
		{
			"description": "bundle init resolves a deposited signing secret by locator without returning material",
			"request": {
				"method": "POST",
				"path": "/auth/bundles/signing-secret/wire",
				"body": {
					"secretRef": "hobo-secret://camp-prod/auth/better-auth-signing-key",
					"secretsPortKind": "memory-fixture"
				}
			},
			"response": {
				"status": 200,
				"body": {
					"secretRef": "hobo-secret://camp-prod/auth/better-auth-signing-key",
					"secretScheme": "hobo-secret"
				}
			}
		},
		{
			"description": "bundle init refuses when custody does not hold the locator",
			"request": {
				"method": "POST",
				"path": "/auth/bundles/signing-secret/wire",
				"body": {
					"secretRef": "hobo-secret://camp-prod/auth/missing-signing-key"
				}
			},
			"response": {
				"status": 422,
				"body": {
					"code": "BETTER_AUTH_SIGNING_SECRET_UNRESOLVED"
				}
			}
		}
	]
}