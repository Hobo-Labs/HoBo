{
	"name": "@hobo/pack-better-auth",
	"version": "0.0.1",
	"license": "MIT",
	"description": "Better Auth as a HoBo implementation pack: plans the self-hosted hobo:auth bundle over relational storage, brokered signing secret, and HTTP route mount; fails closed without the better-auth runtime.",
	"type": "module",
	"files": [
		"LICENSE",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hobo/auth-adapter-contract": "workspace:*",
		"@hobo/bindings": "workspace:*",
		"@hobo/core": "workspace:*",
		"@hobo/identity": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.15.29",
		"vitest": "^4.1.9"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"typecheck:test": "tsc -p tsconfig.test.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../../scripts/ensure-built.mts",
		"test": "vitest run test/",
		"test:unit": "vitest run test/"
	}
}