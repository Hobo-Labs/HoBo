{
	"name": "@hobo/stations",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"files": [
		"LICENSE",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./domain": {
			"types": "./dist/domain/index.d.ts",
			"default": "./dist/domain/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@alchemy.run/domain": "2.0.0-beta.87",
		"@bufbuild/protobuf": "2.12.1",
		"@hobo/ci": "workspace:*",
		"@hobo/bindles": "workspace:*",
		"@hobo/connectivity": "workspace:*",
		"@hobo/core": "workspace:*",
		"@hobo/dispatcher": "workspace:*",
		"@hobo/contracts": "workspace:*",
		"effect": "4.1.4"
	},
	"devDependencies": {
		"@types/node": "^22.15.29",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.domain-tests.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../scripts/ensure-built.mts",
		"test": "vitest run"
	}
}
