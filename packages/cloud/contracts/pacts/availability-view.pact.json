{
  "consumer": { "name": "AvailabilityViewClient" },
  "provider": { "name": "CloudAvailabilityView" },
  "metadata": { "pactSpecification": { "version": "3.0.0" } },
  "interactions": [
    {
      "description": "Estimate an API and its database with an unmet availability target",
      "request": {
        "method": "POST",
        "path": "/availability-view",
        "body": {
          "graph": {
            "root": "api",
            "nodes": {
              "api": { "availability": 0.99, "dependsOn": ["db"] },
              "db": { "availability": 0.98 }
            }
          },
          "observedAvailability": 0.96,
          "availabilitySlo": 0.98
        }
      },
      "response": {
        "status": 200,
        "body": {
          "schema": "hobo.availability-view/v1",
          "status": "estimated",
          "estimatedAvailability": 0.9702,
          "estimatedDowntimeMinutesPerYear": 15662.88,
          "summary": {
            "estimated": "97.020%",
            "observed": "96.000%",
            "estimateObservedGap": "1.020%"
          },
          "canDeploy": {
            "effect": "warn",
            "warnings": [{ "code": "availability-floor-unmet", "hardGate": false }]
          },
          "breakdown": {
            "byNode": {
              "api": { "type": "component", "availability": 0.9702 },
              "db": { "type": "component", "availability": 0.98 }
            },
            "countedNodes": ["api", "db"]
          }
        }
      }
    },
    {
      "description": "Report a missing dependency without an estimate",
      "request": {
        "method": "POST",
        "path": "/availability-view",
        "body": {
          "graph": {
            "root": "api",
            "nodes": { "api": { "availability": 0.99, "dependsOn": ["missing"] } }
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "schema": "hobo.availability-view/v1",
          "status": "invalid-graph",
          "estimatedAvailability": null,
          "errors": [{ "code": "missing-node" }],
          "canDeploy": { "effect": "warn" }
        }
      }
    }
  ]
}
