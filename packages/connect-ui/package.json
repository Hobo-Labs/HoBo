{
	"name": "@hobo/connect-ui",
	"version": "0.0.1",
	"license": "MIT",
	"private": true,
	"description": "Provider-connection ceremonies for HoBo lifecycles (hobo ci up, hobo cd up, hobo up): each step of a flow is generated as exactly the component it needs and rendered with vercel-labs/ui (UI SDK) on a loopback page, agent-ready through createAgent and WebMCP; every action is a transition the flow on the server decides.",
	"type": "module",
	"files": [
		"LICENSE",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"hobo": {
		"webUi": true
	},
	"dependencies": {
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@types/node": "^22.15.29",
		"@types/react": "19.2.2",
		"@types/react-dom": "19.2.2",
		"@ui-sdk/core": "0.1.0-beta.2",
		"@ui-sdk/react": "0.1.0-beta.2",
		"esbuild": "0.25.12",
		"jsdom": "26.1.0",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"vitest": "^4.1.9"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../scripts/ensure-built.mts",
		"test": "vitest run test/"
	}
}
