{
	"name": "@hobo/ci-dashboard",
	"version": "0.0.1",
	"license": "MIT",
	"private": true,
	"description": "The HoBo CI relay dashboard: a read-only page over the relay's read API with Runners, Router, History, Performance and Signals views, a what-if panel that walks the runner order in the browser, and an edit link that changes .hobo/ci.json through a pull request.",
	"type": "module",
	"files": [
		"LICENSE",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"hobo": {
		"webUi": true
	},
	"dependencies": {
		"@hobo/ci": "workspace:*",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@types/node": "^22.15.29",
		"@types/pngjs": "^6.0.5",
		"esbuild": "0.28.1",
		"pixelmatch": "^7.2.0",
		"playwright": "^1.62.1",
		"pngjs": "^7.0.0",
		"vitest": "^4.1.9"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../scripts/ensure-built.mts",
		"test": "vitest run test/",
		"test:unit": "vitest run test/"
	}
}
