{
  "name": "@hobo/ci",
  "version": "0.0.1",
  "description": "HoBo CI account-scoped allocation routing and durable lease contracts",
  "license": "MIT",
  "type": "module",
  "publishConfig": { "access": "public" },
  "files": [
    "LICENSE",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./execution": {
      "types": "./dist/execution.d.ts",
      "default": "./dist/execution.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler.d.ts",
      "default": "./dist/scheduler.js"
    },
    "./postgres": {
      "types": "./dist/postgres-store.d.ts",
      "default": "./dist/postgres-store.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite-store.d.ts",
      "default": "./dist/sqlite-store.js"
    },
    "./fleet-v2": {
      "types": "./dist/fleet-v2/index.d.ts",
      "default": "./dist/fleet-v2/index.js"
    },
    "./mesh": {
      "types": "./dist/mesh/index.d.ts",
      "default": "./dist/mesh/index.js"
    },
    "./workspace-backend": {
      "types": "./dist/workspace-backend.d.ts",
      "default": "./dist/workspace-backend.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.db.json",
    "lint": "biome check .",
    "test": "vitest run",
    "db:generate": "node --import tsx db/tooling/cli.mts generate",
    "db:check": "node --import tsx db/tooling/cli.mts check",
    "db:migrate": "node --import tsx db/tooling/cli.mts migrate",
    "db:verify": "node --import tsx db/tooling/cli.mts verify"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.1",
    "@hobo/core": "workspace:*",
    "@hobo/broker": "workspace:*",
    "@hobo/dispatcher": "workspace:*",
    "@hobo/pricing": "workspace:*",
    "pg": "8.22.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@hobo/adapter-drizzle": "workspace:*",
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "testcontainers": "11.8.1"
  }
}
