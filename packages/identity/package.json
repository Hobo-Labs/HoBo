{
	"name": "@hobo/identity",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"files": [
		"LICENSE",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@hobo/core": "workspace:*",
		"@hobo/fleet": "workspace:*"
	},
	"devDependencies": {
		"fast-check": "^4.3.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc -p test/tsconfig.types.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../scripts/ensure-built.mts && tsc -p test/tsconfig.types.json",
		"test": "vitest run",
		"test:contract:consumer": "vitest run contracts/consumer"
	}
}
