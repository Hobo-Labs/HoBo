{
	"name": "@hobo/provider-upstash",
	"version": "0.0.1",
	"license": "MIT",
	"description": "Upstash temporary Redis provider and scoped, budget-aware private Blob credential and pricing primitives.",
	"type": "module",
	"files": [
		"LICENSE",
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.12.1",
		"@hobo/backend-fleet": "workspace:*",
		"@hobo/bindings": "workspace:*",
		"@hobo/capability-profiles": "workspace:*",
		"@hobo/core": "workspace:*",
		"@hobo/kv-redis-compatible": "workspace:*",
		"@hobo/provider-redaction": "workspace:*",
		"@hobo/r2-object": "workspace:*",
		"zod": "^4.1.13"
	},
	"devDependencies": {
		"@hobo/redaction-test-harness": "workspace:*",
		"@types/node": "^22.15.29",
		"vitest": "^4.1.9"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../../scripts/ensure-built.mts",
		"test": "vitest run test/",
		"test:deep": "vitest run --config vitest.deep.config.ts",
		"test:unit": "vitest run test/"
	}
}
