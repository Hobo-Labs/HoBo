						{
							"path": "index.html",
							"mode": "100644",
							"type": "blob",
							"sha": "f4bbc8a39e23e1ae2c3da100a1e408144f1d7fd8"
						},
						{
							"path": "assets",
							"mode": "040000",
							"type": "tree",
							"sha": "a34baa5134bac49a4daef6dcd8894080ff91269e"
						},
						{
							"path": "assets/site.css",
							"mode": "100644",
							"type": "blob",
							"sha": "c0e1a88a7f8eff05767c7a1706cfd6583a1ed2a8"
						}
					],
					"truncated": false
				}
			}
		},
