			"providerState": "the blob exists",
			"request": {
				"method": "GET",
				"path": "/repos/hobo-fixtures/site/git/blobs/{sha}",
				"headers": {
					"accept": "application/vnd.github+json",
					"authorization": "Bearer <github-token>",
					"x-github-api-version": "2022-11-28"
