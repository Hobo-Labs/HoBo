			},
			"response": {
				"status": 200,
				"body": {
					"sha": "86c62fea9b239222d371e6fea2018259d6844c99",
					"size": 13,
					"encoding": "base64",
					"content": "<base64 file bytes>"
				}
			}
		},
		{
			"description": "fast-forward the publishing branch (force: false)",
			"providerState": "the head has not moved since it was observed",
			"request": {
				"method": "PATCH",
				"path": "/repos/hobo-fixtures/site/git/refs/heads/gh-pages",
				"headers": {
