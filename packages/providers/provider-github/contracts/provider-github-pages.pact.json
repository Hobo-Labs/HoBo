{
	"consumer": {
		"name": "HoBoCdReconciler"
	},
	"provider": {
		"name": "GitHubRestApi"
	},
	"metadata": {
		"pactSpecification": {
			"version": "3.0.0"
		},
		"provenance": "Consumer expectations (plan 0024, HoBo.CD GitHub Pages realizer) against the GitHub REST API (X-GitHub-Api-Version 2022-11-28): repository read, Pages site read/delete, Pages builds, the Git Data API (blobs, trees, commits, refs), Actions artifacts and Pages deployments, as documented at docs.github.com/rest. Recorded from the offline world in test/support/world.ts by HOBO_PACT_RECORD=1; not provider-verified or captured live traffic. Git object ids are real: blob and tree ids are what git computes for the fixture site.",
		"matching": "Requests match on method, templated path ({sha}, {deployment_id}, {artifact_id}), query, the top-level request-body key set and the response status; response bodies are served verbatim by the offline world. File bytes and the OIDC token are placeholders."
	},
	"interactions": [
		{
			"description": "read the repository and the credential's permissions",
			"providerState": "the repository exists and the token can read it",
			"request": {
				"method": "GET",
				"path": "/repos/hobo-fixtures/site",
				"headers": {
					"accept": "application/vnd.github+json",
					"authorization": "Bearer <github-token>",
					"x-github-api-version": "2022-11-28"
				}
			},
			"response": {
				"status": 200,
				"body": {
					"full_name": "hobo-fixtures/site",
					"permissions": {
						"admin": false,
						"push": true,
						"pull": true
					}
				}
			}
		},
		{
			"description": "read the Pages site configuration",
			"providerState": "Pages is enabled",
			"request": {
				"method": "GET",
				"path": "/repos/hobo-fixtures/site/pages",
				"headers": {
					"accept": "application/vnd.github+json",
					"authorization": "Bearer <github-token>",
					"x-github-api-version": "2022-11-28"
				}
			},
			"response": {
				"status": 200,
				"body": {
					"status": "built",
					"build_type": "legacy",
					"source": {
						"branch": "gh-pages",
						"path": "/"
					},
					"html_url": "https://hobo-fixtures.github.io/site/"
				}
			}
		},
		{
			"description": "observe a publishing branch that does not exist",
			"providerState": "the publishing branch is absent",
			"request": {
				"method": "GET",
				"path": "/repos/hobo-fixtures/site/git/ref/heads/gh-pages",
				"headers": {
					"accept": "application/vnd.github+json",
					"authorization": "Bearer <github-token>",
					"x-github-api-version": "2022-11-28"
				}
			},
			"response": {
				"status": 404,
				"body": {
					"message": "Not Found"
				}
			}
		},
		{
			"description": "upload one site file as a base64 blob",
			"providerState": "the blob is content-addressed",
			"request": {
				"method": "POST",
				"path": "/repos/hobo-fixtures/site/git/blobs",
				"headers": {
					"accept": "application/vnd.github+json",
					"authorization": "Bearer <github-token>",
					"x-github-api-version": "2022-11-28",
					"content-type": "application/json"
				},
				"body": {
					"content": "<base64 file bytes>",
					"encoding": "base64"
				}
			},
			"response": {
				"status": 201,
				"body": {
					"sha": "c0e1a88a7f8eff05767c7a1706cfd6583a1ed2a8",
					"url": "https://api.github.com/repos/hobo-fixtures/site/git/blobs/c0e1a88a7f8eff05767c7a1706cfd6583a1ed2a8"
				}
			}
		},
		{
			"description": "create the site tree from flat paths",
			"providerState": "every blob exists",
			"request": {
				"method": "POST",
				"path": "/repos/hobo-fixtures/site/git/trees",
				"headers": {
					"accept": "application/vnd.github+json",
					"authorization": "Bearer <github-token>",
					"x-github-api-version": "2022-11-28",
					"content-type": "application/json"
				},
				"body": {
					"tree": [
						{
							"path": "assets/site.css",
							"mode": "100644",
							"type": "blob",
							"sha": "c0e1a88a7f8eff05767c7a1706cfd6583a1ed2a8"
						},
						{
							"path": "index.html",
							"mode": "100644",
							"type": "blob",
							"sha": "f4bbc8a39e23e1ae2c3da100a1e408144f1d7fd8"
						}
					]
				}
			},
			"response": {
				"status": 201,
				"body": {
					"sha": "a0c9daf45e98407cb437743cec9e0da25c7744fa",
					"tree": [],
					"truncated": false
				}
			}
		},
		{
			"description": "create a commit whose parent is the observed head",
			"providerState": "the tree exists",
			"request": {
				"method": "POST",
				"path": "/repos/hobo-fixtures/site/git/commits",
				"headers": {
					"accept": "application/vnd.github+json",
					"authorization": "Bearer <github-token>",
					"x-github-api-version": "2022-11-28",
					"content-type": "application/json"
				},
				"body": {
					"message": "Publish sha256:3ff25bdd1dac37190060494768953fde86eca6aa69bb7d02976c06edcb8130e2 (HoBo.CD)",
					"tree": "a0c9daf45e98407cb437743cec9e0da25c7744fa",
					"parents": []
				}
			},
			"response": {
				"status": 201,
				"body": {
					"sha": "35c00edfa4d0ffdfffc33ca95876aa0a6849c1c9",
					"tree": {
						"sha": "a0c9daf45e98407cb437743cec9e0da25c7744fa"
					},
					"parents": []
				}
			}
		},
		{
			"description": "create the publishing branch at the new commit",
			"providerState": "the publishing branch is absent",
			"request": {
				"method": "POST",
				"path": "/repos/hobo-fixtures/site/git/refs",
				"headers": {
					"accept": "application/vnd.github+json",
					"authorization": "Bearer <github-token>",
					"x-github-api-version": "2022-11-28",
					"content-type": "application/json"
				},
				"body": {
					"ref": "refs/heads/gh-pages",
					"sha": "35c00edfa4d0ffdfffc33ca95876aa0a6849c1c9"
				}
			},
			"response": {
				"status": 201,
				"body": {
					"ref": "refs/heads/gh-pages",
					"object": {
						"type": "commit",
						"sha": "35c00edfa4d0ffdfffc33ca95876aa0a6849c1c9"
					}
				}
			}
		},
		{
			"description": "observe the publishing branch head",
			"providerState": "the publishing branch exists",
			"request": {
				"method": "GET",
				"path": "/repos/hobo-fixtures/site/git/ref/heads/gh-pages",
				"headers": {
					"accept": "application/vnd.github+json",
					"authorization": "Bearer <github-token>",
					"x-github-api-version": "2022-11-28"
				}
			},
			"response": {
				"status": 200,
				"body": {
					"ref": "refs/heads/gh-pages",
					"object": {
						"type": "commit",
						"sha": "35c00edfa4d0ffdfffc33ca95876aa0a6849c1c9"
					}
				}
			}
		},
		{
			"description": "read the head commit's tree",
			"providerState": "the head commit exists",
			"request": {
				"method": "GET",
				"path": "/repos/hobo-fixtures/site/git/commits/{sha}",
				"headers": {
					"accept": "application/vnd.github+json",
					"authorization": "Bearer <github-token>",
					"x-github-api-version": "2022-11-28"
