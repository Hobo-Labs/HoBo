				}
			}
		},
		{
			"description": "observe the latest Pages build and its commit",
			"providerState": "a Pages build exists",
			"request": {
				"method": "GET",
				"path": "/repos/hobo-fixtures/site/pages/builds/latest",
				"headers": {
