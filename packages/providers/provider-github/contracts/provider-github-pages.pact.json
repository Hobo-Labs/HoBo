				"status": 200,
				"body": {
					"status": "queued",
					"commit": "35c00edfa4d0ffdfffc33ca95876aa0a6849c1c9",
					"error": {
						"message": null
					}
				}
			}
		},
		{
			"description": "list the published tree's blobs recursively",
			"providerState": "the published tree exists",
			"request": {
				"method": "GET",
				"path": "/repos/hobo-fixtures/site/git/trees/{sha}",
				"query": "recursive=1",
				"headers": {
					"accept": "application/vnd.github+json",
					"authorization": "Bearer <github-token>",
					"x-github-api-version": "2022-11-28"
				}
			},
			"response": {
				"status": 200,
				"body": {
					"sha": "a0c9daf45e98407cb437743cec9e0da25c7744fa",
