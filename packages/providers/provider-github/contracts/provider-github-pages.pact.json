					"tree": {
						"sha": "a0c9daf45e98407cb437743cec9e0da25c7744fa"
					},
					"message": "Publish sha256:3ff25bdd1dac37190060494768953fde86eca6aa69bb7d02976c06edcb8130e2 (HoBo.CD)"
				}
			}
		},
		{
			"description": "observe that no Pages build exists yet",
			"providerState": "Pages has never built",
			"request": {
				"method": "GET",
				"path": "/repos/hobo-fixtures/site/pages/builds/latest",
				"headers": {
					"accept": "application/vnd.github+json",
					"authorization": "Bearer <github-token>",
					"x-github-api-version": "2022-11-28"
				}
			},
			"response": {
				"status": 404,
				"body": {
					"message": "Not Found"
				}
			}
		},
		{
			"description": "request a Pages build of the published head",
			"providerState": "the published head has no build",
			"request": {
				"method": "POST",
				"path": "/repos/hobo-fixtures/site/pages/builds",
				"headers": {
					"accept": "application/vnd.github+json",
					"authorization": "Bearer <github-token>",
					"x-github-api-version": "2022-11-28"
