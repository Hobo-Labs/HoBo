{
	"name": "@hobo/provider-aws",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"private": true,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../../scripts/ensure-built.mts",
		"test": "vitest run",
		"test:deep": "vitest run --config vitest.deep.config.ts"
	},
	"dependencies": {
		"@hobo/core": "workspace:*",
		"@hobo/provider-redaction": "workspace:*"
	},
	"devDependencies": {
		"@hobo/redaction-test-harness": "workspace:*"
	},
	"description": "HoBo AWS CloudProvider: RDS/S3/Fargate/SQS/ElastiCache/DynamoDB behind the agnostic ports (HOBO-711)."
}
