{
	"consumer": { "name": "ProviderAgent37Client" },
	"provider": { "name": "Agent37SandboxApiFake" },
	"interactions": [
		{
			"description": "client creates a vm runner box",
			"request": {
				"method": "POST",
				"path": "/v1/instances",
				"headers": {
					"Content-Type": "application/json",
					"Authorization": "Bearer <runtime-api-key>"
				},
				"body": {
					"template": "agent37-ubuntu",
					"type": "vm",
					"region": "us",
					"resources": { "cpu": 2, "memory": 4, "disk": 20 },
					"name": "hobo-a37-fixture",
					"metadata": { "hobo": "ci" },
					"env": { "HOBO_LEASE_ID": "lease-fixture" }
				}
			},
			"response": {
				"status": 201,
				"body": {
					"id": "i_fixture0001",
					"name": "hobo-a37-fixture",
					"template": "agent37-ubuntu",
					"type": "vm",
					"region": "us",
					"resources": { "cpu": 2, "memory": 4, "disk": 20 },
					"status": "running",
					"metadata": { "hobo": "ci" },
					"auto_sleep": false,
					"idle_timeout_seconds": 3600,
					"public_ports": [],
					"network": "allow-all",
					"created_at": "2026-11-20T00:00:00.000Z",
					"updated_at": "2026-11-20T00:00:00.000Z"
				}
			}
		},
		{
			"description": "client runs a named synchronous exec on the sandbox plane",
			"request": {
				"method": "POST",
				"path": "/v1/instances/i_fixture0001/exec",
				"headers": {
					"Content-Type": "application/json",
					"X-Agent37-Key": "<runtime-api-key>"
				},
				"body": { "command": "echo ready", "user": "root", "name": "prep-lease-fixture" }
			},
			"response": {
				"status": 200,
				"body": {
					"id": "ex_fixture01",
					"instance_id": "i_fixture0001",
					"background": false,
					"status": "completed",
					"exit_code": 0,
					"stdout": "ready\n",
					"stderr": "",
					"created_at": "2026-11-20T00:00:01.000Z",
					"finished_at": "2026-11-20T00:00:01.000Z"
				}
			}
		},
		{
			"description": "wrong sandbox key is refused",
			"request": {
				"method": "POST",
				"path": "/v1/instances/i_fixture0001/exec",
				"headers": { "Content-Type": "application/json", "X-Agent37-Key": "<wrong-runtime-api-key>" },
				"body": { "command": "echo must-not-run", "user": "root" }
			},
			"response": {
				"status": 401,
				"body": { "error": { "code": "unauthorized", "message": "missing or invalid X-Agent37-Key header" } }
			}
		},
		{
			"description": "wrong bearer key is refused",
			"request": {
				"method": "GET",
				"path": "/v1/instances",
				"headers": { "Authorization": "Bearer <wrong-runtime-api-key>" }
			},
			"response": {
				"status": 401,
				"body": { "error": { "code": "unauthorized", "message": "missing or invalid Authorization bearer key" } }
			}
		},
		{
			"description": "client reads a bounded usage window",
			"request": {
				"method": "GET",
				"path": "/v1/usage",
				"query": "from=2026-11-01&to=2026-11-20",
				"headers": { "Authorization": "Bearer <runtime-api-key>" }
			},
			"response": {
				"status": 200,
				"body": { "from": "2026-11-01", "to": "2026-11-20", "total_micros": 0 }
			}
		}
	],
	"metadata": { "pactSpecification": { "version": "3.0.0" } }
}
