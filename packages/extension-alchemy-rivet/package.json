{
	"name": "@hobo/alchemy-rivet",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"files": ["LICENSE", "dist"],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./http-topic-bus": {
			"types": "./dist/rivet-http-topic-bus.d.ts",
			"default": "./dist/rivet-http-topic-bus.js"
		}
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.12.1",
		"@hobo/iac-alchemy": "workspace:*",
		"@hobo/runtime": "workspace:*",
		"@hobo/runtime-rivet": "workspace:*"
	},
	"peerDependencies": {
		"@alchemy.run/rivet": "2.0.0-beta.87",
		"alchemy": "2.0.0-beta.87",
		"effect": "^4.1.4",
		"rivetkit": "3.0.0"
	},
	"devDependencies": {
		"@alchemy.run/rivet": "2.0.0-beta.87",
		"@hobo/core": "workspace:*",
		"@types/node": "^24.13.2",
		"alchemy": "2.0.0-beta.87",
		"effect": "4.1.4",
		"rivetkit": "3.0.0",
		"tsx": "^4.20.3",
		"vitest": "^4.1.9",
		"ws": "8.21.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../scripts/ensure-built.mts && tsc --noEmit -p tsconfig.http-bus-tests.json",
		"test": "vitest run"
	}
}
