{
	"name": "@hobo/cd-argocd",
	"version": "0.0.1",
	"description": "HoBo CD Argo CD control plane: observe and sync Applications (Kargo argocd-update parity)",
	"license": "MIT",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"LICENSE",
		"dist"
	],
