{
	"name": "@hobo/wit",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"files": [
		"LICENSE",
		"dist",
		"src/generated",
		"wit",
		"wit-lock.json"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./wasi-keyvalue-store": {
			"types": "./src/generated/local-services/interfaces/wasi-keyvalue-store.d.ts"
		},
		"./wasi-blobstore": {
			"types": "./src/generated/local-services/interfaces/wasi-blobstore-blobstore.d.ts"
		},
		"./runtime-primitives": {
			"types": "./src/generated/runtime-primitives/interfaces/hobo-runtime-types.d.ts"
		},
		"./durable-messaging": {
			"types": "./src/generated/durable-messaging-guest/interfaces/hobo-durable-messaging-messaging.d.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"codegen": "tsx scripts/generate-bindings.ts",
		"wit:gen": "tsx scripts/generate-bindings.ts",
		"wit:check": "tsx scripts/generate-bindings.ts --check",
		"roundtrip": "tsx bin/reverse-extract.ts --wit wit/hobo-sdk.wit --artifact fixtures/golden-component.imports-exports.json",
		"test": "vitest run"
	},
	"devDependencies": {
		"@bytecodealliance/jco": "1.24.3",
		"@bytecodealliance/jco-transpile": "0.24.0",
		"@types/node": "^22.15.29",
		"componentize-qjs": "0.5.0",
		"tsx": "^4.20.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	}
}
