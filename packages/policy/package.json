{
	"name": "@hobo/policy",
	"version": "0.0.1",
	"license": "MIT",
	"type": "module",
	"files": [
		"LICENSE",
		"dist",
		"wit"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./guardrails": {
			"types": "./dist/agent-guardrails.d.ts",
			"default": "./dist/agent-guardrails.js"
		},
		"./posture": {
			"types": "./dist/posture/index.d.ts",
			"default": "./dist/posture/index.js"
		},
		"./wit/world.wit": "./wit/world.wit"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.12.1"
	},
	"devDependencies": {
		"@bytecodealliance/jco": "1.24.3",
		"@types/node": "^22.15.29",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../scripts/ensure-built.mts",
		"test": "vitest run",
		"test:contract:consumer": "vitest run contracts/consumer"
	}
}
