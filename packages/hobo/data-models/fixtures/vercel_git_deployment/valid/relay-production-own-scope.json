{
  "schemaVersion": "hobo.vercel-git-deployment-plan/v1",
  "bindle": "hobo-ci-relay",
  "resources": [
    {
      "kind": "queue",
      "name": "hobo-ci"
    },
    {
      "kind": "schedule",
      "name": "hobo-ci-repair"
    },
    {
      "kind": "api",
      "name": "relay"
    },
    {
      "kind": "secret",
      "name": "secrets"
    },
    {
      "kind": "data",
      "name": "state"
    }
  ],
  "project": "hobo-ci",
  "scope": "token-default",
  "target": "production",
  "gitSource": {
    "type": "github",
    "org": "example",
    "repo": "hobo",
    "ref": "main",
    "sha": "0123456789abcdef0123456789abcdef01234567",
    "rootDirectory": "packages/ci-vercel"
  },
  "createMissingProject": true,
  "operatorSecrets": [
    "CRON_SECRET",
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "HOBO_CI_BOOTSTRAP_TOKEN_SHA256",
    "HOBO_CI_CONFIG_JSON",
    "HOBO_CI_CONTROL_TOKENS_JSON",
    "HOBO_CI_GITHUB_APP_CLIENT_SECRET",
    "HOBO_CI_GITHUB_APP_PRIVATE_KEY",
    "HOBO_CI_ONBOARDING_CONTROL_TOKEN",
    "HOBO_CI_SESSION_KEY",
    "HOBO_CI_WEBHOOK_SECRET"
  ],
  "requests": [
    {
      "method": "POST",
      "path": "/v13/deployments",
      "body": "{\"name\":\"hobo-ci\",\"project\":\"hobo-ci\",\"gitSource\":{\"type\":\"github\",\"org\":\"example\",\"repo\":\"hobo\",\"ref\":\"main\",\"sha\":\"0123456789abcdef0123456789abcdef01234567\"},\"target\":\"production\",\"projectSettings\":{\"rootDirectory\":\"packages/ci-vercel\"}}",
      "when": "always: one deployment, built by Vercel from the commit"
    }
  ]
}
