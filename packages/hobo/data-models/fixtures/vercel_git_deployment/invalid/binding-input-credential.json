{
  "schemaVersion": "hobo.vercel-git-deployment-plan/v1",
  "bindle": "hobo-ci-relay",
  "resources": [
    {
      "kind": "queue",
      "name": "hobo-ci"
    },
    {
      "kind": "schedule",
      "name": "hobo-ci-repair"
    },
    {
      "kind": "api",
      "name": "relay"
    },
    {
      "kind": "secret",
      "name": "secrets"
    },
    {
      "kind": "data",
      "name": "state"
    }
  ],
  "project": "hobo-ci",
  "scope": "team_hobo",
  "target": "production",
  "gitSource": {
    "type": "github",
    "org": "Hobo-Labs",
    "repo": "HoBo",
    "ref": "main",
    "sha": "0123456789abcdef0123456789abcdef01234567"
  },
  "settings": [
    {
      "key": "HOBO_CI_CONFIG_SERVICE",
      "value": "infisical"
    },
    {
      "key": "INFISICAL_ENVIRONMENT",
      "value": "prod"
    },
    {
      "key": "INFISICAL_IDENTITY_ID",
      "value": "3f2b1c9e-8a7d-4e6f-9b0c-1d2e3f4a5b6c"
    },
    {
      "key": "INFISICAL_PROJECT_ID",
      "value": "6512a1b0-c3d4-4e5f-8071-8293a4b5c6d7"
    },
    {
      "key": "INFISICAL_SECRET_PATH",
      "value": "/hobo-ci-relay"
    },
    {
      "key": "INFISICAL_SITE_URL",
      "value": "https://app.infisical.com"
    }
  ],
  "operatorSecrets": [
    "CRON_SECRET",
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "HOBO_CI_BOOTSTRAP_TOKEN_SHA256",
    "HOBO_CI_CONFIG_JSON",
    "HOBO_CI_CONTROL_TOKENS_JSON",
    "HOBO_CI_GITHUB_APP_CLIENT_SECRET",
    "HOBO_CI_GITHUB_APP_PRIVATE_KEY",
    "HOBO_CI_ONBOARDING_CONTROL_TOKEN",
    "HOBO_CI_SESSION_KEY",
    "HOBO_CI_WEBHOOK_SECRET"
  ],
  "requests": [
    {
      "method": "GET",
      "path": "/v10/projects/hobo-ci/env?teamId=team_hobo",
      "when": "always: read what the project holds, before any write"
    },
    {
      "method": "POST",
      "path": "/v10/projects/hobo-ci/env?teamId=team_hobo",
      "body": "{\"key\":\"HOBO_CI_CONFIG_SERVICE\",\"value\":\"infisical\",\"type\":\"plain\",\"target\":[\"production\"]}",
      "when": "only if HOBO_CI_CONFIG_SERVICE is not set for production; a plain production-only value that differs is edited instead, and one already as asked is left alone"
    },
    {
      "method": "POST",
      "path": "/v10/projects/hobo-ci/env?teamId=team_hobo",
      "body": "{\"key\":\"INFISICAL_ENVIRONMENT\",\"value\":\"prod\",\"type\":\"plain\",\"target\":[\"production\"]}",
      "when": "only if INFISICAL_ENVIRONMENT is not set for production; a plain production-only value that differs is edited instead, and one already as asked is left alone"
    },
    {
      "method": "POST",
      "path": "/v10/projects/hobo-ci/env?teamId=team_hobo",
      "body": "{\"key\":\"INFISICAL_IDENTITY_ID\",\"value\":\"3f2b1c9e-8a7d-4e6f-9b0c-1d2e3f4a5b6c\",\"type\":\"plain\",\"target\":[\"production\"]}",
      "when": "only if INFISICAL_IDENTITY_ID is not set for production; a plain production-only value that differs is edited instead, and one already as asked is left alone"
    },
    {
      "method": "POST",
      "path": "/v10/projects/hobo-ci/env?teamId=team_hobo",
      "body": "{\"key\":\"INFISICAL_PROJECT_ID\",\"value\":\"6512a1b0-c3d4-4e5f-8071-8293a4b5c6d7\",\"type\":\"plain\",\"target\":[\"production\"]}",
      "when": "only if INFISICAL_PROJECT_ID is not set for production; a plain production-only value that differs is edited instead, and one already as asked is left alone"
    },
    {
      "method": "POST",
      "path": "/v10/projects/hobo-ci/env?teamId=team_hobo",
      "body": "{\"key\":\"INFISICAL_SECRET_PATH\",\"value\":\"/hobo-ci-relay\",\"type\":\"plain\",\"target\":[\"production\"]}",
      "when": "only if INFISICAL_SECRET_PATH is not set for production; a plain production-only value that differs is edited instead, and one already as asked is left alone"
    },
    {
      "method": "POST",
      "path": "/v10/projects/hobo-ci/env?teamId=team_hobo",
      "body": "{\"key\":\"INFISICAL_SITE_URL\",\"value\":\"https://app.infisical.com\",\"type\":\"plain\",\"target\":[\"production\"]}",
      "when": "only if INFISICAL_SITE_URL is not set for production; a plain production-only value that differs is edited instead, and one already as asked is left alone"
    },
    {
      "method": "POST",
      "path": "/v13/deployments?teamId=team_hobo",
      "body": "{\"name\":\"hobo-ci\",\"project\":\"hobo-ci\",\"gitSource\":{\"type\":\"github\",\"org\":\"Hobo-Labs\",\"repo\":\"HoBo\",\"ref\":\"main\",\"sha\":\"0123456789abcdef0123456789abcdef01234567\"},\"target\":\"production\"}",
      "when": "always: one deployment, built by Vercel from the commit"
    }
  ],
  "placement": {
    "yard": "hobo-ci-relay",
    "camp": "hobo-ci-relay/production",
    "provider": "vercel",
    "regions": [
      "iad1"
    ]
  },
  "bindings": [
    {
      "profile": "api.http/v1",
      "productId": "vercel.function/v1",
      "selected": true,
      "inputs": [
        "INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET"
      ]
    },
    {
      "profile": "bucket.object/v1",
      "productId": "vercel.blob/v1",
      "connectivityId": "vercel.oidc/v1"
    },
    {
      "profile": "data.sqlite/v1",
      "productId": "turso.database/v1",
      "connectivityId": "vercel.marketplace/v1",
      "provisioning": "marketplace:tursocloud"
    },
    {
      "profile": "kv.redis-compatible/v1",
      "productId": "upstash.redis/v1",
      "connectivityId": "vercel.marketplace/v1",
      "selected": true,
      "provisioning": "marketplace:upstash/upstash-kv"
    },
    {
      "profile": "kv.valkey/v1",
      "productId": "aiven.valkey/v1",
      "connectivityId": "config-service.url/v1"
    },
    {
      "profile": "kv.valkey/v1",
      "productId": "valkey.self-hosted/v1",
      "connectivityId": "config-service.url/v1"
    },
    {
      "profile": "provider.project/v1",
      "productId": "vercel.project/v1",
      "selected": true
    },
    {
      "profile": "queue.at-least-once/v1",
      "productId": "vercel.queues/v1",
      "selected": true
    },
    {
      "profile": "queue.delay/v1",
      "productId": "vercel.queues/v1",
      "selected": true
    },
    {
      "profile": "secret-ref.runtime-projection/v1",
      "productId": "infisical.secrets/v1",
      "connectivityId": "infisical.oidc-auth/v1",
      "selected": true,
      "settings": [
        "HOBO_CI_CONFIG_SERVICE",
        "INFISICAL_SECRET_PATH",
        "INFISICAL_SITE_URL"
      ],
      "inputs": [
        "INFISICAL_IDENTITY_ID",
        "INFISICAL_PROJECT_ID"
      ]
    },
    {
      "profile": "service.queue-consumer/v1",
      "productId": "vercel.function/v1",
      "selected": true
    },
    {
      "profile": "service.scheduled/v1",
      "productId": "vercel.schedules/v1",
      "selected": true
    }
  ],
  "provisioning": [
    {
      "args": [
        "integration",
        "list",
        "hobo-ci",
        "--integration",
        "upstash",
        "--json"
      ],
      "when": "always: is hobo-ci-cache connected to hobo-ci"
    },
    {
      "args": [
        "integration",
        "list",
        "--all",
        "--integration",
        "upstash",
        "--json"
      ],
      "when": "if not: does the team have hobo-ci-cache"
    },
    {
      "args": [
        "integration",
        "resource",
        "connect",
        "hobo-ci-cache",
        "hobo-ci",
        "--environment",
        "production",
        "--yes",
        "--json"
      ],
      "when": "if the team has it: connect it to hobo-ci for production"
    },
    {
      "args": [
        "integration",
        "add",
        "upstash/upstash-kv",
        "--name",
        "hobo-ci-cache",
        "--environment",
        "production",
        "--no-env-pull",
        "--non-interactive",
        "--json"
      ],
      "when": "if the team has none: provision it, connected to hobo-ci for production"
    }
  ]
}
