{
	"name": "@hobo/hobo",
	"version": "0.0.1",
	"license": "MIT",
	"description": "HoBo composition-root app: wires the default LOCAL/MOCKED runtimes so the composed `hobo` binary runs the cloud verbs (collect/plan/up/down/dev) end to end without shell stubs.",
	"type": "module",
	"bin": {
		"hobo": "./dist/bin/hobo.js",
		"hobo-mcp": "./dist/bin/hobo-mcp.js"
	},
	"files": [
		"LICENSE",
		"CI.md",
		"CD.md",
		"dist",
		"wit"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./cd-platform": {
			"types": "./dist/cd-platform.d.ts",
			"default": "./dist/cd-platform.js"
		},
		"./hosting-mutation-journal": {
			"types": "./dist/hosting-mutation-journal.d.ts",
			"default": "./dist/hosting-mutation-journal.js"
		},
		"./cd-runtime": {
			"types": "./dist/cd-runtime.d.ts",
			"default": "./dist/cd-runtime.js"
		},
		"./cd-serve": {
			"types": "./dist/cd-serve.d.ts",
			"default": "./dist/cd-serve.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
