	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.types.json",
		"lint": "biome check .",
		"pretest": "node --experimental-strip-types ../../scripts/ensure-built.mts",
		"test": "vitest run",
		"pretest:ci-e2e": "node --experimental-strip-types ../../scripts/ensure-built.mts",
		"test:ci-e2e": "vitest run --config vitest.ci-e2e.config.ts",
		"test:live": "vitest run --config vitest.live.config.ts",
		"pretest:release-integration": "node --experimental-strip-types ../../scripts/ensure-built.mts",
		"test:release-integration": "vitest run --config vitest.release-integration.config.ts"
	}
}
