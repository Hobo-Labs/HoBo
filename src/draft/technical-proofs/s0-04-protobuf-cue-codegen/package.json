{
  "name": "@hobo-draft/s0-04-protobuf-cue-codegen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HOBO-581 draft POC: protobuf+CUE codegen pipeline with drift gate",
  "scripts": {
    "codegen": "pnpm --filter @hobo/schema-tools build && node --import tsx packages/schema-tools/src/cli.ts",
    "codegen:check": "pnpm --filter @hobo/schema-tools build && node --import tsx packages/schema-tools/src/cli.ts --check",
    "test": "pnpm --filter @hobo/schema-tools build && vitest run --no-isolate --maxWorkers=1 packages/schema-tools/test",
    "draft:prepare": "pnpm --filter @hobo/schema-tools build"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.71.0",
    "@bufbuild/protobuf": "2.12.1",
    "@bufbuild/protoc-gen-es": "2.12.1",
    "@hobo/schema-tools": "workspace:*"
  }
}
