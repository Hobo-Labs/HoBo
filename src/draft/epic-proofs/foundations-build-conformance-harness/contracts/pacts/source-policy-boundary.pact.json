{
  "consumer": { "name": "FoundationsReferenceApp" },
  "provider": { "name": "SourcePolicyBoundary" },
  "interactions": [
    {
      "description": "prove package boundaries and source policy",
      "request": { "method": "POST", "path": "/hardening/source-policy" },
      "response": {
        "status": 200,
        "body": {
          "namespace": { "secretRefPackage": "@hobo/bindles" },
          "sourcePolicy": { "forbidsNarrativeRecords": true }
        }
      }
    }
  ],
  "metadata": { "pactSpecification": { "version": "3.0.0" } }
}
