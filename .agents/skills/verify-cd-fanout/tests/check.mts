import {strict as assert} from 'node:assert';
import path from 'node:path';
import {pathToFileURL} from 'node:url';
const source=process.env.FANOUT_VERIFY_SOURCE ?? path.resolve('packages/cd/src/fanout/schedule.ts');
const {schedule}=await import(pathToFileURL(source).href);
const plan={strategy:'PROGRESSIVE_PER_GROUP',maxConcurrency:1,maxFailures:0,minSuccessMs:0,progressDeadlineMs:100,rollbackOnHalt:false,groups:[{name:'pilot',campIds:['pilot'],mandatory:true},{name:'production',campIds:['prod'],mandatory:false}],campIds:['pilot','prod']};
const slots=new Map([['pilot',{campId:'pilot',state:'pending'}],['prod',{campId:'prod',state:'pending'}]]);
assert.deepEqual(schedule(plan,slots,{halted:false,catchUp:false}).candidates,['pilot'],'pilot must be offered before production');
assert.deepEqual(schedule(plan,slots,{halted:true,catchUp:false}).candidates,[],'halted fanout must not offer new work');
slots.set('pilot',{campId:'pilot',state:'deferred'});
assert.deepEqual(schedule(plan,slots,{halted:false,catchUp:false}).candidates,['pilot'],'production must wait while a mandatory pilot is deferred');
slots.set('pilot',{campId:'pilot',state:'succeeded'});
assert.deepEqual(schedule(plan,slots,{halted:false,catchUp:false}).candidates,['prod'],'production follows pilot success');
console.log('PASS: halt and mandatory-pilot scheduling');
