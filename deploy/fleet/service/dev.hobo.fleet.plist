<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- HoBo Fleet agent as a launchd agent (design §6.15, §6.16).
     `hobo fleet service install` writes the same agent for the current user;
     this copy is for image builders and configuration management. Install it
     as ~/Library/LaunchAgents/dev.hobo.fleet.plist, then:
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.hobo.fleet.plist -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.hobo.fleet</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/hobo</string>
		<string>fleet</string>
		<string>run</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOBO_FLEET_AUTHORITY_URL</key>
		<string>https://fleet.example.com</string>
		<key>HOBO_FLEET_KEYSTORE</key>
		<string>file</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ExitTimeOut</key>
	<integer>120</integer>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
