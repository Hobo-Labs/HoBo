{
  "version": 1,
  "hooks": {
    "agentStop": [
      {
        "type": "command",
        "bash": "python3 scripts/agent_completion_hook.py",
        "powershell": "python scripts/agent_completion_hook.py",
        "cwd": ".",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "bash": "node --experimental-strip-types scripts/agent-owner-ask-hook.mts --format=copilot",
        "powershell": "node --experimental-strip-types scripts/agent-owner-ask-hook.mts --format=copilot",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "python3 scripts/agent_completion_hook.py prompt",
        "powershell": "python scripts/agent_completion_hook.py prompt",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}
